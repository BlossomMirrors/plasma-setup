diff --git a/modules/appearance/contents/ui/main.qml b/modules/appearance/contents/ui/main.qml
new file mode 100644
index 0000000..0ecac02
--- /dev/null
+++ b/modules/appearance/contents/ui/main.qml
@@ -0,0 +1,317 @@
+// SPDX-FileCopyrightText: 2026 Leonie Ain <me@koyu.space>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Layouts
+import QtQuick.Window
+
+import org.kde.kirigami as Kirigami
+import org.kde.kirigamiaddons.formcard as FormCard
+import org.kde.plasmasetup
+import org.kde.plasmasetup.prepareutil as Prepare
+import org.kde.plasmasetup.wallpaperutil as Wallpaper
+
+import org.kde.plasmasetup.components as PlasmaSetupComponents
+
+/**
+* @brief Module for choosing how the desktop looks
+*
+* The light/dark switch, the accent colour (the palette of
+* quick-appearance-kcm), and the desktop and lock screen wallpaper from the
+* ones listed in plasma-setup/wallpapers.json, shown in their dark variant
+* while the dark theme is on. Not shown when there are users already, as no
+* new one is created to take the choices.
+*/
+PlasmaSetupComponents.SetupModule {
+    id: root
+
+    available: !AccountController.hasExistingUsers
+
+    // Same as quick-appearance-kcm's, the first is BlossomUI's own
+    readonly property var accentPalette: ["#3e78ff", "#ff5266", "#ef8c4a", "#dfb355", "#4cd47c", "#45cfab", "#45ace6", "#7d52ff", "#b552ff", "#ff52b5", "#8fa3c4"]
+    // Nothing to choose from with a single wallpaper
+    readonly property bool hasWallpapers: Wallpaper.WallpaperUtil.wallpapers.length > 1
+
+    nextEnabled: true
+
+    component AccentSwatch: AbstractButton {
+        id: swatch
+
+        property color swatchColor
+        readonly property bool current: {
+            const accent = Prepare.PrepareUtil.accentColor || Prepare.PrepareUtil.schemeAccentColor;
+            return accent.toLowerCase() === swatchColor.toString().toLowerCase();
+        }
+
+        implicitWidth: Kirigami.Units.gridUnit * 1.6
+        implicitHeight: implicitWidth
+        hoverEnabled: true
+        focusPolicy: Qt.StrongFocus
+        scale: hovered || current || visualFocus ? 1.12 : 1
+
+        Behavior on scale {
+            NumberAnimation {
+                duration: Kirigami.Units.shortDuration
+                easing.type: Easing.OutCubic
+            }
+        }
+
+        Accessible.role: Accessible.RadioButton
+        Accessible.checked: current
+        Accessible.name: swatchColor.toString()
+
+        onClicked: Prepare.PrepareUtil.accentColor = swatchColor.toString()
+
+        contentItem: Item {}
+        background: Rectangle {
+            radius: width / 2
+            gradient: Gradient {
+                GradientStop {
+                    position: 0
+                    color: Qt.lighter(swatch.swatchColor, 1.18)
+                }
+                GradientStop {
+                    position: 1
+                    color: Qt.darker(swatch.swatchColor, 1.06)
+                }
+            }
+            border.width: swatch.visualFocus ? 2 : 1
+            border.color: swatch.visualFocus ? Kirigami.Theme.textColor : Qt.alpha("#000000", 0.12)
+
+            Rectangle {
+                visible: swatch.current
+                anchors.centerIn: parent
+                width: parent.width * 0.55
+                height: width
+                radius: width / 2
+                color: Qt.alpha("#000000", 0.3)
+
+                Kirigami.Icon {
+                    anchors.fill: parent
+                    anchors.margins: 3
+                    source: "emblem-ok-symbolic"
+                    isMask: true
+                    color: "#ffffff"
+                }
+            }
+        }
+    }
+
+    contentItem: ColumnLayout {
+        spacing: Kirigami.Units.smallSpacing
+
+        Label {
+            Layout.leftMargin: Kirigami.Units.gridUnit
+            Layout.rightMargin: Kirigami.Units.gridUnit
+            Layout.bottomMargin: Kirigami.Units.gridUnit
+            Layout.fillWidth: true
+
+            wrapMode: Text.Wrap
+            horizontalAlignment: Text.AlignHCenter
+            text: i18n("Choose how your desktop looks. You can change it later in System Settings.")
+        }
+
+        FormCard.FormCard {
+            Layout.fillWidth: true
+            maximumWidth: Math.min(Kirigami.Units.gridUnit * 30, root.contentItem.width - Kirigami.Units.gridUnit * 2)
+
+            FormCard.FormSwitchDelegate {
+                text: i18n("Dark Theme")
+                checked: Prepare.PrepareUtil.usingDarkTheme
+                onCheckedChanged: {
+                    if (checked !== Prepare.PrepareUtil.usingDarkTheme) {
+                        Prepare.PrepareUtil.usingDarkTheme = checked;
+                    }
+                }
+            }
+
+            FormCard.FormDelegateSeparator {}
+
+            FormCard.AbstractFormDelegate {
+                background: null
+                hoverEnabled: false
+                focusPolicy: Qt.NoFocus
+
+                contentItem: ColumnLayout {
+                    spacing: Kirigami.Units.largeSpacing
+
+                    Label {
+                        Layout.fillWidth: true
+                        text: i18n("Accent Color")
+                        elide: Text.ElideRight
+                    }
+
+                    Flow {
+                        Layout.fillWidth: true
+                        Layout.bottomMargin: Kirigami.Units.smallSpacing
+                        spacing: Math.round(Kirigami.Units.smallSpacing * 1.5)
+
+                        Repeater {
+                            model: root.accentPalette
+
+                            delegate: AccentSwatch {
+                                required property string modelData
+                                swatchColor: modelData
+                            }
+                        }
+                    }
+                }
+            }
+        }
+
+        Kirigami.Heading {
+            Layout.topMargin: Kirigami.Units.largeSpacing
+            Layout.leftMargin: Kirigami.Units.largeSpacing / 2
+            Layout.fillWidth: true
+            visible: root.hasWallpapers
+            level: 4
+            text: i18n("Wallpaper")
+        }
+
+        ScrollView {
+            Layout.fillWidth: true
+            Layout.fillHeight: true
+            visible: root.hasWallpapers
+
+            GridView {
+                id: grid
+
+                readonly property bool dark: Kirigami.ColorUtils.brightnessForColor(Kirigami.Theme.backgroundColor) === Kirigami.ColorUtils.Dark
+                readonly property int columns: Math.max(2, Math.floor(width / (Kirigami.Units.gridUnit * 9)))
+
+                clip: true
+                keyNavigationEnabled: true
+                cellWidth: Math.floor(width / columns)
+                cellHeight: Math.round((cellWidth - Kirigami.Units.largeSpacing) * 9 / 16) + Kirigami.Units.largeSpacing * 2 + Kirigami.Units.gridUnit
+                model: Wallpaper.WallpaperUtil.wallpapers
+                currentIndex: model.findIndex(wallpaper => wallpaper.id === Wallpaper.WallpaperUtil.selected)
+                // Arrow keys pick, like in a group of radio buttons
+                onCurrentIndexChanged: {
+                    if (currentIndex >= 0 && activeFocus) {
+                        Wallpaper.WallpaperUtil.pick(model[currentIndex].id);
+                    }
+                }
+
+                delegate: AbstractButton {
+                    id: delegate
+
+                    required property var modelData
+                    required property int index
+                    readonly property bool selected: modelData.id === Wallpaper.WallpaperUtil.selected
+
+                    width: grid.cellWidth
+                    height: grid.cellHeight
+                    padding: Kirigami.Units.largeSpacing / 2
+                    hoverEnabled: true
+                    focusPolicy: Qt.StrongFocus
+
+                    text: modelData.name
+                    Accessible.role: Accessible.RadioButton
+                    Accessible.checked: selected
+                    Accessible.description: modelData.author
+
+                    onClicked: {
+                        grid.currentIndex = index;
+                        Wallpaper.WallpaperUtil.pick(modelData.id);
+                    }
+
+                    contentItem: ColumnLayout {
+                        spacing: Kirigami.Units.smallSpacing
+
+                        Kirigami.ShadowedImage {
+                            Layout.fillWidth: true
+                            Layout.preferredHeight: Math.round(width * 9 / 16)
+
+                            source: grid.dark ? delegate.modelData.previewDark : delegate.modelData.preview
+                            sourceSize.width: width * Screen.devicePixelRatio
+                            fillMode: Image.PreserveAspectCrop
+                            asynchronous: true
+                            color: Kirigami.Theme.alternateBackgroundColor
+                            radius: Kirigami.Units.cornerRadius
+
+                            border.width: delegate.selected ? 2 : 1
+                            border.color: delegate.selected ? Kirigami.Theme.highlightColor
+                                : delegate.hovered || delegate.visualFocus ? Kirigami.ColorUtils.linearInterpolation(Kirigami.Theme.backgroundColor, Kirigami.Theme.highlightColor, 0.6)
+                                : Kirigami.ColorUtils.linearInterpolation(Kirigami.Theme.backgroundColor, Kirigami.Theme.textColor, 0.15)
+
+                            // The pick, marked like the selection in System Settings' wallpaper grid
+                            Rectangle {
+                                anchors.top: parent.top
+                                anchors.right: parent.right
+                                anchors.margins: Kirigami.Units.smallSpacing
+                                width: Kirigami.Units.iconSizes.small + Kirigami.Units.smallSpacing
+                                height: width
+                                radius: width / 2
+                                visible: delegate.selected
+                                // highlightedTextColor comes out dark with BlossomUI, the
+                                // Selection colours are right
+                                Kirigami.Theme.colorSet: Kirigami.Theme.Selection
+                                Kirigami.Theme.inherit: false
+                                color: Kirigami.Theme.backgroundColor
+
+                                Kirigami.Icon {
+                                    anchors.centerIn: parent
+                                    width: Kirigami.Units.iconSizes.small
+                                    height: width
+                                    source: "emblem-ok-symbolic"
+                                    isMask: true
+                                    roundToIconSize: false
+                                    color: Kirigami.Theme.textColor
+                                }
+                            }
+                        }
+
+                        Label {
+                            Layout.fillWidth: true
+                            text: delegate.text
+                            elide: Text.ElideRight
+                            horizontalAlignment: Text.AlignHCenter
+                            font.weight: delegate.selected ? Font.DemiBold : Font.Normal
+                        }
+                    }
+                }
+            }
+        }
+
+        // Where the wallpaper goes
+        Flow {
+            Layout.alignment: Qt.AlignHCenter
+            Layout.maximumWidth: parent.width
+            Layout.topMargin: Kirigami.Units.smallSpacing
+            visible: root.hasWallpapers
+            spacing: Kirigami.Units.largeSpacing
+
+            ButtonGroup {
+                id: targetGroup
+            }
+
+            Label {
+                height: targets.count > 0 ? targets.itemAt(0).height : implicitHeight
+                verticalAlignment: Text.AlignVCenter
+                text: i18n("Use for:")
+            }
+
+            Repeater {
+                id: targets
+
+                model: [
+                    { target: Wallpaper.WallpaperUtil.DesktopAndLockScreen, text: i18n("Desktop and lock screen") },
+                    { target: Wallpaper.WallpaperUtil.Desktop, text: i18n("Desktop only") },
+                    { target: Wallpaper.WallpaperUtil.LockScreen, text: i18n("Lock screen only") },
+                ]
+
+                delegate: RadioButton {
+                    required property var modelData
+
+                    ButtonGroup.group: targetGroup
+                    text: modelData.text
+                    checked: Wallpaper.WallpaperUtil.target === modelData.target
+                    onToggled: Wallpaper.WallpaperUtil.target = modelData.target
+                }
+            }
+        }
+    }
+}
