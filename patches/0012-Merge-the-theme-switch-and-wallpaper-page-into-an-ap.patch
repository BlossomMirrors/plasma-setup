+    const bool landscape = size.width() >= size.height();
+    const auto rank = [landscape](const QSize &imageSize) {
+        return std::pair((imageSize.width() >= imageSize.height()) != landscape, qint64(imageSize.width()) * imageSize.height());
+    };
+    std::sort(images.begin(), images.end(), [&rank](const auto &a, const auto &b) {
+        return rank(a.first) < rank(b.first);
+    });
+    // The first that covers the screen, or else the biggest
+    QString best;
+    for (const auto &[imageSize, path] : std::as_const(images)) {
+        if ((imageSize.width() >= imageSize.height()) != landscape && !best.isEmpty()) {
+            break;
+        }
+        best = path;
+        if (imageSize.width() >= size.width() && imageSize.height() >= size.height()) {
+            break;
+        }
+    }
+    return best.isEmpty() ? QUrl() : QUrl::fromLocalFile(best);
+}
+
 void WallpaperUtil::save() const
 {
     auto config = KSharedConfig::openConfig(u"plasma-setuprc"_s);
     const QString dir = QStandardPaths::locate(QStandardPaths::GenericDataLocation, u"wallpapers/"_s + m_selected, QStandardPaths::LocateDirectory);
-    config->group(u"Wallpaper"_s).writeEntry("Image", dir);
+    KConfigGroup group = config->group(u"Wallpaper"_s);
+    group.writeEntry("Image", dir);
+    group.writeEntry("Desktop", m_target != LockScreen);
+    group.writeEntry("LockScreen", m_target != Desktop);
     config->sync();
 }
 
