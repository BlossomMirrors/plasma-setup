+    m_usingDarkTheme = globals->group(u"KDE"_s).readEntry("LookAndFeelPackage") == u"org.blossomos.ui.dark.desktop"_s;
+
+    const QColor accent = globals->group(u"General"_s).readEntry("AccentColor", QColor());
+    if (accent.isValid()) {
