+QString schemePath(bool dark)
+{
+    return QStandardPaths::locate(QStandardPaths::GenericDataLocation, dark ? u"color-schemes/BlossomUIDark.colors"_s : u"color-schemes/BlossomUILight.colors"_s);
+}
+
+QString colorToEntry(const QColor &color)
+{
+    return u"%1,%2,%3"_s.arg(color.red()).arg(color.green()).arg(color.blue());
+}
+
+// Writes the scheme's colours into kdeglobals with the accent colour in place
+// of its own, as quick-appearance-kcm does, or the scheme's colours as they
+// are for an invalid accent
+void bakeAccentColor(const QColor &accent, bool dark)
+{
+    const QString path = schemePath(dark);
+    if (path.isEmpty()) {
+        return;
+    }
+    KConfig scheme(path, KConfig::SimpleConfig);
+    auto globals = KSharedConfig::openConfig(u"kdeglobals"_s);
+    globals->reparseConfiguration();
+    const bool hasAccent = accent.isValid();
+
+    // Crossfade, as KWin does for System Settings
+    QDBusMessage blend = QDBusMessage::createMethodCall(u"org.kde.KWin"_s, u"/org/kde/KWin/BlendChanges"_s, u"org.kde.KWin.BlendChanges"_s, u"start"_s);
+    blend << 300;
+    QDBusConnection::sessionBus().call(blend);
+
+    static const QStringList groups{
+        u"Colors:View"_s,
+        u"Colors:Window"_s,
+        u"Colors:Button"_s,
+        u"Colors:Selection"_s,
+        u"Colors:Tooltip"_s,
+        u"Colors:Complementary"_s,
+        u"Colors:Header"_s,
+    };
+    static const QStringList keys{
+        u"BackgroundNormal"_s,
+        u"BackgroundAlternate"_s,
+        u"ForegroundNormal"_s,
+        u"ForegroundInactive"_s,
+        u"ForegroundActive"_s,
+        u"ForegroundLink"_s,
+        u"ForegroundVisited"_s,
+        u"ForegroundNegative"_s,
+        u"ForegroundNeutral"_s,
+        u"ForegroundPositive"_s,
+        u"DecorationFocus"_s,
+        u"DecorationHover"_s,
+    };
+    static const QStringList accentKeys{
+        u"ForegroundActive"_s,
+        u"ForegroundLink"_s,
+        u"DecorationFocus"_s,
+        u"DecorationHover"_s,
+    };
+
+    for (const QString &name : groups) {
+        if (name == u"Colors:Header"_s && !scheme.hasGroup(name)) {
+            continue;
+        }
+        const KConfigGroup source = scheme.group(name);
+        KConfigGroup group = globals->group(name);
+        for (const QString &key : keys) {
+            const QString value = hasAccent && accentKeys.contains(key) ? colorToEntry(accent) : source.readEntry(key, QString());
+            if (value.isEmpty()) {
+                group.deleteEntry(key, KConfig::Notify);
+            } else {
+                group.writeEntry(key, value, KConfig::Notify);
+            }
+        }
+        if (name == u"Colors:Selection"_s && hasAccent) {
+            group.writeEntry("BackgroundNormal", colorToEntry(accent), KConfig::Notify);
+            group.writeEntry("BackgroundAlternate", colorToEntry(accent), KConfig::Notify);
+            // Dark text on light accents
+            const qreal luma = (0.299 * accent.red() + 0.587 * accent.green() + 0.114 * accent.blue()) / 255.0;
+            if (luma > 0.55) {
+                group.writeEntry("ForegroundNormal", u"18,20,30"_s, KConfig::Notify);
+                group.writeEntry("ForegroundInactive", u"45,48,60"_s, KConfig::Notify);
+            }
+        }
+        if (name == u"Colors:Button"_s && hasAccent) {
+            group.writeEntry("BackgroundAlternate", colorToEntry(accent), KConfig::Notify);
+        }
+    }
+
+    // The auth helper merges this into the new user's kdeglobals
+    if (hasAccent) {
+        globals->group(u"General"_s).writeEntry("AccentColor", colorToEntry(accent), KConfig::Notify);
+    } else {
+        globals->group(u"General"_s).deleteEntry("AccentColor", KConfig::Notify);
+    }
+    globals->sync();
+
+    QDBusMessage message = QDBusMessage::createSignal(u"/KGlobalSettings"_s, u"org.kde.KGlobalSettings"_s, u"notifyChange"_s);
+    message.setArguments({0 /* PaletteChanged */, 0});
+    QDBusConnection::sessionBus().send(message);
+}
 }
 
