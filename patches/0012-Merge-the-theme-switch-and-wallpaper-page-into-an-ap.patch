 }
 
+QString PrepareUtil::accentColor() const
+{
+    return m_accentColor;
+}
+
+void PrepareUtil::setAccentColor(const QString &accentColor)
+{
+    // The scheme's own counts as none, so the scheme can change it later
+    const QColor requested(accentColor);
+    if (!accentColor.isEmpty() && !requested.isValid()) {
+        return;
+    }
+    const QString color = accentColor.isEmpty() || requested == QColor(schemeAccentColor()) ? QString() : requested.name();
+    if (color == m_accentColor) {
+        return;
+    }
+    bakeAccentColor(QColor(color), m_usingDarkTheme);
+
+    m_accentColor = color;
+    Q_EMIT accentColorChanged();
+}
+
+QString PrepareUtil::schemeAccentColor() const
+{
+    const QString path = schemePath(m_usingDarkTheme);
+    if (path.isEmpty()) {
+        return QString();
+    }
+    const QColor color = KConfig(path, KConfig::SimpleConfig).group(u"Colors:Selection"_s).readEntry("BackgroundNormal", QColor());
+    return color.isValid() ? color.name() : QString();
+}
