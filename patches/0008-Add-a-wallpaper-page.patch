diff --git a/modules/wallpaperutil/wallpaperutil.cpp b/modules/wallpaperutil/wallpaperutil.cpp
new file mode 100644
index 0000000..7e680d6
--- /dev/null
+++ b/modules/wallpaperutil/wallpaperutil.cpp
@@ -0,0 +1,134 @@
+// SPDX-FileCopyrightText: 2026 Leonie Ain <me@koyu.space>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "wallpaperutil.h"
+
+#include <KAboutData>
+#include <KConfigGroup>
+#include <KPluginMetaData>
+#include <KSharedConfig>
+
+#include <QDir>
+#include <QFile>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QRegularExpression>
+#include <QStandardPaths>
+#include <QUrl>
+
+#include <algorithm>
+
+using namespace Qt::StringLiterals;
+
+namespace
+{
+// The smallest landscape image in a wallpaper package's images dir, as
+// thumbnails don't need more and big PNGs are slow to decode. Images are
+// named after their size, like 3840x2160.png
+QString smallestLandscapeImage(const QString &imagesDir)
+{
+    static const QRegularExpression sizeName(u"^(\\d+)x(\\d+)\\."_s);
+
+    QString best;
+    qint64 bestArea = 0;
+    const QStringList files = QDir(imagesDir).entryList(QDir::Files, QDir::Name);
+    for (const QString &file : files) {
+        const QRegularExpressionMatch match = sizeName.match(file);
+        if (!match.hasMatch()) {
+            continue;
+        }
+        const qint64 width = match.captured(1).toLongLong();
+        const qint64 height = match.captured(2).toLongLong();
+        if (width < height) {
+            continue;
+        }
+        if (best.isEmpty() || width * height < bestArea) {
+            best = imagesDir + u'/' + file;
+            bestArea = width * height;
+        }
+    }
+    return best;
+}
+}
+
+WallpaperUtil::WallpaperUtil(QObject *parent)
+    : QObject{parent}
+{
+    const QString listPath = QStandardPaths::locate(QStandardPaths::GenericDataLocation, u"plasma-setup/wallpapers.json"_s);
+    QFile listFile(listPath);
+    if (listPath.isEmpty() || !listFile.open(QIODevice::ReadOnly)) {
+        return;
+    }
+    const QJsonObject list = QJsonDocument::fromJson(listFile.readAll()).object();
+
+    QStringList ids;
+    const QJsonArray entries = list.value("wallpapers"_L1).toArray();
+    for (const QJsonValue &entry : entries) {
+        const QString id = entry.toString();
+        // Skip what isn't installed
+        const QString dir = QStandardPaths::locate(QStandardPaths::GenericDataLocation, u"wallpapers/"_s + id, QStandardPaths::LocateDirectory);
+        const QString preview = smallestLandscapeImage(dir + u"/contents/images"_s);
+        if (id.isEmpty() || dir.isEmpty() || preview.isEmpty() || ids.contains(id)) {
+            continue;
+        }
+        const QString previewDark = smallestLandscapeImage(dir + u"/contents/images_dark"_s);
+        const KPluginMetaData metaData = KPluginMetaData::fromJsonFile(dir + u"/metadata.json"_s);
+        const QList<KAboutPerson> authors = metaData.authors();
+
+        ids << id;
+        m_wallpapers << QVariantMap{
+            {u"id"_s, id},
+            {u"name"_s, metaData.name().isEmpty() ? id : metaData.name()},
+            {u"author"_s, authors.isEmpty() ? QString() : authors.first().name()},
+            {u"preview"_s, QUrl::fromLocalFile(preview)},
+            {u"previewDark"_s, QUrl::fromLocalFile(previewDark.isEmpty() ? preview : previewDark)},
+        };
+    }
+    if (ids.isEmpty()) {
+        return;
+    }
+
+    // Keep an earlier pick when the wizard is started again
+    const QString saved = QDir(KSharedConfig::openConfig(u"plasma-setuprc"_s)->group(u"Wallpaper"_s).readEntry("Image")).dirName();
+    const QString preselected = list.value("default"_L1).toString();
+    m_selected = ids.contains(saved) ? saved : ids.contains(preselected) ? preselected : ids.first();
+    save();
+}
+
+QVariantList WallpaperUtil::wallpapers() const
+{
+    return m_wallpapers;
+}
+
+QString WallpaperUtil::selected() const
+{
+    return m_selected;
+}
+
+void WallpaperUtil::setSelected(const QString &selected)
+{
+    if (selected == m_selected) {
+        return;
+    }
+    const bool known = std::any_of(m_wallpapers.cbegin(), m_wallpapers.cend(), [&selected](const QVariant &wallpaper) {
+        return wallpaper.toMap().value(u"id"_s).toString() == selected;
+    });
+    if (!known) {
+        return;
+    }
+
+    m_selected = selected;
+    save();
+    Q_EMIT selectedChanged();
+}
+
+void WallpaperUtil::save() const
+{
+    auto config = KSharedConfig::openConfig(u"plasma-setuprc"_s);
+    const QString dir = QStandardPaths::locate(QStandardPaths::GenericDataLocation, u"wallpapers/"_s + m_selected, QStandardPaths::LocateDirectory);
+    config->group(u"Wallpaper"_s).writeEntry("Image", dir);
+    config->sync();
+}
+
+#include "moc_wallpaperutil.cpp"
diff --git a/modules/wallpaperutil/wallpaperutil.h b/modules/wallpaperutil/wallpaperutil.h
new file mode 100644
index 0000000..a0f1bfe
--- /dev/null
+++ b/modules/wallpaperutil/wallpaperutil.h
@@ -0,0 +1,51 @@
+// SPDX-FileCopyrightText: 2026 Leonie Ain <me@koyu.space>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <QObject>
+#include <QVariantList>
+#include <qqmlintegration.h>
+
+/*!
+ * The wallpapers offered on the wallpaper page, and the one picked.
+ *
+ * The list comes from plasma-setup/wallpapers.json in the data dirs: wallpaper
+ * package names from /usr/share/wallpapers and the one to preselect. The pick
+ * is kept in the setup user's plasma-setuprc, where the auth helper reads it
+ * to set the new user's desktop wallpaper.
+ */
+class WallpaperUtil : public QObject
+{
+    Q_OBJECT
+    QML_ELEMENT
+    QML_SINGLETON
+
+    /*!
+     * One map per installed wallpaper: id, name, author, and preview and
+     * previewDark (image URLs for the thumbnails).
+     */
+    Q_PROPERTY(QVariantList wallpapers READ wallpapers CONSTANT)
+
+    /*!
+     * The id (package name) of the picked wallpaper.
+     */
+    Q_PROPERTY(QString selected READ selected WRITE setSelected NOTIFY selectedChanged)
+
+public:
+    explicit WallpaperUtil(QObject *parent = nullptr);
+
+    QVariantList wallpapers() const;
+
+    QString selected() const;
+    void setSelected(const QString &selected);
+
+Q_SIGNALS:
+    void selectedChanged();
+
+private:
+    void save() const;
+
+    QVariantList m_wallpapers;
+    QString m_selected;
+};
