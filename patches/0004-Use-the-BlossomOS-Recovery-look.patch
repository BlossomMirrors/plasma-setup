diff --git a/src/glowprovider.cpp b/src/glowprovider.cpp
new file mode 100644
index 0000000..1a848ae
--- /dev/null
+++ b/src/glowprovider.cpp
@@ -0,0 +1,76 @@
+// SPDX-FileCopyrightText: 2026 Leonie Ain <me@koyu.space>
+// SPDX-License-Identifier: AGPL-3.0-or-later
+// Ported from BlossomOS Recovery
+
+#include "glowprovider.h"
+
+#include <QColor>
+
+#include <algorithm>
+#include <cmath>
+
+GlowImageProvider::GlowImageProvider()
+    : QQuickImageProvider(QQuickImageProvider::Image)
+{
+}
+
+QImage GlowImageProvider::requestImage(const QString &id, QSize *size, const QSize &requestedSize)
+{
+    Q_UNUSED(requestedSize)
+
+    const QStringList parts = id.split(QLatin1Char('/'));
+    const QStringList dims = parts.value(0).split(QLatin1Char('x'));
+    const int width = std::clamp(dims.value(0).toInt(), 1, 8192);
+    const int height = std::clamp(dims.value(1).toInt(), 1, 8192);
+    QColor color(parts.value(1).isEmpty() ? QStringLiteral("#3e78ff") : QLatin1Char('#') + parts.value(1));
+    if (!color.isValid()) {
+        color = QColor(0x3e, 0x78, 0xff);
+    }
+    const float peak = std::clamp(parts.value(2).toFloat(), 0.0f, 1.0f);
+
+    QImage image(width, height, QImage::Format_ARGB32_Premultiplied);
+    if (size) {
+        *size = image.size();
+    }
+
+    const float r = color.redF();
+    const float g = color.greenF();
+    const float b = color.blueF();
+    const float cx = width / 2.0f;
+    const float cy = height; // centre on the bottom edge
+    const float rx = width / 2.0f;
+    const float ry = height;
+
+    static const QImage noise = QImage(QStringLiteral(":/qt/qml/org/kde/plasmasetup/assets/bluenoise.png")).convertToFormat(QImage::Format_Grayscale8);
+    const int noiseSize = noise.isNull() ? 0 : noise.width();
+    const int shift = parts.value(3).toInt() * 23;
+
+    // Peak dither strength in 8-bit levels (+-2), see the header
+    constexpr float ditherLevels = 4.0f;
+    auto quantise = [](float v255, float n) {
+        return std::clamp(int(std::lround(v255 + n)), 0, 255);
+    };
+
+    for (int y = 0; y < height; ++y) {
+        auto *line = reinterpret_cast<QRgb *>(image.scanLine(y));
+        const uchar *noiseLine = noiseSize ? noise.constScanLine((y + shift) % noiseSize) : nullptr;
+        const float dy = (y + 0.5f - cy) / ry;
+        for (int x = 0; x < width; ++x) {
+            const float dx = (x + 0.5f - cx) / rx;
+            const float d2 = dx * dx + dy * dy;
+            float a = 0.0f;
+            if (d2 < 1.0f) {
+                // Gaussian core, with a tail that reaches exactly zero at the edge
+                const float tail = (1.0f - d2) * (1.0f - d2);
+                a = peak * std::exp(-3.2f * d2) * tail;
+            }
+            const float a255 = a * 255.0f;
+            const float t = noiseLine ? (noiseLine[(x + 2 * shift) % noiseSize] + 0.5f) / 256.0f - 0.5f : 0.0f;
+            const float n = t * std::min(ditherLevels, 2.0f * a255);
+            const int ai = quantise(a255, n);
+            // Same threshold on every channel keeps the colour from tinting
+            line[x] = qRgba(std::min(quantise(r * a255, n), ai), std::min(quantise(g * a255, n), ai), std::min(quantise(b * a255, n), ai), ai);
+        }
+    }
+    return image;
+}
