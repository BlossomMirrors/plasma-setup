@@ -0,0 +1,29 @@
+// SPDX-FileCopyrightText: 2026 Leonie Ain <me@koyu.space>
+// SPDX-License-Identifier: AGPL-3.0-or-later
+// Ported from BlossomOS Recovery
+
+#pragma once
+
+#include <QQuickImageProvider>
+
+/*
+ * image://glow/<width>x<height>/<rrggbb>/<peak alpha>/<noise shift>
+ * One soft glow blob: an elliptical falloff centred on the bottom edge of
+ * the image, computed in floating point at the size it is shown at and
+ * quantised to 8 bits through a blue-noise threshold map
+ * (assets/bluenoise.png, tools/make-bluenoise.py).
+ *
+ * A faint, wide gradient on near-black spans only a few dozen levels, and
+ * many panels (6-bit + FRC, near-black crush, 8-bit colour LUTs) merge
+ * neighbouring levels: a +-1 level dither disappears there and the bands
+ * come back. The dither is +-2 levels, which survives that; blue noise has
+ * no low-frequency energy, so even at that strength it reads as a smooth
+ * surface rather than grain. Premultiplied, so it composites directly.
+ */
+class GlowImageProvider : public QQuickImageProvider
+{
+public:
+    GlowImageProvider();
+
+    QImage requestImage(const QString &id, QSize *size, const QSize &requestedSize) override;
+};
