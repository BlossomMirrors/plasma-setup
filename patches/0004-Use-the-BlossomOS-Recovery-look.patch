diff --git a/src/qml/Backdrop.qml b/src/qml/Backdrop.qml
new file mode 100644
index 0000000..02b010e
--- /dev/null
+++ b/src/qml/Backdrop.qml
@@ -0,0 +1,72 @@
+// SPDX-FileCopyrightText: 2026 Leonie Ain <me@koyu.space>
+// SPDX-License-Identifier: AGPL-3.0-or-later
+// Ported from BlossomOS Recovery, with a light variant
+
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Window
+import org.kde.kirigami as Kirigami
+
+Item {
+    id: backdrop
+
+    property bool animated: true
+    readonly property string glowColor: Kirigami.Theme.highlightColor.toString().slice(1, 7)
+    // Follows the colours the app actually got, so the light/dark switch shows here too
+    readonly property bool dark: Kirigami.ColorUtils.brightnessForColor(Kirigami.Theme.backgroundColor) === Kirigami.ColorUtils.Dark
+
+    // Seconds since start
+    property real t: 0
+
+    Kirigami.Theme.colorSet: Kirigami.Theme.Window
+    Kirigami.Theme.inherit: false
+
+    Rectangle {
+        anchors.fill: parent
+        color: backdrop.dark ? "#030307" : "#ededf0"
+        Behavior on color { ColorAnimation { duration: Kirigami.Units.veryLongDuration } }
+    }
+
+    Repeater {
+        model: [
+            { x: 0.50, speed: 0.021, w: 1.30, h: 0.62, alpha: 0.20, phase: 0.0, floor: 0.55 },
+            { x: 0.26, speed: 0.047, w: 0.85, h: 0.58, alpha: 0.24, phase: 1.3, floor: 0.10 },
+            { x: 0.70, speed: 0.037, w: 0.90, h: 0.66, alpha: 0.24, phase: 3.9, floor: 0.10 },
+            { x: 0.48, speed: 0.029, w: 0.70, h: 0.48, alpha: 0.20, phase: 5.0, floor: 0.15 },
+        ]
+
+        Image {
+            id: blob
+            required property var modelData
+            readonly property real a: 2 * Math.PI * modelData.speed * backdrop.t + modelData.phase
+            readonly property real dpr: Screen.devicePixelRatio
+            readonly property int pixelWidth: Math.max(1, Math.round(backdrop.width * modelData.w * dpr))
+            readonly property int pixelHeight: Math.max(1, Math.round(backdrop.height * modelData.h * dpr))
+
+            width: pixelWidth / dpr
+            height: pixelHeight / dpr
+            // Fixed, on whole pixels, so the dither pattern is drawn 1:1
+            x: Math.round((backdrop.width * modelData.x - width / 2) * dpr) / dpr
+            y: backdrop.height - height
+            // Eased between floor and 1
+            opacity: modelData.floor + (1 - modelData.floor) * (0.5 - 0.5 * Math.cos(a))
+
+            required property int index
+            source: backdrop.width > 0
+                ? "image://glow/%1x%2/%3/%4/%5".arg(pixelWidth).arg(pixelHeight).arg(backdrop.glowColor).arg(modelData.alpha).arg(index)
+                : ""
+            sourceSize: Qt.size(pixelWidth, pixelHeight)
+            asynchronous: true
+            smooth: false
+        }
+    }
+
+    NumberAnimation on t {
+        running: backdrop.animated && backdrop.visible
+        from: 0
+        to: 3600
+        duration: 3600 * 1000
+        loops: Animation.Infinite
+    }
+}
diff --git a/src/qml/BlossomWindow.qml b/src/qml/BlossomWindow.qml
new file mode 100644
index 0000000..6fe9662
--- /dev/null
+++ b/src/qml/BlossomWindow.qml
@@ -0,0 +1,54 @@
+// SPDX-FileCopyrightText: 2026 Leonie Ain <me@koyu.space>
+// SPDX-License-Identifier: AGPL-3.0-or-later
+// Ported from BlossomOS Recovery
+
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import org.kde.kirigami as Kirigami
+
+Item {
+    id: window
+
+    default property alias content: body.data
+
+    property int radius: 12
+    readonly property color frameColor: Kirigami.Theme.backgroundColor
+    readonly property color outlineColor: Kirigami.ColorUtils.linearInterpolation(frameColor, Kirigami.Theme.textColor, 0.12)
+
+    Kirigami.Theme.colorSet: Kirigami.Theme.Window
+    Kirigami.Theme.inherit: false
+
+    // Soft drop shadow, drawn behind the frame so its clip doesn't cut it off
+    Kirigami.ShadowedRectangle {
+        anchors.fill: parent
+        visible: window.radius > 0
+        radius: window.radius
+        color: window.frameColor
+        shadow.size: 28
+        shadow.yOffset: 6
+        shadow.color: Qt.rgba(0, 0, 0, 0.16)
+    }
+
+    Rectangle {
+        id: frame
+        anchors.fill: parent
+        radius: window.radius
+        color: window.frameColor
+        clip: true
+
+        Item {
+            id: body
+            anchors.fill: parent
+        }
+    }
+
+    // Outline drawn on top so content never covers it
+    Rectangle {
+        anchors.fill: parent
+        radius: window.radius
+        color: "transparent"
+        border.width: window.radius > 0 ? 1 : 0
+        border.color: window.outlineColor
+    }
+}
