+QUrl AccountController::avatar() const
+{
+    return m_avatar;
+}
+
+bool AccountController::avatarChosen() const
+{
+    return m_avatarChosen;
+}
+
+QList<QUrl> AccountController::avatarPictures() const
+{
+    QList<QUrl> pictures;
+    const QStringList directories =
+        QStandardPaths::locateAll(QStandardPaths::GenericDataLocation, QStringLiteral("plasma/avatars/photos"), QStandardPaths::LocateDirectory);
+    for (const QString &directory : directories) {
+        const QFileInfoList entries =
+            QDir(directory).entryInfoList({QStringLiteral("*.png"), QStringLiteral("*.jpg"), QStringLiteral("*.jpeg")}, QDir::Files, QDir::Name);
+        for (const QFileInfo &entry : entries) {
+            pictures << QUrl::fromLocalFile(entry.absoluteFilePath());
+        }
+    }
+    return pictures;
+}
+
+void AccountController::chooseAvatar(const QUrl &picture)
+{
+    m_avatar = picture.isLocalFile() ? picture : QUrl();
+    m_avatarChosen = true;
+    Q_EMIT avatarChanged();
+}
+
+QString AccountController::photoPath() const
+{
+    const QString directory = QStandardPaths::writableLocation(QStandardPaths::AppDataLocation);
+    QDir().mkpath(directory);
+    return directory + QStringLiteral("/camera-%1.jpg").arg(m_photoCount);
+}
+
+QUrl AccountController::squarePhoto(const QString &path)
+{
+    QImage image(path);
+    QFile::remove(path);
+    if (image.isNull()) {
+        return {};
+    }
+    const int side = std::min(image.width(), image.height());
+    image = image.copy((image.width() - side) / 2, (image.height() - side) / 2, side, side)
+                .scaled(512, 512, Qt::IgnoreAspectRatio, Qt::SmoothTransformation);
+    const QString directory = QStandardPaths::writableLocation(QStandardPaths::AppDataLocation);
+    QDir().mkpath(directory);
+    const QString target = directory + QStringLiteral("/avatar-%1.png").arg(++m_photoCount);
+    if (!image.save(target, "PNG")) {
+        return {};
+    }
+    return QUrl::fromLocalFile(target);
+}
+
+void AccountController::setNewUserAvatar()
+{
+    if (!m_avatarChosen || (!m_avatar.isEmpty() && !QFile::exists(m_avatar.toLocalFile()))) {
+        return;
+    }
+    if (qEnvironmentVariableIntValue("PLASMA_SETUP_PREVIEW") == 1) {
+        qCInfo(PlasmaSetup) << "Preview: not setting the avatar" << m_avatar;
+        return;
+    }
+
+    KAuth::Action action(QStringLiteral("org.kde.plasmasetup.setnewuseravatar"));
+    action.setHelperId(QStringLiteral("org.kde.plasmasetup"));
+    action.setArguments({{QStringLiteral("username"), m_username}, {QStringLiteral("picture"), m_avatar.toLocalFile()}});
+    KAuth::ExecuteJob *job = action.execute();
+    if (!job->exec()) {
+        qCWarning(PlasmaSetup) << "Failed to set the avatar of the new user:" << job->errorString();
+    }
+}
