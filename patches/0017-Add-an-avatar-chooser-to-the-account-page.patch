+ActionReply PlasmaSetupAuthHelper::setnewuseravatar(const QVariantMap &args)
+{
+    if (!args.value(QStringLiteral("username")).canConvert<QString>() || !args.value(QStringLiteral("picture")).canConvert<QString>()) {
+        return makeErrorReply(QStringLiteral("Username or picture argument is missing or invalid."));
+    }
+    const QString username = args.value(QStringLiteral("username")).toString();
+    try {
+        getUserInfo(username);
+    } catch (const std::runtime_error &e) {
+        return makeErrorReply(QStringLiteral("Failed to get user info: ") + QString::fromStdString(e.what()));
+    }
+
+    QString picture = args.value(QStringLiteral("picture")).toString();
+    if (!picture.isEmpty()) {
+        const QFileInfo info(picture);
+        picture = info.canonicalFilePath();
+        const bool allowed = picture.startsWith(QStringLiteral("/usr/share/plasma/avatars/")) || picture.startsWith(PLASMA_SETUP_HOMEDIR + QLatin1Char('/'));
+        if (!allowed || !info.isFile() || info.size() > 16 * 1024 * 1024) {
+            return makeErrorReply(QStringLiteral("Refusing to use this picture: ") + args.value(QStringLiteral("picture")).toString());
+        }
+    }
+
+    const QString error = setAccountIcon(username, picture);
+    if (!error.isEmpty()) {
+        return makeErrorReply(QStringLiteral("Unable to set the account picture: ") + error);
+    }
+    return ActionReply::SuccessReply();
+}
