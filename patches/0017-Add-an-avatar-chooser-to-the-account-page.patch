diff --git a/modules/account/contents/ui/AvatarDialog.qml b/modules/account/contents/ui/AvatarDialog.qml
new file mode 100644
index 0000000..f82390f
--- /dev/null
+++ b/modules/account/contents/ui/AvatarDialog.qml
@@ -0,0 +1,261 @@
+// SPDX-FileCopyrightText: 2026 Leonie Ain <me@koyu.space>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Layouts
+import QtMultimedia
+
+import org.kde.kirigami as Kirigami
+import org.kde.kirigamiaddons.components as KirigamiComponents
+
+import org.kde.plasmasetup
+import org.kde.plasmasetup.switchutil as Switch
+
+Kirigami.Dialog {
+    id: dialog
+
+    required property string name
+
+    readonly property url current: AccountController.avatarChosen ? AccountController.avatar : Switch.SwitchUtil.profilePicture
+    readonly property bool hasCamera: devices.videoInputs.length > 0
+    readonly property bool customPhoto: AccountController.avatarChosen && AccountController.avatar.toString() !== ""
+        && AccountController.avatar.toString() !== Switch.SwitchUtil.profilePicture.toString()
+        && !AccountController.avatarPictures.some(picture => picture.toString() === AccountController.avatar.toString())
+    property bool cameraOpen: false
+    property url photo: ""
+    property bool cameraFailed: false
+
+    parent: Overlay.overlay
+    title: cameraOpen ? i18nc("@title:window", "Take a Photo") : i18nc("@title:window", "Choose a Picture")
+    padding: Kirigami.Units.largeSpacing
+    standardButtons: Kirigami.Dialog.NoButton
+
+    onClosed: {
+        cameraOpen = false;
+        photo = "";
+        cameraFailed = false;
+    }
+
+    function choose(picture: url): void {
+        AccountController.chooseAvatar(picture);
+        close();
+    }
+
+    function same(a: url, b: url): bool {
+        return a.toString() === b.toString();
+    }
+
+    MediaDevices {
+        id: devices
+    }
+
+    CaptureSession {
+        camera: Camera {
+            active: dialog.opened && dialog.cameraOpen && dialog.photo.toString() === ""
+            onErrorOccurred: dialog.cameraFailed = true
+        }
+        imageCapture: ImageCapture {
+            id: capture
+
+            onImageSaved: (requestId, path) => {
+                dialog.photo = AccountController.squarePhoto(path);
+                dialog.cameraFailed = dialog.photo.toString() === "";
+            }
+            onErrorOccurred: dialog.cameraFailed = true
+        }
+        videoOutput: viewfinder
+    }
+
+    component Tile: AbstractButton {
+        id: tile
+
+        property bool selected: false
+
+        implicitWidth: Kirigami.Units.gridUnit * 4
+        implicitHeight: implicitWidth
+        hoverEnabled: true
+        focusPolicy: Qt.StrongFocus
+
+        Accessible.role: Accessible.RadioButton
+        Accessible.checked: selected
+
+        ToolTip.visible: hovered && text !== ""
+        ToolTip.text: text
+        ToolTip.delay: Kirigami.Units.toolTipDelay
+
+        background: Rectangle {
+            radius: width / 2
+            color: "transparent"
+            border.width: tile.selected ? 3 : (tile.hovered || tile.visualFocus ? 2 : 0)
+            border.color: tile.selected ? Kirigami.Theme.highlightColor : Qt.alpha(Kirigami.Theme.highlightColor, 0.6)
+        }
+    }
+
+    component PictureTile: Tile {
+        id: pictureTile
+
+        required property url picture
+        property string initials: ""
+
+        selected: dialog.same(dialog.current, picture)
+        onClicked: dialog.choose(picture)
+
+        contentItem: KirigamiComponents.Avatar {
+            anchors.fill: parent
+            anchors.margins: Kirigami.Units.smallSpacing
+            source: pictureTile.picture
+            name: pictureTile.initials
+        }
+    }
+
+    contentItem: StackLayout {
+        currentIndex: dialog.cameraOpen ? 1 : 0
+
+        Item {
+            implicitWidth: pictures.implicitWidth
+            implicitHeight: pictures.implicitHeight
+
+            GridLayout {
+                id: pictures
+
+                anchors.horizontalCenter: parent.horizontalCenter
+                columns: 5
+                rowSpacing: Kirigami.Units.largeSpacing
+                columnSpacing: Kirigami.Units.largeSpacing
+
+                PictureTile {
+                    visible: Switch.SwitchUtil.profilePicture.toString() !== ""
+                    picture: Switch.SwitchUtil.profilePicture
+                    text: i18n("From your old computer")
+                }
+
+                PictureTile {
+                    visible: dialog.customPhoto
+                    picture: dialog.customPhoto ? AccountController.avatar : ""
+                    text: i18n("Your photo")
+                }
+
+                Repeater {
+                    model: AccountController.avatarPictures
+
+                    delegate: PictureTile {
+                        required property url modelData
+
+                        picture: modelData
+                        text: modelData.toString().replace(/^.*\//, "").replace(/\.[^.]*$/, "")
+                    }
+                }
+
+                PictureTile {
+                    picture: ""
+                    initials: dialog.name
+                    text: i18n("Initials")
+                }
+
+                Tile {
+                    visible: dialog.hasCamera
+                    text: i18n("Webcam")
+                    onClicked: dialog.cameraOpen = true
+
+                    contentItem: Rectangle {
+                        anchors.fill: parent
+                        anchors.margins: Kirigami.Units.smallSpacing
+                        radius: width / 2
+                        color: Qt.alpha(Kirigami.Theme.textColor, 0.08)
+
+                        Kirigami.Icon {
+                            anchors.centerIn: parent
+                            width: Kirigami.Units.iconSizes.medium
+                            height: width
+                            source: "camera-photo-symbolic"
+                        }
+                    }
+                }
+            }
+        }
+
+        ColumnLayout {
+            spacing: Kirigami.Units.largeSpacing
+
+            Item {
+                Layout.alignment: Qt.AlignHCenter
+                Layout.preferredWidth: Kirigami.Units.gridUnit * 14
+                Layout.preferredHeight: Layout.preferredWidth
+
+                Rectangle {
+                    anchors.fill: parent
+                    radius: Kirigami.Units.cornerRadius
+                    color: "black"
+                }
+
+                VideoOutput {
+                    id: viewfinder
+
+                    anchors.fill: parent
+                    fillMode: VideoOutput.PreserveAspectCrop
+                    visible: dialog.photo.toString() === ""
+                }
+
+                Image {
+                    anchors.fill: parent
+                    visible: dialog.photo.toString() !== ""
+                    source: dialog.photo
+                    cache: false
+                    fillMode: Image.PreserveAspectCrop
+                }
+            }
+
+            Label {
+                Layout.fillWidth: true
+                horizontalAlignment: Text.AlignHCenter
+                wrapMode: Text.Wrap
+                visible: dialog.cameraFailed
+                color: Kirigami.Theme.negativeTextColor
+                text: i18n("The camera didn't work.")
+            }
+
+            RowLayout {
+                Layout.alignment: Qt.AlignHCenter
+                spacing: Kirigami.Units.smallSpacing
+
+                Button {
+                    icon.name: "go-previous-symbolic"
+                    text: i18nc("@action:button", "Back")
+                    onClicked: {
+                        dialog.cameraOpen = false;
+                        dialog.photo = "";
+                        dialog.cameraFailed = false;
+                    }
+                }
+
+                Button {
+                    visible: dialog.photo.toString() === ""
+                    enabled: capture.readyForCapture
+                    icon.name: "camera-photo-symbolic"
+                    text: i18nc("@action:button", "Take Photo")
+                    onClicked: {
+                        dialog.cameraFailed = false;
+                        capture.captureToFile(AccountController.photoPath());
+                    }
+                }
+
+                Button {
+                    visible: dialog.photo.toString() !== ""
+                    icon.name: "view-refresh"
+                    text: i18nc("@action:button", "Retake")
+                    onClicked: dialog.photo = ""
+                }
+
+                Button {
+                    visible: dialog.photo.toString() !== ""
+                    icon.name: "dialog-ok-apply"
+                    text: i18nc("@action:button", "Use Photo")
+                    onClicked: dialog.choose(dialog.photo)
+                }
+            }
+        }
+    }
+}
