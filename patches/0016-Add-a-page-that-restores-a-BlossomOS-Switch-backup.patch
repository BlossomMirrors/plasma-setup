+bool external(const Solid::Device &device)
+{
+    for (Solid::Device parent = device; parent.isValid(); parent = parent.parent()) {
+        if (const auto *drive = parent.as<Solid::StorageDrive>()) {
+            return drive->isRemovable() || drive->isHotpluggable();
+        }
+    }
+    return false;
+}
