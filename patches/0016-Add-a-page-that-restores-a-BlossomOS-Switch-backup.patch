+    function onPageActivated(): void {
+        if (prefilled || Switch.SwitchUtil.profileAccent === "" || Prepare.PrepareUtil.accentColor !== "") {
+            return;
+        }
+        prefilled = true;
+        const wanted = Qt.color(Switch.SwitchUtil.profileAccent);
+        let nearest = accentPalette[0];
+        let best = Infinity;
+        for (const candidate of accentPalette) {
+            const color = Qt.color(candidate);
+            const distance = Math.pow(color.r - wanted.r, 2) + Math.pow(color.g - wanted.g, 2) + Math.pow(color.b - wanted.b, 2);
+            if (distance < best) {
+                best = distance;
+                nearest = candidate;
+            }
+        }
+        Prepare.PrepareUtil.accentColor = nearest;
+    }
+
+    function chooseWallpaper(entry: var): void {
+        if (entry.restored) {
+            Switch.SwitchUtil.useWallpaper = true;
+        } else {
