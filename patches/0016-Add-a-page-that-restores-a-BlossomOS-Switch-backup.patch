+bool readLine(int descriptor, QByteArray &line)
+{
+    line.clear();
+    char byte = 0;
+    while (line.size() < MAX_LINE) {
+        const ssize_t count = ::recv(descriptor, &byte, 1, 0);
+        if (count < 0 && errno == EINTR) {
+            continue;
+        }
+        if (count != 1) {
+            return false;
+        }
+        if (byte == '\n') {
+            return true;
+        }
+        line.append(byte);
+    }
+    return false;
+}
+
+bool readExact(int descriptor, char *data, qint64 size)
+{
+    qint64 total = 0;
+    while (total < size) {
+        const ssize_t count = ::recv(descriptor, data + total, size - total, 0);
+        if (count < 0 && errno == EINTR) {
+            continue;
+        }
+        if (count <= 0) {
+            return false;
+        }
+        total += count;
+    }
+    return true;
+}
+
+bool writeLine(int descriptor, const QJsonObject &message)
+{
+    const QByteArray data = QJsonDocument(message).toJson(QJsonDocument::Compact) + '\n';
+    qint64 total = 0;
+    while (total < data.size()) {
+        const ssize_t count = ::send(descriptor, data.constData() + total, data.size() - total, MSG_NOSIGNAL);
+        if (count < 0 && errno == EINTR) {
+            continue;
+        }
+        if (count <= 0) {
+            return false;
+        }
+        total += count;
+    }
+    return true;
+}
