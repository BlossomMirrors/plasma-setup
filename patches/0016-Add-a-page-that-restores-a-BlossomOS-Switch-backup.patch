+                    horizontalAlignment: Text.AlignHCenter
+                    wrapMode: Text.Wrap
+                    visible: root.mode === Switch.SwitchUtil.Network && !root.done && !root.working && !root.failed
+                    color: Kirigami.Theme.neutralTextColor
+                    text: Switch.SwitchUtil.peer === ""
+                        ? i18n("Waiting for your other computer…")
+                        : i18n("%1 is connected. Enter the PIN there.", Switch.SwitchUtil.peer)
+                }
+
+                Kirigami.InlineMessage {
+                    anchors.left: parent.left
+                    anchors.right: parent.right
+                    anchors.top: parent.top
+                    visible: !root.working && (root.failed || root.switchState === Switch.SwitchUtil.WrongPin)
+                    type: root.switchState === Switch.SwitchUtil.WrongPin ? Kirigami.MessageType.Warning : Kirigami.MessageType.Error
+                    text: {
+                        switch (root.switchState) {
+                        case Switch.SwitchUtil.WrongPin:
+                            return i18n("That's not the right PIN.");
+                        case Switch.SwitchUtil.NoSpace:
+                            return i18n("There isn't enough free space for this backup.");
+                        case Switch.SwitchUtil.Corrupt:
+                            return i18n("The backup is damaged and can't be read.");
+                        default:
+                            return i18n("Copying didn't work.");
+                        }
+                    }
+                    actions: [
+                        Kirigami.Action {
+                            visible: root.failed
+                            text: i18nc("@action:button", "Try Again")
+                            icon.name: "view-refresh"
+                            onTriggered: Switch.SwitchUtil.retry()
+                        }
+                    ]
+                }
+            }
+
+            Button {
+                Layout.alignment: Qt.AlignHCenter
+                flat: true
+                visible: !root.done
+                enabled: !root.busy
+                icon.name: "go-previous-symbolic"
+                text: i18nc("@action:button", "Choose Another Option")
+                onClicked: Switch.SwitchUtil.mode = Switch.SwitchUtil.None
+            }
+
+            Item {
+                Layout.fillHeight: true
+            }
+        }
+    }
+}
