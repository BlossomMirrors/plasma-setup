+                stream << "            widget.currentConfigGroup = [\"General\"];\n";
+                stream << "            widget.writeConfig(\"favorites\", favorites);\n";
+                stream << "            widget.writeConfig(\"favoritesPortedToKAstats\", false);\n";
+                stream << "        }\n";
+                stream << "    });\n";
+                stream << "});\n";
