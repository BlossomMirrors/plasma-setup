+    Q_PROPERTY(int percent READ percent NOTIFY progressChanged)
+    Q_PROPERTY(int appsTotal READ appsTotal NOTIFY appsChanged)
+    Q_PROPERTY(int appsDone READ appsDone NOTIFY appsChanged)
+    Q_PROPERTY(int appsFailed READ appsFailed NOTIFY appsChanged)
+    Q_PROPERTY(bool providesBrowser READ providesBrowser NOTIFY stateChanged)
+    Q_PROPERTY(QString profileName READ profileName NOTIFY stateChanged)
+    Q_PROPERTY(QString profileHostname READ profileHostname NOTIFY stateChanged)
+    Q_PROPERTY(QUrl profilePicture READ profilePicture NOTIFY stateChanged)
+    Q_PROPERTY(QString profileAccent READ profileAccent NOTIFY stateChanged)
+    Q_PROPERTY(QUrl wallpaper READ wallpaper NOTIFY stateChanged)
+    Q_PROPERTY(bool useWallpaper READ useWallpaper WRITE setUseWallpaper NOTIFY useWallpaperChanged)
+    Q_PROPERTY(QVariantList steps READ steps NOTIFY stepsChanged)
+    Q_PROPERTY(int pwaCount READ pwaCount NOTIFY stateChanged)
+
+public:
+    enum Mode {
+        None,
+        External,
+        Network,
+        Fresh,
+    };
+    Q_ENUM(Mode)
+
+    enum State {
+        Idle,
+        Waiting,
+        Checking,
+        WrongPin,
+        Copying,
+        Done,
+        NoSpace,
+        Corrupt,
+        Failed,
+    };
+    Q_ENUM(State)
+
+    explicit SwitchUtil(QObject *parent = nullptr);
+    ~SwitchUtil() override;
+
+    Mode mode() const;
+    void setMode(Mode mode);
+    State state() const;
+    QVariantList backups() const;
+    QString pin() const;
+    QString hostName() const;
+    QString peer() const;
+    QString source() const;
+    int percent() const;
+    int appsTotal() const;
+    int appsDone() const;
+    int appsFailed() const;
+    bool providesBrowser() const;
+    QString profileName() const;
+    QString profileHostname() const;
+    QUrl profilePicture() const;
+    QString profileAccent() const;
+    QUrl wallpaper() const;
+    bool useWallpaper() const;
+    void setUseWallpaper(bool use);
+    QVariantList steps() const;
+    int pwaCount() const;
+
+    Q_INVOKABLE void refreshBackups();
+    Q_INVOKABLE void restore(const QString &path, const QString &pin);
+    Q_INVOKABLE void retry();
+
+Q_SIGNALS:
+    void modeChanged();
+    void stateChanged();
+    void backupsChanged();
+    void pinChanged();
+    void peerChanged();
+    void progressChanged();
+    void appsChanged();
+    void useWallpaperChanged();
+    void stepsChanged();
+
+private:
+    void setState(State state);
+    void setPeer(const QString &peer);
+    void setPercent(qint64 done, qint64 total);
+    void prepareStaging(const std::function<void(bool)> &then);
+    void startNetwork();
+    void stopNetwork();
+    void setFirewall(bool open);
+    void accept(qintptr descriptor);
+    void receive(int descriptor);
+    void restoreBackup(const QString &path, const QByteArray &pin);
+    void finishRestore(const QJsonObject &manifest);
+    void resume();
+    void save() const;
+    void startApps();
+    void installNext();
+    void scan(const QString &root, const QString &drive);
+    void runWorker(const std::function<void()> &work);
+    QUrl stagedFile(const QString &path, const QString &folder) const;
+
+    Mode m_mode = None;
+    State m_state = Idle;
+    QVariantList m_backups;
+    QString m_pin;
+    QString m_peer;
+    QString m_source;
+    int m_percent = 0;
+    QJsonObject m_manifest;
+    bool m_stagingReady = false;
+    bool m_firewallOpen = false;
+    bool m_useWallpaper = true;
+
+    SwitchServer *m_server = nullptr;
+    KDNSSD::PublicService *m_service = nullptr;
+    QTimer *m_rescan = nullptr;
+    QThread *m_worker = nullptr;
+    std::atomic_bool m_cancelled = false;
+    std::atomic_int m_connection = -1;
+
+    struct App {
+        QString id;
+        QString name;
+        QString state = u"waiting"_s;
+        int percent = 0;
+        QString error;
+    };
+
+    void appFinished(int index, const QString &error);
+
+    QList<App> m_apps;
+    int m_appsDone = 0;
+    int m_appsFailed = 0;
+    QThread *m_installer = nullptr;
+    GCancellable *m_cancellable = nullptr;
+};
