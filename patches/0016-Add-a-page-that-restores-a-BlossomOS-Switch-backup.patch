diff --git a/src/accountcontroller.cpp b/src/accountcontroller.cpp
index 2702369..f817ca0 100644
--- a/src/accountcontroller.cpp
+++ b/src/accountcontroller.cpp
@@ -143,6 +143,35 @@ bool AccountController::createUser()
     return true;
 }
 
+void AccountController::createUserAsync(const std::function<void(const QString &error)> &done)
+{
+    qCInfo(PlasmaSetup) << "Creating user" << m_username << "with full name" << m_fullName;
+
+    QList<QWindow *> topLevelWindows = QGuiApplication::topLevelWindows();
+    KAuth::Action action(QStringLiteral("org.kde.plasmasetup.createuser"));
+    action.setParentWindow(topLevelWindows.isEmpty() ? nullptr : topLevelWindows.first());
+    action.setHelperId(QStringLiteral("org.kde.plasmasetup"));
+    action.setArguments({
+        {QStringLiteral("username"), m_username},
+        {QStringLiteral("fullName"), m_fullName},
+        {QStringLiteral("password"), m_password},
+        {QStringLiteral("extraGroups"), userGroupsFromConfig()},
+    });
+    KAuth::ExecuteJob *job = action.execute();
+    connect(job, &KJob::result, this, [job, done] {
+        if (job->error()) {
+            const QString errorMessage =
+                job->errorString().isEmpty() ? QStringLiteral("Authorization or helper failure (code %1)").arg(job->error()) : job->errorString();
+            qCWarning(PlasmaSetup) << "Failed to create user:" << errorMessage;
+            done(errorMessage);
+            return;
+        }
+        qCInfo(PlasmaSetup) << "User created successfully. Home:" << job->data().value(QStringLiteral("homePath")).toString();
+        done(QString());
+    });
+    job->start();
+}
