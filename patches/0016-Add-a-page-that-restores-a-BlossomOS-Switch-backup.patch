+ActionReply PlasmaSetupAuthHelper::restorebackup(const QVariantMap &args)
+{
+    if (!args.contains(QStringLiteral("username")) || !args[QStringLiteral("username")].canConvert<QString>()) {
+        return makeErrorReply(QStringLiteral("Username argument is missing or invalid."));
+    }
+    const QString username = args[QStringLiteral("username")].toString();
+
+    UserInfo userInfo;
+    try {
+        userInfo = getUserInfo(username);
+    } catch (const std::runtime_error &e) {
+        return makeErrorReply(QStringLiteral("Failed to get user info: ") + QString::fromStdString(e.what()));
+    }
+    const QString homePath = QDir::cleanPath(userInfo.homePath);
+    const QString staging = SWITCH_STAGING_DIR;
+
+    struct stat stagingInfo;
+    if (lstat(QFile::encodeName(staging).constData(), &stagingInfo) != 0 || !S_ISDIR(stagingInfo.st_mode)
+        || !QFile::exists(staging + QStringLiteral("/.complete"))) {
+        return makeErrorReply(QStringLiteral("There is no complete backup to restore."));
+    }
+    QFile manifestFile(staging + QStringLiteral("/manifest.json"));
+    if (!manifestFile.open(QIODevice::ReadOnly)) {
+        return makeErrorReply(QStringLiteral("Unable to read the backup manifest."));
+    }
+    const QJsonObject manifest = QJsonDocument::fromJson(manifestFile.readAll()).object();
+    manifestFile.close();
+    if (manifest.value(QStringLiteral("version")).toInt() != 1) {
+        return makeErrorReply(QStringLiteral("Unknown backup manifest version."));
+    }
+
+    const QString language = switchSystemLanguage();
+    QProcess userDirs;
+    userDirs.start(findExecutable(QStringLiteral("runuser")),
+                   {QStringLiteral("-u"),
+                    username,
+                    QStringLiteral("--"),
+                    QStringLiteral("env"),
+                    QStringLiteral("HOME=") + homePath,
+                    QStringLiteral("LANG=") + language,
+                    QStringLiteral("LC_ALL=") + language,
+                    QStringLiteral("xdg-user-dirs-update"),
+                    QStringLiteral("--force")});
+    if (!userDirs.waitForFinished() || userDirs.exitStatus() != QProcess::NormalExit || userDirs.exitCode() != 0) {
+        qWarning() << "xdg-user-dirs-update failed:" << userDirs.readAllStandardError();
+    }
+    const QMap<QString, QString> xdg = switchUserDirs(homePath);
+    const QMap<QString, QString> kinds = {
+        {QStringLiteral("desktop"), QStringLiteral("DESKTOP")},
+        {QStringLiteral("documents"), QStringLiteral("DOCUMENTS")},
+        {QStringLiteral("downloads"), QStringLiteral("DOWNLOAD")},
+        {QStringLiteral("music"), QStringLiteral("MUSIC")},
+        {QStringLiteral("pictures"), QStringLiteral("PICTURES")},
+        {QStringLiteral("videos"), QStringLiteral("VIDEOS")},
+    };
+    const auto kindDir = [&](const QString &kind) -> QString {
+        const QString dir = xdg.value(kinds.value(kind));
+        if (!dir.isEmpty() && dir != homePath && dir.startsWith(homePath + QLatin1Char('/'))) {
+            return dir;
+        }
+        static const QMap<QString, QString> fallback = {
+            {QStringLiteral("desktop"), QStringLiteral("Desktop")},
+            {QStringLiteral("documents"), QStringLiteral("Documents")},
+            {QStringLiteral("downloads"), QStringLiteral("Downloads")},
+            {QStringLiteral("music"), QStringLiteral("Music")},
+            {QStringLiteral("pictures"), QStringLiteral("Pictures")},
+            {QStringLiteral("videos"), QStringLiteral("Videos")},
+        };
+        return homePath + QLatin1Char('/') + fallback.value(kind);
+    };
+
+    const QJsonArray folders = manifest.value(QStringLiteral("folders")).toArray();
+    const int moves = int(folders.size()) + 2;
+    int moved = 0;
+    const auto reportMove = [&moved, moves] {
+        HelperSupport::progressStep(QVariantMap{{QStringLiteral("step"), QStringLiteral("move")}, {QStringLiteral("percent"), ++moved * 100 / moves}});
+    };
+    HelperSupport::progressStep(QVariantMap{{QStringLiteral("step"), QStringLiteral("move")}, {QStringLiteral("percent"), 0}});
+
+    QMap<QString, QString> restored;
+    for (const QJsonValue &value : folders) {
