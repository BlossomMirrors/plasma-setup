+
+#pragma once
+
+#include <QObject>
+#include <QPointer>
+#include <QString>
+
+#include <functional>
+
+typedef struct _GCancellable GCancellable;
+
+namespace FlatpakHelper
+{
+// Progress over all operations of a transaction (the app and the runtimes it
+// needs), handed to the Qt side
+struct TransactionProgress {
+    QPointer<QObject> receiver;
+    std::function<void(int)> report;
+    int operation = -1;
+    int operations = 1;
+};
+
+bool installedOnSystem(const QString &id);
+
+QString change(const QString &id, bool install, GCancellable *cancellable, TransactionProgress *progress);
+}
