+// SPDX-FileCopyrightText: 2026 Leonie Ain <me@koyu.space>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Layouts
+
+import org.kde.kirigami as Kirigami
+
+ScrollView {
+    id: list
+
+    property var steps: []
+
+    clip: true
+    contentWidth: availableWidth
+
+    ColumnLayout {
+        width: list.availableWidth
+        spacing: Kirigami.Units.smallSpacing
+
+        Repeater {
+            model: list.steps
+
+            delegate: RowLayout {
+                id: step
+
+                required property var modelData
+                readonly property string state: modelData.state
+                readonly property bool running: state === "running"
+
+                Layout.fillWidth: true
+                spacing: Kirigami.Units.largeSpacing
+
+                Item {
+                    Layout.alignment: Qt.AlignTop
+                    implicitWidth: Kirigami.Units.iconSizes.smallMedium
+                    implicitHeight: Kirigami.Units.iconSizes.smallMedium
+
+                    BusyIndicator {
+                        anchors.fill: parent
+                        padding: 0
+                        visible: step.running
+                        running: visible
+                    }
+
+                    Kirigami.Icon {
+                        anchors.fill: parent
+                        visible: !step.running
+                        isMask: step.state !== "waiting"
+                        source: step.state === "done" ? "emblem-ok-symbolic"
+                            : step.state === "failed" ? "dialog-error-symbolic"
+                            : "content-loading-symbolic"
+                        color: step.state === "done" ? Kirigami.Theme.positiveTextColor
+                            : step.state === "failed" ? Kirigami.Theme.negativeTextColor
+                            : Kirigami.Theme.disabledTextColor
+                        opacity: step.state === "waiting" ? 0.6 : 1
+                    }
+                }
+
+                ColumnLayout {
+                    Layout.fillWidth: true
+                    spacing: Kirigami.Units.smallSpacing
+
+                    RowLayout {
+                        Layout.fillWidth: true
+
+                        Label {
+                            Layout.fillWidth: true
+                            elide: Text.ElideRight
+                            font.weight: step.running ? Font.DemiBold : Font.Normal
+                            opacity: step.state === "waiting" ? 0.7 : 1
+                            text: step.modelData.title
+                        }
+
+                        Label {
+                            visible: step.running && step.modelData.percent >= 0
+                            opacity: 0.75
+                            text: i18nc("@info:progress percent", "%1%", step.modelData.percent)
+                        }
+                    }
+
+                    ProgressBar {
+                        Layout.fillWidth: true
+                        visible: step.running
+                        from: 0
+                        to: 100
+                        indeterminate: step.modelData.percent < 0
+                        value: Math.max(0, step.modelData.percent)
+                    }
+
+                    Label {
+                        Layout.fillWidth: true
+                        visible: step.state === "failed" && (step.modelData.detail ?? "") !== ""
+                        wrapMode: Text.Wrap
+                        maximumLineCount: 2
+                        elide: Text.ElideRight
+                        font: Kirigami.Theme.smallFont
+                        color: Kirigami.Theme.negativeTextColor
+                        text: step.modelData.detail ?? ""
+
+                        HoverHandler {
+                            id: detailHover
+                        }
+
+                        ToolTip.visible: detailHover.hovered && truncated
+                        ToolTip.text: text
+                        ToolTip.delay: Kirigami.Units.toolTipDelay
+                    }
+                }
+            }
+        }
+    }
+}
