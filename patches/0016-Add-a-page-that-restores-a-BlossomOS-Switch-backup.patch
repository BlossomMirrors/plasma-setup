+ActionReply PlasmaSetupAuthHelper::prepareswitch(const QVariantMap &args)
+{
+    Q_UNUSED(args);
+
+    const QByteArray staging = QFile::encodeName(SWITCH_STAGING_DIR);
+    struct stat info;
+    if (lstat(staging.constData(), &info) == 0) {
+        if (S_ISDIR(info.st_mode)) {
+            QDir(SWITCH_STAGING_DIR).removeRecursively();
+        } else {
+            ::unlink(staging.constData());
+        }
+    }
+    if (mkdir(staging.constData(), 0700) != 0) {
+        return makeErrorReply(QStringLiteral("Unable to create ") + SWITCH_STAGING_DIR);
+    }
+
+    struct passwd *setupUser = getpwnam("plasma-setup");
+    if (!setupUser || chown(staging.constData(), setupUser->pw_uid, setupUser->pw_gid) != 0) {
+        return makeErrorReply(QStringLiteral("Unable to hand ") + SWITCH_STAGING_DIR + QStringLiteral(" to the setup user"));
+    }
+
+    ActionReply reply = ActionReply::SuccessReply();
+    reply.setData({{QStringLiteral("path"), SWITCH_STAGING_DIR}});
+    return reply;
+}
