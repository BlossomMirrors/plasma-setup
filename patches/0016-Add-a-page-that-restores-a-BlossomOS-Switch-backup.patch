+void SwitchUtil::runWorker(const std::function<void()> &work)
+{
+    m_cancelled = false;
+    m_worker = QThread::create(work);
+    connect(m_worker, &QThread::finished, m_worker, &QObject::deleteLater);
+    connect(m_worker, &QThread::finished, this, [this] {
+        m_worker = nullptr;
+    });
+    m_worker->start();
+}
+
+void SwitchUtil::prepareStaging(const std::function<void(bool)> &then)
+{
+    if (m_stagingReady) {
+        then(true);
+        return;
+    }
+    if (preview()) {
+        QDir(stagingDir()).removeRecursively();
+        m_stagingReady = QDir().mkpath(stagingDir());
+        then(m_stagingReady);
+        return;
+    }
+    KAuth::Action action(u"org.kde.plasmasetup.prepareswitch"_s);
+    action.setHelperId(QLatin1String(HELPER_ID));
+    KAuth::ExecuteJob *job = action.execute();
+    connect(job, &KJob::result, this, [this, job, then] {
+        if (job->error()) {
+            qWarning() << "Failed to prepare the folder for the backup:" << job->errorString();
+        }
+        m_stagingReady = !job->error();
+        then(m_stagingReady);
+    });
+    job->start();
+}
+
+void SwitchUtil::retry()
+{
+    if (m_worker || (m_state != NoSpace && m_state != Corrupt && m_state != Failed)) {
+        return;
+    }
+    setPeer(QString());
+    setState(Idle);
+    if (m_mode == Network) {
+        stopNetwork();
+        startNetwork();
+    }
+}
+
+void SwitchUtil::refreshBackups()
+{
+    QVariantList previous = m_backups;
+    m_backups.clear();
+    const QList<Solid::Device> devices = Solid::Device::listFromType(Solid::DeviceInterface::StorageAccess);
+    for (Solid::Device device : devices) {
+        const auto *volume = device.as<Solid::StorageVolume>();
+        if ((volume && volume->isIgnored()) || !external(device)) {
+            continue;
+        }
+        auto *access = device.as<Solid::StorageAccess>();
+        if (access->isAccessible()) {
+            scan(access->filePath(), device.description());
+        } else if (!preview()) {
+            connect(access, &Solid::StorageAccess::accessibilityChanged, m_rescan, qOverload<>(&QTimer::start), Qt::UniqueConnection);
+            access->setup();
+        }
+    }
+    const QString previewRoot = qEnvironmentVariable("PLASMA_SETUP_PREVIEW_SWITCH_ROOT");
+    if (preview() && !previewRoot.isEmpty()) {
+        scan(previewRoot, u"Preview"_s);
+    }
+    if (m_backups != previous) {
+        Q_EMIT backupsChanged();
+    }
+}
+
+void SwitchUtil::scan(const QString &root, const QString &drive)
+{
+    const QDir dir(root + QLatin1Char('/') + QLatin1String(BACKUP_DIR));
+    const QFileInfoList entries = dir.entryInfoList(QDir::Dirs | QDir::NoDotAndDotDot, QDir::Name | QDir::Reversed);
+    for (const QFileInfo &entry : entries) {
+        QFile file(entry.absoluteFilePath() + "/switch.json"_L1);
+        if (!file.open(QIODevice::ReadOnly) || file.size() > MAX_LINE) {
+            continue;
+        }
+        const QJsonObject info = QJsonDocument::fromJson(file.readAll()).object();
+        if (info.value("format"_L1).toString() != "blossomos-switch"_L1 || info.value("version"_L1).toInt() != 1) {
+            continue;
+        }
+        m_backups << QVariantMap{
+            {u"path"_s, entry.absoluteFilePath()},
+            {u"computer"_s, info.value("computer"_L1).toString().left(64)},
+            {u"created"_s, QDateTime::fromString(info.value("created"_L1).toString(), Qt::ISODate)},
+            {u"size"_s, info.value("size"_L1).toDouble()},
+            {u"drive"_s, drive},
+        };
+    }
+}
+
+void SwitchUtil::restore(const QString &path, const QString &pin)
+{
+    if (m_mode != External || m_worker || m_state == Checking || m_state == Copying || m_state == Done || pin.size() != 6) {
+        return;
+    }
+    setState(Checking);
+    prepareStaging([this, path, pin](bool ready) {
+        if (!ready) {
+            setState(Failed);
+            return;
+        }
+        const QByteArray passphrase = pin.toLatin1();
+        runWorker([this, path, passphrase] {
+            restoreBackup(path, passphrase);
+        });
+    });
+}
+
+void SwitchUtil::restoreBackup(const QString &path, const QByteArray &pin)
+{
+    const auto report = [this](State state) {
+        QMetaObject::invokeMethod(this, [this, state] {
+            setState(state);
+        });
+    };
+
+    QFile infoFile(path + "/switch.json"_L1);
+    if (!infoFile.open(QIODevice::ReadOnly)) {
+        report(Failed);
+        return;
+    }
+    const QJsonObject info = QJsonDocument::fromJson(infoFile.readAll()).object();
+    const qint64 size = info.value("size"_L1).toInteger();
+    static const QRegularExpression partName(u"^data\\.age\\.\\d{3}$"_s);
+    QStringList parts;
+    for (const QJsonValue &value : info.value("parts"_L1).toArray()) {
+        const QString name = value.toString();
+        if (!partName.match(name).hasMatch() || !QFile::exists(path + QLatin1Char('/') + name)) {
+            report(Corrupt);
+            return;
+        }
+        parts << path + QLatin1Char('/') + name;
+    }
+    if (parts.isEmpty()) {
+        report(Corrupt);
+        return;
+    }
+    if (!enoughSpace(size)) {
+        report(NoSpace);
+        return;
+    }
+
+    int index = 0;
+    QFile current;
+    const AgeDecryptor::Source source = [&parts, &index, &current](char *data, qint64 maxSize) -> qint64 {
+        while (true) {
+            if (!current.isOpen()) {
+                if (index >= parts.size()) {
+                    return 0;
+                }
+                current.setFileName(parts.at(index++));
+                if (!current.open(QIODevice::ReadOnly)) {
+                    return -1;
+                }
+            }
+            const qint64 count = current.read(data, maxSize);
+            if (count != 0) {
+                return count;
+            }
+            current.close();
+        }
+    };
+
+    AgeDecryptor decryptor;
+    const QByteArray header = AgeDecryptor::readHeader(source);
+    const AgeDecryptor::HeaderResult result = header.isEmpty() ? AgeDecryptor::Corrupt : decryptor.open(header, pin);
+    if (result == AgeDecryptor::WrongPassphrase) {
+        report(WrongPin);
+        return;
+    }
+    if (result != AgeDecryptor::Ok) {
+        report(Corrupt);
+        return;
+    }
+    report(Copying);
+    decryptor.setSource(source);
+
+    BackupExtractor extractor(stagingDir());
+    extractor.setProgress([this, size](qint64 done) {
+        QMetaObject::invokeMethod(this, [this, done, size] {
+            setPercent(done, size);
+        });
+    });
+    const BackupExtractor::Result extracted = extractor.extract(decryptor, m_cancelled);
+    if (extracted != BackupExtractor::Done) {
+        report(extracted == BackupExtractor::IoError ? Failed : Corrupt);
+        return;
+    }
+    QFile complete(stagingDir() + "/.complete"_L1);
+    if (!complete.open(QIODevice::WriteOnly)) {
+        report(Failed);
+        return;
+    }
+    const QJsonObject manifest = extractor.manifest();
+    QMetaObject::invokeMethod(this, [this, manifest] {
+        finishRestore(manifest);
+    });
+}
+
+void SwitchUtil::startNetwork()
+{
+    QString pin;
+    for (int i = 0; i < 6; ++i) {
+        pin += QChar(u'0' + QRandomGenerator::system()->bounded(10));
+    }
+    m_pin = pin;
+    Q_EMIT pinChanged();
+
+    prepareStaging([this](bool ready) {
+        if (m_mode != Network) {
+            return;
+        }
+        if (!ready) {
+            setState(Failed);
+            return;
+        }
+        m_server = new SwitchServer;
+        m_server->handler = [this](qintptr descriptor) {
+            accept(descriptor);
+        };
+        if (!m_server->listen(QHostAddress::Any, PORT)) {
+            qWarning() << "Failed to listen for BlossomOS Switch:" << m_server->errorString();
+            delete m_server;
+            m_server = nullptr;
+            setState(Failed);
+            return;
+        }
+        m_service = new KDNSSD::PublicService(QSysInfo::machineHostName(), QLatin1String(SERVICE_TYPE), PORT);
+        m_service->setTextData({{u"v"_s, QByteArray("1")}});
+        m_service->publishAsync();
+        setFirewall(true);
+        setState(Waiting);
+    });
+}
+
+void SwitchUtil::stopNetwork()
+{
+    delete m_service;
+    m_service = nullptr;
+    delete m_server;
+    m_server = nullptr;
+    setFirewall(false);
+}
+
+void SwitchUtil::setFirewall(bool open)
+{
+    if (preview() || m_firewallOpen == open) {
+        return;
+    }
+    m_firewallOpen = open;
+    KAuth::Action action(u"org.kde.plasmasetup.switchfirewall"_s);
+    action.setHelperId(QLatin1String(HELPER_ID));
+    action.setArguments({{u"open"_s, open}});
+    KAuth::ExecuteJob *job = action.execute();
+    connect(job, &KJob::result, this, [job] {
+        if (job->error()) {
+            qWarning() << "Failed to change the firewall for BlossomOS Switch:" << job->errorString();
+        }
+    });
+    job->start();
+}
+
+void SwitchUtil::accept(qintptr descriptor)
+{
+    const int connection = int(descriptor);
+    if (m_worker || m_state == Done) {
+        writeLine(connection, {{u"error"_s, u"busy"_s}});
+        ::close(connection);
+        return;
+    }
+    int keepAlive = 1;
+    ::setsockopt(connection, SOL_SOCKET, SO_KEEPALIVE, &keepAlive, sizeof(keepAlive));
+    m_connection = connection;
+    runWorker([this, connection] {
+        receive(connection);
+        if (m_connection.exchange(-1) == connection) {
+            ::close(connection);
+        }
+    });
+}
+
+void SwitchUtil::receive(int descriptor)
+{
+    const auto report = [this](State state) {
+        QMetaObject::invokeMethod(this, [this, state] {
+            setState(state);
+        });
+    };
+    const auto reset = [this] {
+        QMetaObject::invokeMethod(this, [this] {
+            setPeer(QString());
+            if (m_mode == Network && m_state != Done && m_state != NoSpace && m_state != Corrupt) {
+                setState(Waiting);
+            }
+        });
+    };
+
+    QByteArray line;
+    if (!readLine(descriptor, line)) {
+        return;
+    }
+    const QJsonObject hello = QJsonDocument::fromJson(line).object();
+    if (hello.value("hello"_L1).toInt() != 1) {
+        return;
+    }
+    const QString computer = hello.value("computer"_L1).toString().left(64);
+    const qint64 size = hello.value("size"_L1).toInteger();
+    if (!enoughSpace(size)) {
+        writeLine(descriptor, {{u"error"_s, u"space"_s}});
+        report(NoSpace);
+        return;
+    }
+    if (!writeLine(descriptor, {{u"ready"_s, 1}})) {
+        return;
+    }
+    QMetaObject::invokeMethod(this, [this, computer] {
+        setPeer(computer);
+    });
+
+    const QByteArray pin = m_pin.toLatin1();
+    AgeDecryptor decryptor;
+    while (true) {
+        if (!readLine(descriptor, line)) {
+            reset();
+            return;
+        }
+        const qint64 headerSize = QJsonDocument::fromJson(line).object().value("header"_L1).toInteger();
+        if (headerSize <= 0 || headerSize > MAX_LINE) {
+            writeLine(descriptor, {{u"error"_s, u"corrupt"_s}});
+            reset();
+            return;
+        }
+        QByteArray header(headerSize, '\0');
+        if (!readExact(descriptor, header.data(), header.size())) {
+            reset();
+            return;
+        }
+        report(Checking);
+        const AgeDecryptor::HeaderResult result = decryptor.open(header, pin);
+        if (result == AgeDecryptor::Ok) {
+            break;
+        }
+        if (result == AgeDecryptor::WrongPassphrase) {
+            writeLine(descriptor, {{u"error"_s, u"pin"_s}});
+            report(WrongPin);
+            continue;
+        }
+        writeLine(descriptor, {{u"error"_s, u"corrupt"_s}});
+        report(Corrupt);
+        return;
+    }
+    if (!writeLine(descriptor, {{u"ok"_s, 1}})) {
+        reset();
+        return;
+    }
+    report(Copying);
+
+    decryptor.setSource([descriptor](char *data, qint64 maxSize) -> qint64 {
+        while (true) {
+            const ssize_t count = ::recv(descriptor, data, maxSize, 0);
+            if (count < 0 && errno == EINTR) {
+                continue;
+            }
+            return count;
+        }
+    });
+    BackupExtractor extractor(stagingDir());
+    extractor.setProgress([this, size](qint64 done) {
+        QMetaObject::invokeMethod(this, [this, done, size] {
+            setPercent(done, size);
+        });
+    });
+    const BackupExtractor::Result extracted = extractor.extract(decryptor, m_cancelled);
+    if (extracted != BackupExtractor::Done) {
+        writeLine(descriptor, {{u"error"_s, errorCode(extracted)}});
+        report(extracted == BackupExtractor::IoError ? Failed : Corrupt);
+        QMetaObject::invokeMethod(this, [this] {
+            stopNetwork();
+        });
+        return;
+    }
+    QFile complete(stagingDir() + "/.complete"_L1);
+    if (!complete.open(QIODevice::WriteOnly)) {
+        writeLine(descriptor, {{u"error"_s, u"io"_s}});
+        report(Failed);
+        return;
+    }
+    writeLine(descriptor, {{u"done"_s, 1}});
+    const QJsonObject manifest = extractor.manifest();
+    QMetaObject::invokeMethod(this, [this, manifest] {
+        finishRestore(manifest);
+        stopNetwork();
+    });
+}
+
+void SwitchUtil::finishRestore(const QJsonObject &manifest)
+{
+    m_manifest = manifest;
+    m_source = manifest.value("computer"_L1).toString().left(64);
+    setPercent(1, 1);
+    setState(Done);
+    save();
+    startApps();
+}
+
+void SwitchUtil::resume()
+{
+    const QString previewMode = qEnvironmentVariable("PLASMA_SETUP_PREVIEW_SWITCH");
+    if (preview() && previewMode != "done"_L1) {
+        if (previewMode == "external"_L1) {
+            setMode(External);
+        } else if (previewMode == "network"_L1) {
+            setMode(Network);
+        }
+        return;
+    }
+    QFile file(stagingDir() + "/manifest.json"_L1);
+    if (!QFile::exists(stagingDir() + "/.complete"_L1) || !file.open(QIODevice::ReadOnly)) {
+        return;
+    }
+    const QJsonObject manifest = QJsonDocument::fromJson(file.readAll()).object();
+    if (manifest.value("version"_L1).toInt() != 1) {
+        return;
+    }
+    const auto group = KSharedConfig::openConfig(u"plasma-setuprc"_s)->group(u"Switch"_s);
+    m_mode = group.readEntry("Mode", int(External)) == int(Network) ? Network : External;
+    m_stagingReady = true;
+    m_useWallpaper = group.readEntry("Wallpaper", true);
+    finishRestore(manifest);
+}
+
+void SwitchUtil::save() const
+{
+    auto config = KSharedConfig::openConfig(u"plasma-setuprc"_s);
+    KConfigGroup group = config->group(u"Switch"_s);
+    group.writeEntry("Mode", int(m_mode));
+    group.writeEntry("Restore", m_state == Done && m_mode != Fresh);
+    group.writeEntry("Wallpaper", m_useWallpaper);
+    if (providesBrowser()) {
+        config->group(u"Browser"_s).writeEntry("Default", m_manifest.value("browser"_L1).toObject().value("flatpak"_L1).toString());
+    }
+    config->sync();
+}
+
+void SwitchUtil::startApps()
+{
+    m_apps.clear();
+    const auto add = [this](const QString &id, const QString &name) {
+        const bool known = std::any_of(m_apps.cbegin(), m_apps.cend(), [&id](const App &app) {
+            return app.id == id;
+        });
+        if (validAppId(id) && !known) {
+            m_apps << App{id, name.simplified().isEmpty() ? id : name.simplified().left(80), u"waiting"_s, 0, QString()};
+        }
+    };
+    const QJsonObject browser = m_manifest.value("browser"_L1).toObject();
+    add(browser.value("flatpak"_L1).toString(), browser.value("name"_L1).toString());
+    for (const QJsonValue &value : m_manifest.value("apps"_L1).toArray()) {
+        add(value.toObject().value("flatpak"_L1).toString(), value.toObject().value("name"_L1).toString());
+    }
+    m_appsDone = 0;
+    m_appsFailed = 0;
+    Q_EMIT appsChanged();
+    installNext();
+}
+
+void SwitchUtil::appFinished(int index, const QString &error)
+{
+    App &app = m_apps[index];
+    app.state = error.isEmpty() ? u"done"_s : u"failed"_s;
+    app.error = error;
+    app.percent = 100;
+    if (!error.isEmpty()) {
+        qWarning() << "Failed to install" << app.id << "from the backup:" << error;
+        ++m_appsFailed;
+    }
+    ++m_appsDone;
+    Q_EMIT appsChanged();
+}
+
+void SwitchUtil::installNext()
+{
+    if (m_installer || m_appsDone >= m_apps.size()) {
+        return;
+    }
+    const int index = m_appsDone;
+    const QString id = m_apps.at(index).id;
+    m_apps[index].state = u"running"_s;
+    m_apps[index].percent = 0;
+    Q_EMIT appsChanged();
+
+    if (preview()) {
+        const bool fail = index == 1 && qEnvironmentVariableIntValue("PLASMA_SETUP_PREVIEW_SWITCH_FAIL") == 1;
+        auto *timer = new QTimer(this);
+        timer->setInterval(qEnvironmentVariableIntValue("PLASMA_SETUP_PREVIEW_SWITCH_SLOW") == 1 ? 400 : 40);
+        connect(timer, &QTimer::timeout, this, [this, timer, index, fail] {
+            m_apps[index].percent = std::min(100, m_apps[index].percent + 5);
+            Q_EMIT appsChanged();
+            if (m_apps[index].percent == 100 || (fail && m_apps[index].percent >= 40)) {
+                timer->deleteLater();
+                appFinished(index, fail ? u"Preview: this app isn't available from any software source."_s : QString());
+                installNext();
+            }
+        });
+        timer->start();
+        return;
+    }
+
+    GCancellable *cancellable = m_cancellable;
+    auto *progress = new FlatpakHelper::TransactionProgress{this, [this, index](int percent) {
+                                                                if (index < m_apps.size() && m_apps[index].state == u"running"_s) {
+                                                                    m_apps[index].percent = std::clamp(percent, m_apps[index].percent, 100);
+                                                                    Q_EMIT appsChanged();
+                                                                }
+                                                            }};
+    m_installer = QThread::create([this, index, id, cancellable, progress] {
+        QString error;
+        if (!FlatpakHelper::installedOnSystem(id)) {
+            error = FlatpakHelper::change(id, true, cancellable, progress);
+        }
+        QMetaObject::invokeMethod(this, [this, index, error] {
+            appFinished(index, error);
+        });
+    });
+    connect(m_installer, &QThread::finished, m_installer, &QObject::deleteLater);
+    connect(m_installer, &QThread::finished, this, [this, progress] {
+        delete progress;
+        m_installer = nullptr;
+        installNext();
+    });
+    m_installer->start();
+}
+
