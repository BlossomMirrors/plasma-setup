diff --git a/modules/switchutil/agedecryptor.cpp b/modules/switchutil/agedecryptor.cpp
new file mode 100644
index 0000000..f4c8905
--- /dev/null
+++ b/modules/switchutil/agedecryptor.cpp
@@ -0,0 +1,313 @@
+// SPDX-FileCopyrightText: 2026 Leonie Ain <me@koyu.space>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "agedecryptor.h"
+
+#include <QList>
+
+#include <openssl/core_names.h>
+#include <openssl/crypto.h>
+#include <openssl/evp.h>
+#include <openssl/hmac.h>
+#include <openssl/kdf.h>
+
+#include <memory>
+
+namespace
+{
+constexpr qint64 CHUNK_SIZE = 64 * 1024;
+constexpr qint64 TAG_SIZE = 16;
+constexpr qint64 MAX_HEADER_SIZE = 64 * 1024;
+constexpr int MAX_WORK_FACTOR = 22;
+
+QByteArray decodeBase64(const QByteArray &data)
+{
+    if (data.contains('=') || data.contains('\n')) {
+        return {};
+    }
+    const auto result = QByteArray::fromBase64Encoding(data, QByteArray::Base64Encoding | QByteArray::AbortOnBase64DecodingErrors);
+    return result ? result.decoded : QByteArray();
+}
+
+QByteArray hkdf(const QByteArray &key, const QByteArray &salt, const QByteArray &info)
+{
+    std::unique_ptr<EVP_KDF, decltype(&EVP_KDF_free)> kdf(EVP_KDF_fetch(nullptr, "HKDF", nullptr), EVP_KDF_free);
+    if (!kdf) {
+        return {};
+    }
+    std::unique_ptr<EVP_KDF_CTX, decltype(&EVP_KDF_CTX_free)> context(EVP_KDF_CTX_new(kdf.get()), EVP_KDF_CTX_free);
+    if (!context) {
+        return {};
+    }
+    char digest[] = "SHA256";
+    QByteArray keyCopy = key;
+    QByteArray saltCopy = salt;
+    QByteArray infoCopy = info;
+    QList<OSSL_PARAM> params;
+    params << OSSL_PARAM_construct_utf8_string(OSSL_KDF_PARAM_DIGEST, digest, 0);
+    params << OSSL_PARAM_construct_octet_string(OSSL_KDF_PARAM_KEY, keyCopy.data(), keyCopy.size());
+    if (!saltCopy.isEmpty()) {
+        params << OSSL_PARAM_construct_octet_string(OSSL_KDF_PARAM_SALT, saltCopy.data(), saltCopy.size());
+    }
+    params << OSSL_PARAM_construct_octet_string(OSSL_KDF_PARAM_INFO, infoCopy.data(), infoCopy.size());
+    params << OSSL_PARAM_construct_end();
+    QByteArray out(32, '\0');
+    if (EVP_KDF_derive(context.get(), reinterpret_cast<unsigned char *>(out.data()), out.size(), params.constData()) <= 0) {
+        return {};
+    }
+    return out;
+}
+
+bool chachaOpen(const QByteArray &key, const QByteArray &nonce, const char *data, qint64 size, QByteArray &out)
+{
+    if (key.size() != 32 || nonce.size() != 12 || size < TAG_SIZE) {
+        return false;
+    }
+    std::unique_ptr<EVP_CIPHER_CTX, decltype(&EVP_CIPHER_CTX_free)> context(EVP_CIPHER_CTX_new(), EVP_CIPHER_CTX_free);
+    if (!context || EVP_DecryptInit_ex(context.get(), EVP_chacha20_poly1305(), nullptr, nullptr, nullptr) != 1
+        || EVP_CIPHER_CTX_ctrl(context.get(), EVP_CTRL_AEAD_SET_IVLEN, 12, nullptr) != 1
+        || EVP_DecryptInit_ex(context.get(),
+                              nullptr,
+                              nullptr,
+                              reinterpret_cast<const unsigned char *>(key.constData()),
+                              reinterpret_cast<const unsigned char *>(nonce.constData()))
+            != 1) {
+        return false;
+    }
+    const qint64 plainSize = size - TAG_SIZE;
+    out.resize(plainSize);
+    int length = 0;
+    if (plainSize > 0
+        && EVP_DecryptUpdate(context.get(),
+                             reinterpret_cast<unsigned char *>(out.data()),
+                             &length,
+                             reinterpret_cast<const unsigned char *>(data),
+                             static_cast<int>(plainSize))
+            != 1) {
+        return false;
+    }
+    QByteArray tag(data + plainSize, TAG_SIZE);
+    if (EVP_CIPHER_CTX_ctrl(context.get(), EVP_CTRL_AEAD_SET_TAG, TAG_SIZE, tag.data()) != 1) {
+        return false;
+    }
+    int finalLength = 0;
+    return EVP_DecryptFinal_ex(context.get(), reinterpret_cast<unsigned char *>(out.data()) + length, &finalLength) > 0;
+}
+
+bool canonicalNumber(const QByteArray &text, int &value)
+{
+    if (text.isEmpty() || text.size() > 2 || (text.size() > 1 && text.startsWith('0'))) {
+        return false;
+    }
+    bool ok = false;
+    value = text.toInt(&ok);
+    return ok;
+}
+}
+
+QByteArray AgeDecryptor::readHeader(const Source &source)
+{
+    QByteArray header;
+    char byte = 0;
+    qint64 lineStart = 0;
+    while (header.size() < MAX_HEADER_SIZE) {
+        if (source(&byte, 1) != 1) {
+            return {};
+        }
+        header.append(byte);
+        if (byte == '\n') {
+            if (header.mid(lineStart, 4) == "--- ") {
+                return header;
+            }
+            lineStart = header.size();
+        }
+    }
+    return {};
+}
+
+AgeDecryptor::HeaderResult AgeDecryptor::open(const QByteArray &header, const QByteArray &passphrase)
+{
+    QList<QByteArray> lines = header.split('\n');
+    if (lines.size() < 4 || !lines.last().isEmpty()) {
+        return Corrupt;
+    }
+    lines.removeLast();
+    if (lines.first() != "age-encryption.org/v1") {
+        return Corrupt;
+    }
+    const QByteArray macLine = lines.last();
+    if (!macLine.startsWith("--- ")) {
+        return Corrupt;
+    }
+    const QByteArray mac = decodeBase64(macLine.mid(4));
+    if (mac.size() != 32) {
+        return Corrupt;
+    }
+
+    const QByteArray stanza = lines.at(1);
+    const QList<QByteArray> arguments = stanza.split(' ');
+    if (arguments.size() != 4 || arguments.at(0) != "->" || arguments.at(1) != "scrypt") {
+        return Corrupt;
+    }
+    const QByteArray salt = decodeBase64(arguments.at(2));
+    int workFactor = 0;
+    if (salt.size() != 16 || !canonicalNumber(arguments.at(3), workFactor) || workFactor < 1 || workFactor > MAX_WORK_FACTOR) {
+        return Corrupt;
+    }
+
+    QByteArray bodyText;
+    qsizetype index = 2;
+    for (; index < lines.size() - 1; ++index) {
+        bodyText += lines.at(index);
+        if (lines.at(index).size() < 64) {
+            ++index;
+            break;
+        }
+    }
+    if (index != lines.size() - 1) {
+        return Corrupt;
+    }
+    const QByteArray body = decodeBase64(bodyText);
+    if (body.size() != 32) {
+        return Corrupt;
+    }
+
+    const QByteArray scryptSalt = QByteArray("age-encryption.org/v1/scrypt") + salt;
+    QByteArray wrapKey(32, '\0');
+    const quint64 n = quint64(1) << workFactor;
+    if (EVP_PBE_scrypt(passphrase.constData(),
+                       passphrase.size(),
+                       reinterpret_cast<const unsigned char *>(scryptSalt.constData()),
+                       scryptSalt.size(),
+                       n,
+                       8,
+                       1,
+                       quint64(1) << 31,
+                       reinterpret_cast<unsigned char *>(wrapKey.data()),
+                       wrapKey.size())
+        != 1) {
+        return Corrupt;
+    }
+
+    QByteArray fileKey;
+    if (!chachaOpen(wrapKey, QByteArray(12, '\0'), body.constData(), body.size(), fileKey) || fileKey.size() != 16) {
+        OPENSSL_cleanse(wrapKey.data(), wrapKey.size());
+        return WrongPassphrase;
+    }
+    OPENSSL_cleanse(wrapKey.data(), wrapKey.size());
+
+    const QByteArray macKey = hkdf(fileKey, QByteArray(), "header");
+    const QByteArray authenticated = header.left(header.size() - macLine.size() - 1 + 3);
+    unsigned char computed[32];
+    unsigned int computedSize = 0;
+    if (macKey.size() != 32
+        || !HMAC(EVP_sha256(),
+                 macKey.constData(),
+                 macKey.size(),
+                 reinterpret_cast<const unsigned char *>(authenticated.constData()),
+                 authenticated.size(),
+                 computed,
+                 &computedSize)
+        || computedSize != 32 || CRYPTO_memcmp(computed, mac.constData(), 32) != 0) {
+        return Corrupt;
+    }
+
+    m_fileKey = fileKey;
+    return Ok;
+}
+
+void AgeDecryptor::setSource(const Source &source)
+{
+    m_source = source;
+}
+
+bool AgeDecryptor::failed() const
+{
+    return m_failed;
+}
+
+qint64 AgeDecryptor::readFull(char *data, qint64 size)
+{
+    qint64 total = 0;
+    while (total < size) {
+        const qint64 count = m_source(data + total, size - total);
+        if (count < 0) {
+            return -1;
+        }
+        if (count == 0) {
+            break;
+        }
+        total += count;
+    }
+    return total;
+}
+
+bool AgeDecryptor::readPayloadKey()
+{
+    QByteArray nonce(16, '\0');
+    if (readFull(nonce.data(), nonce.size()) != nonce.size()) {
+        return false;
+    }
+    m_payloadKey = hkdf(m_fileKey, nonce, "payload");
+    return m_payloadKey.size() == 32;
+}
+
+bool AgeDecryptor::nextChunk()
+{
+    const qint64 wanted = CHUNK_SIZE + TAG_SIZE + 1;
+    QByteArray buffer = m_lookahead;
+    m_lookahead.clear();
+    const qint64 had = buffer.size();
+    buffer.resize(wanted);
+    const qint64 count = readFull(buffer.data() + had, wanted - had);
+    if (count < 0) {
+        return false;
+    }
+    buffer.resize(had + count);
+
+    const bool last = buffer.size() < wanted;
+    if (!last) {
+        m_lookahead = buffer.right(1);
+        buffer.chop(1);
+    }
+    if (buffer.size() < TAG_SIZE || (last && buffer.size() == TAG_SIZE && m_counter > 0)) {
+        return false;
+    }
+
+    QByteArray nonce(12, '\0');
+    for (int i = 0; i < 8; ++i) {
+        nonce[10 - i] = static_cast<char>((m_counter >> (8 * i)) & 0xff);
+    }
+    nonce[11] = last ? 1 : 0;
+    if (!chachaOpen(m_payloadKey, nonce, buffer.constData(), buffer.size(), m_chunk)) {
+        return false;
+    }
+    ++m_counter;
+    m_position = 0;
+    m_last = last;
+    return true;
+}
+
+qint64 AgeDecryptor::read(char *data, qint64 maxSize)
+{
+    if (m_failed || m_fileKey.isEmpty() || !m_source) {
+        return -1;
+    }
+    if (m_payloadKey.isEmpty() && !readPayloadKey()) {
+        m_failed = true;
+        return -1;
+    }
+    while (m_position >= m_chunk.size()) {
+        if (m_last) {
+            return 0;
+        }
+        if (!nextChunk()) {
+            m_failed = true;
+            return -1;
+        }
+    }
+    const qint64 count = std::min(maxSize, qint64(m_chunk.size()) - m_position);
+    std::copy_n(m_chunk.constData() + m_position, count, data);
+    m_position += count;
+    return count;
+}
diff --git a/modules/switchutil/agedecryptor.h b/modules/switchutil/agedecryptor.h
new file mode 100644
index 0000000..745a56f
--- /dev/null
+++ b/modules/switchutil/agedecryptor.h
@@ -0,0 +1,42 @@
+// SPDX-FileCopyrightText: 2026 Leonie Ain <me@koyu.space>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <QByteArray>
+
+#include <functional>
+
+class AgeDecryptor
+{
+public:
+    enum HeaderResult {
+        Ok,
+        WrongPassphrase,
+        Corrupt,
+    };
+
+    using Source = std::function<qint64(char *data, qint64 maxSize)>;
+
+    static QByteArray readHeader(const Source &source);
+
+    HeaderResult open(const QByteArray &header, const QByteArray &passphrase);
+    void setSource(const Source &source);
+    qint64 read(char *data, qint64 maxSize);
+    bool failed() const;
+
+private:
+    bool readPayloadKey();
+    bool nextChunk();
+    qint64 readFull(char *data, qint64 size);
+
+    Source m_source;
+    QByteArray m_fileKey;
+    QByteArray m_payloadKey;
+    QByteArray m_chunk;
+    QByteArray m_lookahead;
+    qint64 m_position = 0;
+    quint64 m_counter = 0;
+    bool m_last = false;
+    bool m_failed = false;
+};
diff --git a/modules/switchutil/backupextractor.cpp b/modules/switchutil/backupextractor.cpp
new file mode 100644
index 0000000..7a7971e
--- /dev/null
+++ b/modules/switchutil/backupextractor.cpp
@@ -0,0 +1,200 @@
+// SPDX-FileCopyrightText: 2026 Leonie Ain <me@koyu.space>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "backupextractor.h"
+#include "agedecryptor.h"
+
+#include <QDir>
+#include <QFile>
+#include <QJsonDocument>
+
+#include <archive.h>
+#include <archive_entry.h>
+
+#include <memory>
+
+using namespace Qt::StringLiterals;
+
+namespace
+{
+constexpr qint64 BUFFER_SIZE = 256 * 1024;
+constexpr qint64 MAX_MANIFEST_SIZE = 16 * 1024 * 1024;
+
+struct ReadState {
+    AgeDecryptor *decryptor = nullptr;
+    QByteArray buffer;
+    qint64 total = 0;
+    const std::atomic_bool *cancelled = nullptr;
+    std::function<void(qint64)> progress;
+};
+
+la_ssize_t readCallback(struct archive *archive, void *data, const void **buffer)
+{
+    auto *state = static_cast<ReadState *>(data);
+    if (state->cancelled->load()) {
+        archive_set_error(archive, ECANCELED, "Cancelled");
+        return -1;
+    }
+    const qint64 count = state->decryptor->read(state->buffer.data(), state->buffer.size());
+    if (count < 0) {
+        archive_set_error(archive, EIO, "Decryption failed");
+        return -1;
+    }
+    state->total += count;
+    if (state->progress) {
+        state->progress(state->total);
+    }
+    *buffer = state->buffer.constData();
+    return count;
+}
+
+bool allowedTop(const QString &path)
+{
+    if (path == "manifest.json"_L1) {
+        return true;
+    }
+    const QString top = path.section(QLatin1Char('/'), 0, 0);
+    return top == "wallpaper"_L1 || top == "lockscreen"_L1 || top == "profile"_L1 || top == "ssh"_L1 || top == "browser"_L1 || top == "home"_L1;
+}
+}
+
+BackupExtractor::BackupExtractor(const QString &target)
+    : m_target{target}
+{
+}
+
+void BackupExtractor::setProgress(const std::function<void(qint64)> &progress)
+{
+    m_progress = progress;
+}
+
+QJsonObject BackupExtractor::manifest() const
+{
+    return m_manifest;
+}
+
+bool BackupExtractor::safePath(const QString &path)
+{
+    if (path.isEmpty() || path.startsWith(QLatin1Char('/')) || path.contains(QLatin1Char('\\')) || path.contains(QChar(0))) {
+        return false;
+    }
+    const QStringList parts = path.split(QLatin1Char('/'), Qt::SkipEmptyParts);
+    if (parts.isEmpty()) {
+        return false;
+    }
+    return std::none_of(parts.cbegin(), parts.cend(), [](const QString &part) {
+        return part == ".."_L1 || part == "."_L1;
+    });
+}
+
+BackupExtractor::Result BackupExtractor::extract(AgeDecryptor &decryptor, const std::atomic_bool &cancelled)
+{
+    ReadState state;
+    state.decryptor = &decryptor;
+    state.buffer.resize(BUFFER_SIZE);
+    state.cancelled = &cancelled;
+    state.progress = m_progress;
+
+    std::unique_ptr<struct archive, decltype(&archive_read_free)> reader(archive_read_new(), archive_read_free);
+    std::unique_ptr<struct archive, decltype(&archive_write_free)> writer(archive_write_disk_new(), archive_write_free);
+    archive_read_support_format_tar(reader.get());
+    archive_write_disk_set_options(writer.get(),
+                                   ARCHIVE_EXTRACT_TIME | ARCHIVE_EXTRACT_SECURE_NODOTDOT | ARCHIVE_EXTRACT_SECURE_SYMLINKS | ARCHIVE_EXTRACT_NO_OVERWRITE);
+    if (archive_read_open(reader.get(), &state, nullptr, readCallback, nullptr) != ARCHIVE_OK) {
+        return decryptor.failed() ? Corrupt : IoError;
+    }
+
+    const QString target = QDir(m_target).absolutePath();
+    bool first = true;
+    struct archive_entry *entry = nullptr;
+    while (true) {
+        const int status = archive_read_next_header(reader.get(), &entry);
+        if (status == ARCHIVE_EOF) {
+            break;
+        }
+        if (status != ARCHIVE_OK && status != ARCHIVE_WARN) {
+            return cancelled ? Cancelled : Corrupt;
+        }
+
+        const char *rawPath = archive_entry_pathname_utf8(entry);
+        if (!rawPath) {
+            rawPath = archive_entry_pathname(entry);
+        }
+        QString path = rawPath ? QString::fromUtf8(rawPath) : QString();
+        while (path.startsWith("./"_L1)) {
+            path.remove(0, 2);
+        }
+        if (path.endsWith(QLatin1Char('/'))) {
+            path.chop(1);
+        }
+        const auto type = archive_entry_filetype(entry);
+
+        if (first) {
+            first = false;
+            if (path != "manifest.json"_L1 || type != AE_IFREG || archive_entry_size(entry) > MAX_MANIFEST_SIZE) {
+                return Corrupt;
+            }
+            QByteArray data(archive_entry_size(entry), '\0');
+            if (archive_read_data(reader.get(), data.data(), data.size()) != data.size()) {
+                return Corrupt;
+            }
+            const QJsonDocument document = QJsonDocument::fromJson(data);
+            if (!document.isObject() || document.object().value("version"_L1).toInt() != 1) {
+                return Corrupt;
+            }
+            m_manifest = document.object();
+            QFile file(target + "/manifest.json"_L1);
+            if (!file.open(QIODevice::WriteOnly | QIODevice::Truncate) || file.write(data) != data.size()) {
+                return IoError;
+            }
+            continue;
+        }
+
+        if (!safePath(path) || !allowedTop(path) || (type != AE_IFREG && type != AE_IFDIR)) {
+            archive_read_data_skip(reader.get());
+            continue;
+        }
+
+        const QByteArray fullPath = QFile::encodeName(target + QLatin1Char('/') + path);
+        archive_entry_copy_pathname(entry, fullPath.constData());
+        if (path.section(QLatin1Char('/'), 0, 0) == "ssh"_L1) {
+            archive_entry_set_perm(entry, type == AE_IFDIR ? 0700 : 0600);
+        } else {
+            archive_entry_set_perm(entry, type == AE_IFDIR ? 0755 : (archive_entry_perm(entry) & 0755) | 0600);
+        }
+        if (archive_write_header(writer.get(), entry) != ARCHIVE_OK) {
+            archive_read_data_skip(reader.get());
+            continue;
+        }
+        if (type == AE_IFREG && archive_entry_size(entry) > 0) {
+            const void *block = nullptr;
+            size_t size = 0;
+            la_int64_t offset = 0;
+            while (true) {
+                const int result = archive_read_data_block(reader.get(), &block, &size, &offset);
+                if (result == ARCHIVE_EOF) {
+                    break;
+                }
+                if (result != ARCHIVE_OK) {
+                    return cancelled ? Cancelled : Corrupt;
+                }
+                if (archive_write_data_block(writer.get(), block, size, offset) != ARCHIVE_OK) {
+                    return IoError;
+                }
+            }
+        }
+        if (archive_write_finish_entry(writer.get()) != ARCHIVE_OK) {
+            return IoError;
+        }
+    }
+
+    if (first || decryptor.failed()) {
+        return Corrupt;
+    }
+    qint64 count = 0;
+    while ((count = decryptor.read(state.buffer.data(), state.buffer.size())) > 0) { }
+    if (count < 0) {
+        return Corrupt;
+    }
+    return archive_write_close(writer.get()) == ARCHIVE_OK ? Done : IoError;
+}
