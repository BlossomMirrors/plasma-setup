diff --git a/modules/flatpakhelper/flatpakhelper.cpp b/modules/flatpakhelper/flatpakhelper.cpp
new file mode 100644
index 0000000..4871975
--- /dev/null
+++ b/modules/flatpakhelper/flatpakhelper.cpp
@@ -0,0 +1,179 @@
+// SPDX-FileCopyrightText: 2026 Leonie Ain <me@koyu.space>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "flatpakhelper.h"
+
+#include <KLocalizedString>
+
+#include <QList>
+
+#include <flatpak.h>
+
+#include <algorithm>
+
+using namespace Qt::StringLiterals;
+
+namespace
+{
+QString takeError(GError *error)
+{
+    const QString message = error ? QString::fromUtf8(error->message) : i18n("Unknown error");
+    g_clear_error(&error);
+    return message;
+}
+
+// The remote and full ref of the app, from the enabled system remotes by
+// priority, preferring the stable branch
+bool findRemoteRef(FlatpakInstallation *installation, const QString &id, GCancellable *cancellable, QByteArray &remote, QByteArray &ref, QString &errorMessage)
+{
+    GError *error = nullptr;
+    GPtrArray *remotes = flatpak_installation_list_remotes(installation, cancellable, &error);
+    if (!remotes) {
+        errorMessage = takeError(error);
+        return false;
+    }
+    QList<FlatpakRemote *> sorted;
+    for (guint i = 0; i < remotes->len; ++i) {
+        auto *candidate = FLATPAK_REMOTE(g_ptr_array_index(remotes, i));
+        if (!flatpak_remote_get_disabled(candidate)) {
+            sorted << candidate;
+        }
+    }
+    std::stable_sort(sorted.begin(), sorted.end(), [](FlatpakRemote *a, FlatpakRemote *b) {
+        return flatpak_remote_get_prio(a) > flatpak_remote_get_prio(b);
+    });
+
+    const QByteArray name = id.toUtf8();
+    const char *arch = flatpak_get_default_arch();
+    for (FlatpakRemote *candidate : std::as_const(sorted)) {
+        GPtrArray *refs = flatpak_installation_list_remote_refs_sync(installation, flatpak_remote_get_name(candidate), cancellable, &error);
+        if (!refs) {
+            g_clear_error(&error);
+            continue;
+        }
+        QByteArray found;
+        for (guint i = 0; i < refs->len; ++i) {
+            auto *candidateRef = FLATPAK_REF(g_ptr_array_index(refs, i));
+            if (flatpak_ref_get_kind(candidateRef) != FLATPAK_REF_KIND_APP || name != flatpak_ref_get_name(candidateRef)
+                || qstrcmp(arch, flatpak_ref_get_arch(candidateRef)) != 0) {
+                continue;
+            }
+            if (found.isEmpty() || qstrcmp(flatpak_ref_get_branch(candidateRef), "stable") == 0) {
+                char *formatted = flatpak_ref_format_ref(candidateRef);
+                found = formatted;
+                g_free(formatted);
+            }
+        }
+        g_ptr_array_unref(refs);
+        if (!found.isEmpty()) {
+            remote = flatpak_remote_get_name(candidate);
+            ref = found;
+            g_ptr_array_unref(remotes);
+            return true;
+        }
+    }
+    g_ptr_array_unref(remotes);
+    errorMessage = i18n("%1 isn't available from any software source.", id);
+    return false;
+}
+
+void onProgressChanged(FlatpakTransactionProgress *progress, gpointer data)
+{
+    auto *state = static_cast<FlatpakHelper::TransactionProgress *>(data);
+    if (!state->receiver || !state->report) {
+        return;
+    }
+    const int overall = (state->operation * 100 + flatpak_transaction_progress_get_progress(progress)) / state->operations;
+    QMetaObject::invokeMethod(state->receiver, [report = state->report, overall] {
+        report(overall);
+    });
+}
+
+void onNewOperation(FlatpakTransaction *transaction, FlatpakTransactionOperation *, FlatpakTransactionProgress *progress, gpointer data)
+{
+    auto *state = static_cast<FlatpakHelper::TransactionProgress *>(data);
+    GList *operations = flatpak_transaction_get_operations(transaction);
+    state->operations = std::max(1u, g_list_length(operations));
+    g_list_free_full(operations, g_object_unref);
+    ++state->operation;
+    flatpak_transaction_progress_set_update_frequency(progress, 250);
+    g_signal_connect(progress, "changed", G_CALLBACK(onProgressChanged), data);
+}
+
+// Runs a transaction that add() fills, reporting its progress
+QString runTransaction(FlatpakInstallation *installation,
+                       GCancellable *cancellable,
+                       FlatpakHelper::TransactionProgress *progress,
+                       const std::function<bool(FlatpakTransaction *, GError **)> &add)
+{
+    GError *error = nullptr;
+    FlatpakTransaction *transaction = flatpak_transaction_new_for_installation(installation, cancellable, &error);
+    if (!transaction) {
+        return takeError(error);
+    }
+    QString message;
+    flatpak_transaction_set_no_interaction(transaction, TRUE);
+    flatpak_transaction_add_default_dependency_sources(transaction);
+    g_signal_connect(transaction, "new-operation", G_CALLBACK(onNewOperation), progress);
+    if (!add(transaction, &error) || !flatpak_transaction_run(transaction, cancellable, &error)) {
+        message = takeError(error);
+    }
+    g_object_unref(transaction);
+    return message;
+}
+}
+
+namespace FlatpakHelper
+{
+bool installedOnSystem(const QString &id)
+{
+    GError *error = nullptr;
+    FlatpakInstallation *installation = flatpak_installation_new_system(nullptr, &error);
+    if (!installation) {
+        g_clear_error(&error);
+        return false;
+    }
+    FlatpakInstalledRef *ref = flatpak_installation_get_current_installed_app(installation, id.toUtf8().constData(), nullptr, &error);
+    g_clear_error(&error);
+    const bool installed = ref != nullptr;
+    g_clear_object(&ref);
+    g_object_unref(installation);
+    return installed;
+}
+
+// Installs or removes the app, in the worker thread
+QString change(const QString &id, bool install, GCancellable *cancellable, TransactionProgress *progress)
+{
+    GError *error = nullptr;
+    FlatpakInstallation *installation = flatpak_installation_new_system(cancellable, &error);
+    if (!installation) {
+        return takeError(error);
+    }
+
+    QString message;
+    if (install) {
+        QByteArray remote;
+        QByteArray ref;
+        if (findRemoteRef(installation, id, cancellable, remote, ref, message)) {
+            message = runTransaction(installation, cancellable, progress, [&remote, &ref](FlatpakTransaction *transaction, GError **error) {
+                return flatpak_transaction_add_install(transaction, remote.constData(), ref.constData(), nullptr, error);
+            });
+        }
+    } else {
+        FlatpakInstalledRef *installed = flatpak_installation_get_current_installed_app(installation, id.toUtf8().constData(), cancellable, &error);
+        g_clear_error(&error);
+        // Already gone otherwise
+        if (installed) {
+            char *formatted = flatpak_ref_format_ref(FLATPAK_REF(installed));
+            const QByteArray ref = formatted;
+            g_free(formatted);
+            g_object_unref(installed);
+            message = runTransaction(installation, cancellable, progress, [&ref](FlatpakTransaction *transaction, GError **error) {
+                return flatpak_transaction_add_uninstall(transaction, ref.constData(), error);
+            });
+        }
+    }
+    g_object_unref(installation);
+    return message;
+}
+}
