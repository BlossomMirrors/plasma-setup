+    }
+    if (preview()) {
+        QCoreApplication::quit();
+        return;
+    }
+    if (m_userCreated) {
+        finishUserSteps();
+    } else {
+        logOut();
+    }
+}
+
+void InitialStartUtil::previewFinish(int tick)
+{
+    if (tick >= 60) {
+        QTimer::singleShot(1500, qApp, &QCoreApplication::quit);
+        return;
+    }
+    const bool fail = qEnvironmentVariableIntValue("PLASMA_SETUP_PREVIEW_FINISH_FAIL") == 1;
+    const bool hasRestore = m_steps.size() > 1;
+    if (tick < 5) {
+        setStep(QStringLiteral("user"), QStringLiteral("running"));
+    } else if (!hasRestore) {
+        previewFinish(60);
+        return;
+    } else if (tick < 25) {
+        setStep(QStringLiteral("move"), QStringLiteral("running"), (tick - 5) * 5);
+        if (fail && tick == 17) {
+            failFinish(QStringLiteral("move"), QStringLiteral("Preview: the files couldn't be moved."));
+            return;
+        }
+    } else if (tick < 45) {
+        if (tick == 25) {
+            m_steps.insert(m_steps.size() - 1, FinishStep{QStringLiteral("apps"), i18n("Install the remaining apps"), QStringLiteral("waiting")});
+        }
+        setStep(QStringLiteral("apps"), QStringLiteral("running"), (tick - 25) * 5);
+    } else {
+        setStep(QStringLiteral("settings"), QStringLiteral("running"));
+    }
+    const int interval = qEnvironmentVariableIntValue("PLASMA_SETUP_PREVIEW_SWITCH_SLOW") == 1 ? 400 : 100;
+    QTimer::singleShot(interval, this, [this, tick] {
+        previewFinish(tick + 1);
+    });
 }
 
