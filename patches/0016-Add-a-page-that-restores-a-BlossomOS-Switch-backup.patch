+                continue;
+            }
+            target = homePath + QLatin1Char('/') + name;
+            key = QStringLiteral("custom/") + folder.value(QStringLiteral("name")).toString();
+        } else if (kinds.contains(kind) && path == QStringLiteral("home/") + kind) {
+            target = kindDir(kind);
