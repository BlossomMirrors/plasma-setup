+                implicitWidth: Kirigami.Units.iconSizes.small
+                implicitHeight: Kirigami.Units.iconSizes.small
+                opacity: row.checked ? 1 : 0
+                source: "emblem-ok-symbolic"
+                color: Kirigami.Theme.highlightColor
+                isMask: true
+            }
+        }
+    }
+
+    contentItem: StackLayout {
