+static bool switchAppId(const QString &id)
+{
+    static const QRegularExpression appId(QStringLiteral("^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)+$"));
+    return appId.match(id).hasMatch();
+}
+
+static bool switchDesktopId(const QString &id)
+{
+    static const QRegularExpression desktopId(QStringLiteral("^[A-Za-z0-9_-][A-Za-z0-9_.-]*$"));
+    return desktopId.match(id).hasMatch() && !id.contains(QLatin1String(".."));
+}
+
+static QString switchDesktopFile(const QString &id, const QString &homePath)
+{
+    if (!switchDesktopId(id)) {
+        return {};
+    }
+    const QStringList directories = {
+        homePath + QStringLiteral("/.local/share/applications"),
+        homePath + QStringLiteral("/.local/share/flatpak/exports/share/applications"),
+        FLATPAK_EXPORTS,
+        QStringLiteral("/usr/local/share/applications"),
+        QStringLiteral("/usr/share/applications"),
+    };
+    for (const QString &directory : directories) {
+        const QString path = QDir(directory).filePath(id + QStringLiteral(".desktop"));
+        if (QFileInfo(path).isFile()) {
+            return path;
+        }
+    }
+    return {};
+}
+
+static bool switchSafePath(const QString &path)
+{
+    if (path.isEmpty() || path.startsWith(QLatin1Char('/')) || path.contains(QLatin1Char('\\'))) {
+        return false;
+    }
+    const QStringList parts = path.split(QLatin1Char('/'), Qt::SkipEmptyParts);
+    return !parts.isEmpty() && std::none_of(parts.cbegin(), parts.cend(), [](const QString &part) {
+        return part == QLatin1String("..") || part == QLatin1String(".");
+    });
+}
+
+static QString switchFileName(const QString &name)
+{
+    QString result = name;
+    result.replace(QLatin1Char('/'), QLatin1Char('_'));
+    while (result.startsWith(QLatin1Char('.'))) {
+        result.remove(0, 1);
+    }
+    return result.trimmed().left(200);
+}
+
+static QString switchUniquePath(const QString &directory, const QString &name)
+{
+    const QFileInfo info(name);
+    const QString base = info.completeBaseName().isEmpty() ? name : info.completeBaseName();
+    const QString suffix = info.completeBaseName().isEmpty() || info.suffix().isEmpty() ? QString() : QLatin1Char('.') + info.suffix();
+    for (int i = 2;; ++i) {
+        const QString candidate = directory + QLatin1Char('/') + base + QStringLiteral(" (%1)").arg(i) + suffix;
+        if (!QFileInfo::exists(candidate) && !QFileInfo(candidate).isSymLink()) {
+            return candidate;
+        }
+    }
+}
+
+static bool switchMove(const QString &source, const QString &target)
+{
+    if (::rename(QFile::encodeName(source).constData(), QFile::encodeName(target).constData()) == 0) {
+        return true;
+    }
+    QProcess mv;
+    mv.start(findExecutable(QStringLiteral("mv")), {QStringLiteral("-n"), QStringLiteral("--"), source, target});
+    return mv.waitForFinished(-1) && mv.exitStatus() == QProcess::NormalExit && mv.exitCode() == 0;
+}
+
+static void switchMergeMove(const QString &source, const QString &target)
+{
+    QDir().mkpath(target);
+    const QFileInfoList entries = QDir(source).entryInfoList(QDir::AllEntries | QDir::NoDotAndDotDot | QDir::Hidden | QDir::System);
+    for (const QFileInfo &entry : entries) {
+        QString destination = target + QLatin1Char('/') + entry.fileName();
+        const QFileInfo existing(destination);
+        if (existing.exists() || existing.isSymLink()) {
+            if (entry.isDir() && !entry.isSymLink() && existing.isDir() && !existing.isSymLink()) {
+                switchMergeMove(entry.absoluteFilePath(), destination);
+                continue;
+            }
+            destination = switchUniquePath(target, entry.fileName());
+        }
+        if (!switchMove(entry.absoluteFilePath(), destination)) {
+            qWarning() << "Failed to move" << entry.absoluteFilePath() << "to" << destination;
+        }
+    }
+}
+
+static uid_t switchOwnerUid = 0;
+static gid_t switchOwnerGid = 0;
+
+static int switchChownEntry(const char *path, const struct stat *, int, struct FTW *)
+{
+    if (lchown(path, switchOwnerUid, switchOwnerGid) != 0) {
+        qWarning() << "Failed to change the owner of" << path << ": error" << errno;
+    }
+    return 0;
+}
+
+static QString switchShellQuote(const QString &text)
+{
+    QString quoted = text;
+    quoted.replace(QLatin1Char('\''), QStringLiteral("'\\''"));
+    return QLatin1Char('\'') + quoted + QLatin1Char('\'');
+}
+
+static QString switchSystemLanguage()
+{
+    QFile localeConf(QStringLiteral("/etc/locale.conf"));
+    if (localeConf.open(QIODevice::ReadOnly | QIODevice::Text)) {
+        while (!localeConf.atEnd()) {
+            const QString line = QString::fromUtf8(localeConf.readLine()).trimmed();
+            if (line.startsWith(QLatin1String("LANG="))) {
+                QString value = line.mid(5);
+                value.remove(QLatin1Char('"'));
+                static const QRegularExpression allowed(QStringLiteral("^[A-Za-z0-9_.@-]+$"));
+                if (allowed.match(value).hasMatch()) {
+                    return value;
+                }
+            }
+        }
+    }
+    return QStringLiteral("C.UTF-8");
+}
+
+static QMap<QString, QString> switchUserDirs(const QString &homePath)
+{
+    QMap<QString, QString> dirs;
+    QFile file(homePath + QStringLiteral("/.config/user-dirs.dirs"));
+    if (!file.open(QIODevice::ReadOnly | QIODevice::Text)) {
+        return dirs;
+    }
+    static const QRegularExpression entry(QStringLiteral("^XDG_([A-Z]+)_DIR=\"(.*)\"$"));
+    while (!file.atEnd()) {
+        const QRegularExpressionMatch match = entry.match(QString::fromUtf8(file.readLine()).trimmed());
+        if (match.hasMatch()) {
+            QString path = match.captured(2);
+            path.replace(QStringLiteral("$HOME"), homePath);
+            dirs.insert(match.captured(1), QDir::cleanPath(path));
+        }
+    }
+    return dirs;
+}
