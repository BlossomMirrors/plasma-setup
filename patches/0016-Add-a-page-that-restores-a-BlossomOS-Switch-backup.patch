+SwitchUtil::SwitchUtil(QObject *parent)
+    : QObject{parent}
+    , m_rescan{new QTimer(this)}
+    , m_cancellable{g_cancellable_new()}
+{
+    m_rescan->setSingleShot(true);
+    m_rescan->setInterval(1000);
+    connect(m_rescan, &QTimer::timeout, this, &SwitchUtil::refreshBackups);
+    connect(Solid::DeviceNotifier::instance(), &Solid::DeviceNotifier::deviceAdded, m_rescan, qOverload<>(&QTimer::start));
+    connect(Solid::DeviceNotifier::instance(), &Solid::DeviceNotifier::deviceRemoved, m_rescan, qOverload<>(&QTimer::start));
+    connect(this, &SwitchUtil::stateChanged, this, &SwitchUtil::stepsChanged);
+    connect(this, &SwitchUtil::progressChanged, this, &SwitchUtil::stepsChanged);
+    connect(this, &SwitchUtil::appsChanged, this, &SwitchUtil::stepsChanged);
+    resume();
+}
