+SwitchUtil::~SwitchUtil()
+{
+    m_cancelled = true;
+    const int connection = m_connection.exchange(-1);
+    if (connection >= 0) {
+        ::shutdown(connection, SHUT_RDWR);
+    }
+    g_cancellable_cancel(m_cancellable);
+    if (m_worker) {
+        m_worker->wait();
+    }
+    if (m_installer) {
+        m_installer->wait();
+    }
+    stopNetwork();
+    g_object_unref(m_cancellable);
+}
