+QVariantList SwitchUtil::steps() const
+{
+    QString copyState = u"waiting"_s;
+    QString copyDetail;
+    switch (m_state) {
+    case Checking:
+    case Copying:
+        copyState = u"running"_s;
+        break;
+    case Done:
+        copyState = u"done"_s;
+        break;
+    case NoSpace:
+        copyState = u"failed"_s;
+        copyDetail = i18n("There isn't enough free space for this backup.");
+        break;
+    case Corrupt:
+        copyState = u"failed"_s;
+        copyDetail = i18n("The backup is damaged and can't be read.");
+        break;
+    case Failed:
+        copyState = u"failed"_s;
+        copyDetail = i18n("Copying didn't work.");
+        break;
+    default:
+        break;
+    }
+    QVariantList list{QVariantMap{
+        {u"title"_s, m_state == Checking ? i18n("Checking the PIN…") : i18n("Copy files")},
+        {u"state"_s, copyState},
+        {u"percent"_s, m_state == Checking ? -1 : m_percent},
+        {u"detail"_s, copyDetail},
+    }};
+    for (const App &app : m_apps) {
+        list << QVariantMap{
+            {u"title"_s, i18nc("@info:progress %1 is an app", "Install %1", app.name)},
+            {u"state"_s, app.state},
+            {u"percent"_s, app.percent},
+            {u"detail"_s, app.error},
+        };
+    }
+    return list;
