+ActionReply PlasmaSetupAuthHelper::switchfirewall(const QVariantMap &args)
+{
+    const bool open = args.value(QStringLiteral("open")).toBool();
+    QProcessEnvironment environment = QProcessEnvironment::systemEnvironment();
+    environment.insert(QStringLiteral("LANG"), QStringLiteral("C"));
+    environment.insert(QStringLiteral("LC_ALL"), QStringLiteral("C"));
+
+    const QString ufwBinary = findExecutable(QStringLiteral("ufw"));
+    if (!ufwBinary.isEmpty()) {
+        QProcess status;
+        status.setProcessEnvironment(environment);
+        status.start(ufwBinary, {QStringLiteral("status")});
+        if (status.waitForFinished() && status.readAllStandardOutput().contains("Status: active")) {
+            QProcess rule;
+            rule.setProcessEnvironment(environment);
+            rule.start(ufwBinary,
+                       open ? QStringList{QStringLiteral("allow"), SWITCH_PORT} : QStringList{QStringLiteral("delete"), QStringLiteral("allow"), SWITCH_PORT});
+            if (!rule.waitForFinished() || rule.exitStatus() != QProcess::NormalExit || rule.exitCode() != 0) {
+                return makeErrorReply(QStringLiteral("ufw failed: ") + QString::fromLocal8Bit(rule.readAllStandardError()).trimmed());
+            }
+        }
+    }
+
+    const QString firewallBinary = findExecutable(QStringLiteral("firewall-cmd"));
+    if (!firewallBinary.isEmpty()) {
+        QProcess state;
+        state.setProcessEnvironment(environment);
+        state.start(firewallBinary, {QStringLiteral("--state")});
+        if (state.waitForFinished() && state.exitStatus() == QProcess::NormalExit && state.exitCode() == 0) {
+            QProcess rule;
+            rule.start(firewallBinary, {(open ? QStringLiteral("--add-port=") : QStringLiteral("--remove-port=")) + SWITCH_PORT});
+            rule.waitForFinished();
+        }
+    }
+
+    return ActionReply::SuccessReply();
+}
