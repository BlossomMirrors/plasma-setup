+PlasmaSetupComponents.SetupModule {
+    id: root
+
+    readonly property int mode: Switch.SwitchUtil.mode
+    readonly property int switchState: Switch.SwitchUtil.state
+    readonly property bool done: switchState === Switch.SwitchUtil.Done
+    readonly property bool working: switchState === Switch.SwitchUtil.Checking || switchState === Switch.SwitchUtil.Copying
+    readonly property bool installing: done && Switch.SwitchUtil.appsDone < Switch.SwitchUtil.appsTotal
+    readonly property bool busy: working || installing || (mode === Switch.SwitchUtil.Network && !done && Switch.SwitchUtil.peer !== "")
+    readonly property bool failed: switchState === Switch.SwitchUtil.NoSpace || switchState === Switch.SwitchUtil.Corrupt || switchState === Switch.SwitchUtil.Failed
+    property string selectedBackup: ""
+    property bool online: InitialStartUtil.online()
+
+    available: !AccountController.hasExistingUsers
+    nextEnabled: !busy && (done || mode === Switch.SwitchUtil.Fresh)
+    backEnabled: !busy
+
+    function onPageActivated(): void {
+        online = InitialStartUtil.online();
+        if (!online && mode === Switch.SwitchUtil.Network) {
+            Switch.SwitchUtil.mode = Switch.SwitchUtil.None;
+        }
+        if (mode === Switch.SwitchUtil.External) {
+            Switch.SwitchUtil.refreshBackups();
+        }
+    }
+
+    function selectBackup(): void {
+        const backups = Switch.SwitchUtil.backups;
+        if (!backups.some(backup => backup.path === selectedBackup)) {
+            selectedBackup = backups.length > 0 ? backups[0].path : "";
+        }
+    }
+
+    Component.onCompleted: selectBackup()
+
+    function restore(): void {
+        if (selectedBackup !== "" && pinField.acceptableInput) {
+            Switch.SwitchUtil.restore(selectedBackup, pinField.text);
+        }
+    }
+
+    Connections {
+        target: Switch.SwitchUtil
+
+        function onStateChanged(): void {
+            if (root.switchState === Switch.SwitchUtil.WrongPin) {
+                pinField.selectAll();
+                pinField.forceActiveFocus();
+            }
+        }
+
+        function onBackupsChanged(): void {
+            root.selectBackup();
+        }
+    }
