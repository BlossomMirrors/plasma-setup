+QString SwitchUtil::profileHostname() const
+{
+    if (m_state != Done) {
+        return {};
+    }
+    QString hostname;
+    const QString source = m_manifest.value("profile"_L1).toObject().value("hostname"_L1).toString().toLower();
+    for (const QChar c : source) {
+        if ((c >= u'a' && c <= u'z') || (c >= u'0' && c <= u'9') || c == u'-') {
+            hostname += c;
+        }
+    }
+    while (hostname.startsWith(u'-')) {
+        hostname.remove(0, 1);
+    }
+    hostname.truncate(63);
+    while (hostname.endsWith(u'-')) {
+        hostname.chop(1);
+    }
+    return hostname;
+}
