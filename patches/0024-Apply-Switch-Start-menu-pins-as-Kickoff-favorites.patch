From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: koyu <me@koyu.space>
Date: Tue, 24 Nov 2026 21:10:59 +0100
Subject: [PATCH 24/24] Apply Switch Start menu pins as Kickoff favorites

---
 src/auth/authhelper.cpp | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/src/auth/authhelper.cpp b/src/auth/authhelper.cpp
index bda5383..1e020a8 100644
--- a/src/auth/authhelper.cpp
+++ b/src/auth/authhelper.cpp
@@ -1855,6 +1855,26 @@ ActionReply PlasmaSetupAuthHelper::finishSwitchUser(const SwitchUser &user)
                 stream << "layout=\"var launchers = [${launchers%,}]; var favorites = [${favorites%,}]; $(cat \"$dir/layout.js\")\"\n";
                 stream << "dbus-send --session --print-reply --dest=org.kde.plasmashell --type=method_call /PlasmaShell org.kde.PlasmaShell.evaluateScript "
                           "\"string:$layout\" >/dev/null || exit 0\n";
+                if (!start.isEmpty()) {
+                    stream << "favorite() {\n";
+                    stream << "    dbus-send --session --print-reply --dest=org.kde.ActivityManager /ActivityManager/Resources/Linking "
+                              "org.kde.ActivityManager.ResourcesLinking.\"$1\" string:org.kde.plasma.favorites.applications \"string:$2\" string::global >/dev/null 2>&1\n";
+                    stream << "}\n";
+                    stream << "if [ -n \"$favorites\" ]; then\n";
+                    stream << "    python3 -c 'import os, sqlite3\n"
+                              "path = os.path.expanduser(\"~/.local/share/kactivitymanagerd/resources/database\")\n"
+                              "for (resource,) in sqlite3.connect(\"file:\" + path + \"?mode=ro\", uri=True).execute("
+                              "\"select targettedResource from ResourceLink where initiatingAgent = ? and usedActivity = ?\", "
+                              "(\"org.kde.plasma.favorites.applications\", \":global\")):\n"
+                              "    print(resource)' 2>/dev/null | while read -r resource; do\n";
+                    stream << "        favorite UnlinkResourceFromActivity \"$resource\"\n";
+                    stream << "    done\n";
+                    stream << "    set -- " << quoteAll(start) << "\n";
+                    stream << "    for id do\n";
+                    stream << "        [ -n \"$(entry \"$id\")\" ] && favorite LinkResourceToActivity \"applications:$id.desktop\"\n";
+                    stream << "    done\n";
+                    stream << "fi\n";
+                }
             }
             stream << "rm -f \"$HOME/.config/autostart/blossomos-switch.desktop\"\n";
             stream << "rm -rf \"$dir\"\n";
