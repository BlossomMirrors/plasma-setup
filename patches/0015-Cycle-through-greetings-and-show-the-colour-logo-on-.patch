From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: koyu <me@koyu.space>
Date: Mon, 26 Oct 2026 16:30:01 +0100
Subject: [PATCH 15/18] Cycle through greetings and show the colour logo on the
 start page

Instead of "Welcome to BlossomOS", the start page fades through
"Welcome" in 20 languages, starting with the system language. The
BlossomOS mark and name in the bottom left become the colour logo with
the name beside it, in a light and a dark variant.
---
 po/de/org.kde.plasmasetup.po                 |  5 +-
 src/CMakeLists.txt                           |  3 +-
 src/assets/blossomos-logo-side-text-dark.svg | 35 ++++++++++
 src/assets/blossomos-logo-side-text.svg      | 35 ++++++++++
 src/assets/blossomos-symbolic.svg            |  8 ---
 src/qml/LandingComponent.qml                 | 71 ++++++++++++++------
 6 files changed, 123 insertions(+), 34 deletions(-)
 create mode 100644 src/assets/blossomos-logo-side-text-dark.svg
 create mode 100644 src/assets/blossomos-logo-side-text.svg
 delete mode 100644 src/assets/blossomos-symbolic.svg

diff --git a/po/de/org.kde.plasmasetup.po b/po/de/org.kde.plasmasetup.po
index f1f07ae..481605e 100644
--- a/po/de/org.kde.plasmasetup.po
+++ b/po/de/org.kde.plasmasetup.po
@@ -358,9 +358,8 @@ msgstr "Willkommen bei<br/><b>Plasma Desktop</b>"
 
 #: src/qml/LandingComponent.qml
 #, kde-format
-msgctxt "%1 is the distro name"
-msgid "Welcome to<br/><b>%1</b>"
-msgstr "Willkommen bei<br/><b>%1</b>"
+msgid "Welcome"
+msgstr "Willkommen"
 
 #: src/qml/LandingComponent.qml:140
 #, kde-format
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 6246f8f..4068949 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -50,7 +50,8 @@ qt_target_qml_sources(plasma-setup
         qml/BlossomWindow.qml
     RESOURCES
         assets/bluenoise.png
-        assets/blossomos-symbolic.svg
+        assets/blossomos-logo-side-text.svg
+        assets/blossomos-logo-side-text-dark.svg
 )
 
 target_link_libraries(plasma-setup
