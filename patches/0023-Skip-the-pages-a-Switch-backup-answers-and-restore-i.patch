diff --git a/modules/switchutil/switchutil.cpp b/modules/switchutil/switchutil.cpp
index bfa43c5..a6a8d14 100644
--- a/modules/switchutil/switchutil.cpp
+++ b/modules/switchutil/switchutil.cpp
@@ -290,6 +290,16 @@ bool SwitchUtil::providesBrowser() const
     return m_state == Done && !defaultBrowser().isEmpty();
 }
 
+bool SwitchUtil::installedBySwitch() const
+{
+    return QFile::exists(u"/var/lib/blossomos-switch/installed"_s);
+}
+
+bool SwitchUtil::providesLook() const
+{
+    return m_state == Done && (profileDark() != -1 || !profileAccent().isEmpty() || !wallpaper().isEmpty());
+}
+
 QVariantList SwitchUtil::steps() const
 {
     QString copyState = u"waiting"_s;
