diff --git a/src/auth/authhelper.cpp b/src/auth/authhelper.cpp
index 6867415..bda5383 100644
--- a/src/auth/authhelper.cpp
+++ b/src/auth/authhelper.cpp
@@ -1614,6 +1614,27 @@ ActionReply PlasmaSetupAuthHelper::finishSwitchUser(const SwitchUser &user)
             }
         }
 
+        if (desktopLayout.contains(QStringLiteral("trash"))) {
+            QDir().mkpath(desktop);
+            KConfig trashEntry(desktop + QStringLiteral("/trash.desktop"), KConfig::SimpleConfig);
+            KConfigGroup trashGroup = trashEntry.group(QStringLiteral("Desktop Entry"));
+            trashGroup.writeEntry("Type", QStringLiteral("Link"));
+            trashGroup.writeEntry("Name", QStringLiteral("Trash"));
+            trashGroup.writeEntry("Name[de]", QStringLiteral("Papierkorb"));
+            trashGroup.writeEntry("Icon", QStringLiteral("user-trash-full"));
+            trashGroup.writeEntry("EmptyIcon", QStringLiteral("user-trash"));
+            trashGroup.writeEntry("URL", QStringLiteral("trash:/"));
+            trashEntry.sync();
+            const QJsonObject trash = desktopLayout.value(QStringLiteral("trash")).toObject();
+            if (trash.contains(QStringLiteral("x")) && trash.contains(QStringLiteral("y"))) {
+                QJsonArray items = desktopLayout.value(QStringLiteral("items")).toArray();
+                items.append(QJsonObject{{QStringLiteral("path"), QStringLiteral("trash.desktop")},
+                                         {QStringLiteral("x"), trash.value(QStringLiteral("x"))},
+                                         {QStringLiteral("y"), trash.value(QStringLiteral("y"))}});
+                desktopLayout.insert(QStringLiteral("items"), items);
+            }
+        }
+
         // Match positions to the actual names chosen above, including directory links
         // and collision suffixes. Never let a manifest path escape the desktop.
         if (!desktopLayout.isEmpty()) {
diff --git a/src/auth/switchdesktop.js b/src/auth/switchdesktop.js
index 57b96b4..e339218 100644
--- a/src/auth/switchdesktop.js
+++ b/src/auth/switchdesktop.js
@@ -45,6 +45,14 @@ function switchApplyDesktopLayout(layout) {
         desktop.writeConfig("arrangement", 1); // top to bottom, then the next column
         desktop.writeConfig("alignment", 0);
         desktop.writeConfig("locked", false); // auto-arrange does not mean immovable icons
+        if (typeof layout.iconSize === "number" && isFinite(layout.iconSize) && layout.iconSize > 0) {
+            var sizes = [16, 22, 32, 48, 64, 128];
+            var nearest = 0;
+            sizes.forEach(function (size, index) {
+                if (Math.abs(size - layout.iconSize) < Math.abs(sizes[nearest] - layout.iconSize)) nearest = index;
+            });
+            desktop.writeConfig("iconSize", nearest);
+        }
         if (layout.autoArrange) {
             desktop.writeConfig("sortMode", 0); // FolderModel: name = 0, manual = -1
             return;
