 11 files changed, 85 insertions(+), 1 deletion(-)

diff --git a/modules/appearance/contents/ui/main.qml b/modules/appearance/contents/ui/main.qml
index 6389f99..5efae23 100644
--- a/modules/appearance/contents/ui/main.qml
+++ b/modules/appearance/contents/ui/main.qml
@@ -41,6 +41,14 @@ PlasmaSetupComponents.SetupModule {
     readonly property bool hasWallpapers: wallpaperModel.length > 1
     property bool prefilled: false
 
+    function skipPage(): bool {
+        if (!Switch.SwitchUtil.providesLook) {
+            return false;
+        }
+        onPageActivated();
+        return true;
+    }
+
     function onPageActivated(): void {
         if (prefilled || Switch.SwitchUtil.state !== Switch.SwitchUtil.Done) {
             return;
diff --git a/modules/hostname/contents/ui/main.qml b/modules/hostname/contents/ui/main.qml
index 075c6ab..35f24c0 100644
--- a/modules/hostname/contents/ui/main.qml
+++ b/modules/hostname/contents/ui/main.qml
@@ -48,6 +48,18 @@ PlasmaSetupComponents.SetupModule {
 
     property bool prefilled: false
 
+    function skipPage(): bool {
+        if (Switch.SwitchUtil.state !== Switch.SwitchUtil.Done || Switch.SwitchUtil.profileHostname === "") {
+            return false;
+        }
+        if (!prefilled) {
+            prefilled = true;
+            hostnameField.text = Switch.SwitchUtil.profileHostname;
+            HostnameUtil.hostname = Switch.SwitchUtil.profileHostname;
+        }
+        return true;
+    }
+
     function onPageActivated() {
         if (!prefilled && !hasEdited && Switch.SwitchUtil.profileHostname !== "") {
             prefilled = true;
