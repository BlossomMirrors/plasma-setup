diff --git a/modules/encryptionutil/encryptionutil.cpp b/modules/encryptionutil/encryptionutil.cpp
new file mode 100644
index 0000000..1ca40bd
--- /dev/null
+++ b/modules/encryptionutil/encryptionutil.cpp
@@ -0,0 +1,136 @@
+// SPDX-FileCopyrightText: 2026 Leonie Ain <me@koyu.space>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "encryptionutil.h"
+
+#include <KAuth/Action>
+#include <KAuth/ExecuteJob>
+
+#include <QFile>
+#include <QProcess>
+#include <QTimer>
+
+using namespace Qt::StringLiterals;
+
+namespace
+{
+constexpr auto HELPER_ID = "org.kde.plasmasetup";
+
+// EFI global variable, attributes then one byte: 1 when on
+constexpr auto SECURE_BOOT_EFIVAR = "/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d0-aa0d-00e098032b8c";
+
+bool preview()
+{
+    return qEnvironmentVariableIntValue("PLASMA_SETUP_PREVIEW") == 1;
+}
+
+bool secureBootEnabled()
+{
+    QFile efivar{QLatin1String(SECURE_BOOT_EFIVAR)};
+    if (!efivar.open(QIODevice::ReadOnly)) {
+        return false;
+    }
+    const QByteArray data = efivar.readAll();
+    return data.size() >= 5 && data.at(4) == 1;
+}
+}
+
+EncryptionUtil::EncryptionUtil(QObject *parent)
+    : QObject{parent}
+{
+    if (preview()) {
+        // Offered on any machine, enrolling is pretended
+        m_offered = true;
+        return;
+    }
+
+    if (secureBootEnabled()) {
+        checkTpm();
+    }
+}
+
+bool EncryptionUtil::offered() const
+{
+    return m_offered;
+}
+
+EncryptionUtil::State EncryptionUtil::state() const
+{
+    return m_state;
+}
+
+void EncryptionUtil::checkTpm()
+{
+    // Firmware, driver, systemd and the TPM libraries, all there
+    auto *process = new QProcess(this);
+    connect(process, &QProcess::finished, this, [this, process](int exitCode, QProcess::ExitStatus exitStatus) {
+        process->deleteLater();
+        if (exitStatus == QProcess::NormalExit && exitCode == 0) {
+            checkDevices();
+        }
+    });
+    connect(process, &QProcess::errorOccurred, process, &QObject::deleteLater);
+    process->start(u"systemd-analyze"_s, {u"has-tpm2"_s, u"-q"_s});
+}
+
+void EncryptionUtil::checkDevices()
+{
+    // Only root can read /etc/crypttab and the LUKS headers
+    KAuth::Action action(u"org.kde.plasmasetup.tpmunlockdevices"_s);
+    action.setHelperId(QLatin1String(HELPER_ID));
+    KAuth::ExecuteJob *job = action.execute();
+    connect(job, &KJob::result, this, [this, job] {
+        if (job->error()) {
+            qWarning() << "Failed to list the disks the TPM could unlock:" << job->errorString();
+            return;
+        }
+        if (!job->data().value(u"devices"_s).toStringList().isEmpty()) {
+            m_offered = true;
+            Q_EMIT offeredChanged();
+        }
+    });
+    job->start();
+}
+
+void EncryptionUtil::enroll(const QString &passphrase)
+{
+    if (m_state == Enrolling || m_state == Enrolled || passphrase.isEmpty()) {
+        return;
+    }
+    setState(Enrolling);
+
+    if (preview()) {
+        // Pretend, the preview changes nothing on the system
+        QTimer::singleShot(2000, this, [this] {
+            setState(Enrolled);
+        });
+        return;
+    }
+
+    KAuth::Action action(u"org.kde.plasmasetup.enrolltpmunlock"_s);
+    action.setHelperId(QLatin1String(HELPER_ID));
+    action.setArguments({{u"passphrase"_s, passphrase}});
+    KAuth::ExecuteJob *job = action.execute();
+    connect(job, &KJob::result, this, [this, job] {
+        if (job->error()) {
+            qWarning() << "Failed to let the TPM unlock the disks:" << job->errorString();
+            setState(Failed);
+        } else if (job->data().value(u"wrongPassphrase"_s).toBool()) {
+            setState(WrongPassphrase);
+        } else {
+            setState(Enrolled);
+        }
+    });
+    job->start();
+}
+
+void EncryptionUtil::setState(State state)
+{
+    if (m_state == state) {
+        return;
+    }
+    m_state = state;
+    Q_EMIT stateChanged();
+}
+
+#include "moc_encryptionutil.cpp"
diff --git a/modules/encryptionutil/encryptionutil.h b/modules/encryptionutil/encryptionutil.h
new file mode 100644
index 0000000..2f714ea
--- /dev/null
+++ b/modules/encryptionutil/encryptionutil.h
@@ -0,0 +1,61 @@
+// SPDX-FileCopyrightText: 2026 Leonie Ain <me@koyu.space>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <QObject>
+#include <qqmlintegration.h>
+
+/*!
+ * Lets the TPM unlock the encrypted disk on start, like BlossomOS'
+ * `ujust tpm enroll`: an extra unlock method bound to PCR 7, the passphrase
+ * keeps working.
+ *
+ * Offered when there is an encrypted disk without a TPM unlock yet, a TPM 2.0
+ * systemd can use, and Secure Boot is on. Without Secure Boot PCR 7 would
+ * unseal the disk for whatever boots.
+ */
+class EncryptionUtil : public QObject
+{
+    Q_OBJECT
+    QML_ELEMENT
+    QML_SINGLETON
+
+    /*!
+     * Whether to offer it. Finds out right away, false until then.
+     */
+    Q_PROPERTY(bool offered READ offered NOTIFY offeredChanged)
+    Q_PROPERTY(State state READ state NOTIFY stateChanged)
+
+public:
+    enum State {
+        Idle,
+        Enrolling,
+        Enrolled,
+        WrongPassphrase,
+        Failed,
+    };
+    Q_ENUM(State)
+
+    explicit EncryptionUtil(QObject *parent = nullptr);
+
+    bool offered() const;
+    State state() const;
+
+    /*!
+     * Lets the TPM unlock the disks encrypted with the passphrase.
+     */
+    Q_INVOKABLE void enroll(const QString &passphrase);
+
+Q_SIGNALS:
+    void offeredChanged();
+    void stateChanged();
+
+private:
+    void checkTpm();
+    void checkDevices();
+    void setState(State state);
+
+    bool m_offered = false;
+    State m_state = Idle;
+};
