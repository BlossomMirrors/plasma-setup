diff --git a/modules/encryption/contents/ui/main.qml b/modules/encryption/contents/ui/main.qml
new file mode 100644
index 0000000..232c61f
--- /dev/null
+++ b/modules/encryption/contents/ui/main.qml
@@ -0,0 +1,184 @@
+// SPDX-FileCopyrightText: 2026 Leonie Ain <me@koyu.space>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Layouts
+
+import org.kde.kirigami as Kirigami
+import org.kde.plasmasetup.encryptionutil as Encryption
+
+import org.kde.plasmasetup.components as PlasmaSetupComponents
+
+/**
+* @brief Module that lets the TPM unlock the encrypted disk
+*
+* Offers to unlock the encrypted disk on start, with the TPM, when it can
+* and Secure Boot is on. Worded as a convenience, without TPMs or PCRs. Asks
+* for the passphrase to set it up. Setup goes on once it is set up, or with
+* the passphrase asked for on start.
+*/
+PlasmaSetupComponents.SetupModule {
+    id: root
+
+    readonly property int enrollState: Encryption.EncryptionUtil.state
+    readonly property bool enrolled: enrollState === Encryption.EncryptionUtil.Enrolled
+    readonly property bool enrolling: enrollState === Encryption.EncryptionUtil.Enrolling
+
+    nextEnabled: !enrolling && (askButton.checked || enrolled)
+    // No leaving while the TPM is being set up
+    backEnabled: !enrolling
+
+    function skipPage(): bool {
+        return !Encryption.EncryptionUtil.offered;
+    }
+
+    function onPageActivated(): void {
+        if (automaticButton.checked && !enrolled) {
+            passphraseField.forceActiveFocus();
+        }
+    }
+
+    function enroll(): void {
+        if (passphraseField.text !== "") {
+            Encryption.EncryptionUtil.enroll(passphraseField.text);
+        }
+    }
+
+    Connections {
+        target: Encryption.EncryptionUtil
+
+        function onStateChanged(): void {
+            if (root.enrolled) {
+                passphraseField.clear();
+            } else if (root.enrollState === Encryption.EncryptionUtil.WrongPassphrase) {
+                passphraseField.selectAll();
+                passphraseField.forceActiveFocus();
+            }
+        }
+    }
+
+    contentItem: ColumnLayout {
+        spacing: Kirigami.Units.largeSpacing
+
+        Item {
+            Layout.fillHeight: true
+        }
+
+        // Like the outcome on the updates page: the icon on a circle of its
+        // colour at 18%
+        Rectangle {
+            id: badge
+
+            readonly property color tint: root.enrolled ? Kirigami.Theme.positiveTextColor : Kirigami.Theme.textColor
+
+            Layout.alignment: Qt.AlignHCenter
+            Layout.preferredWidth: 56
+            Layout.preferredHeight: 56
+            radius: width / 2
+            color: root.enrolled ? Qt.alpha(tint, 0.18) : "transparent"
+
+            Kirigami.Icon {
+                anchors.centerIn: parent
+                width: 32
+                height: 32
+                source: root.enrolled ? "emblem-ok-symbolic" : "security-high-symbolic"
+                isMask: true
+                roundToIconSize: false
+                color: badge.tint
+            }
+        }
+
+        Kirigami.Heading {
+            Layout.fillWidth: true
+            horizontalAlignment: Text.AlignHCenter
+            wrapMode: Text.Wrap
+            level: 2
+            text: root.enrolled ? i18n("Disk Unlocks Automatically") : i18n("Unlock Disk Automatically?")
+        }
+
+        Label {
+            Layout.fillWidth: true
+            Layout.leftMargin: Kirigami.Units.gridUnit
+            Layout.rightMargin: Kirigami.Units.gridUnit
+            horizontalAlignment: Text.AlignHCenter
+            wrapMode: Text.Wrap
+            text: root.enrolled
+                ? i18n("Your computer now unlocks your disk by itself when it starts. Once in a while it may still ask for your passphrase, so keep it somewhere safe.")
+                : i18n("Your computer supports unlocking your disk automatically. Would you like to turn it on? Then you don't have to type your passphrase every time it starts.")
+        }
+
+        ColumnLayout {
+            Layout.alignment: Qt.AlignHCenter
+            Layout.topMargin: Kirigami.Units.largeSpacing
+            visible: !root.enrolled
+            enabled: !root.enrolling
+            spacing: Kirigami.Units.smallSpacing
+
+            RadioButton {
+                id: automaticButton
+                checked: true
+                text: i18n("Unlock disk automatically")
+                onToggled: passphraseField.forceActiveFocus()
+            }
+
+            RadioButton {
+                id: askButton
+                text: i18n("Ask for the passphrase every time")
+            }
+        }
+
+        RowLayout {
+            Layout.alignment: Qt.AlignHCenter
+            Layout.maximumWidth: Kirigami.Units.gridUnit * 20
+            visible: automaticButton.checked && !root.enrolled
+            enabled: !root.enrolling
+            spacing: Kirigami.Units.smallSpacing
+
+            Kirigami.PasswordField {
+                id: passphraseField
+                Layout.fillWidth: true
+                placeholderText: i18nc("@info:placeholder", "Encryption passphrase")
+                onAccepted: root.enroll()
+            }
+
+            Button {
+                text: i18nc("@action:button", "Turn On")
+                enabled: passphraseField.text !== ""
+                onClicked: root.enroll()
+            }
+        }
+
+        BusyIndicator {
+            Layout.alignment: Qt.AlignHCenter
+            visible: root.enrolling
+            running: visible
+        }
+
+        Kirigami.InlineMessage {
+            Layout.fillWidth: true
+            Layout.maximumWidth: Kirigami.Units.gridUnit * 20
+            Layout.alignment: Qt.AlignHCenter
+            visible: automaticButton.checked && (root.enrollState === Encryption.EncryptionUtil.WrongPassphrase || root.enrollState === Encryption.EncryptionUtil.Failed)
+            type: root.enrollState === Encryption.EncryptionUtil.WrongPassphrase ? Kirigami.MessageType.Warning : Kirigami.MessageType.Error
+            text: root.enrollState === Encryption.EncryptionUtil.WrongPassphrase
+                ? i18n("That's not the right passphrase.")
+                : i18n("This didn't work on your computer. You can keep using your passphrase.")
+        }
+
+        Label {
+            Layout.fillWidth: true
+            horizontalAlignment: Text.AlignHCenter
+            wrapMode: Text.Wrap
+            visible: automaticButton.checked && root.enrollState === Encryption.EncryptionUtil.Idle
+            color: Kirigami.Theme.neutralTextColor
+            text: i18n("Enter your passphrase once to turn this on.")
+        }
+
+        Item {
+            Layout.fillHeight: true
+        }
+    }
+}
