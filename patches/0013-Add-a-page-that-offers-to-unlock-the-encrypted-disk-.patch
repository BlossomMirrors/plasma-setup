index a0fae89..90a77b5 100644
--- a/src/auth/authhelper.cpp
+++ b/src/auth/authhelper.cpp
@@ -15,8 +15,11 @@
 #include <QDir>
 #include <QFile>
 #include <QFileInfo>
+#include <QJsonDocument>
+#include <QJsonObject>
 #include <QProcess>
 #include <QRegularExpression>
+#include <QScopeGuard>
 #include <QStandardPaths>
 #include <QUrl>
 #include <QtDBus/QDBusInterface>
@@ -163,6 +166,74 @@ static QString validateGroupName(const QString &group)
     return QString();
 }
 
+/**
+ * The encrypted disks the TPM could unlock on start, like BlossomOS' `ujust tpm enroll`
+ * finds them: the devices in /etc/crypttab, if they are LUKS2 and have no TPM unlock yet.
+ *
+ * @return The device paths, under /dev.
+ */
+static QStringList tpmUnlockDevices()
+{
+    QStringList devices;
+
+    QFile crypttab(QStringLiteral("/etc/crypttab"));
+    const QString cryptsetupBinary = findExecutable(QStringLiteral("cryptsetup"));
+    if (cryptsetupBinary.isEmpty() || !crypttab.open(QIODevice::ReadOnly | QIODevice::Text)) {
+        return devices;
+    }
+
+    static const QRegularExpression whitespace(QStringLiteral("\\s+"));
+    static const QList<std::pair<QString, QString>> tags = {
+        {QStringLiteral("UUID="), QStringLiteral("/dev/disk/by-uuid/")},
+        {QStringLiteral("PARTUUID="), QStringLiteral("/dev/disk/by-partuuid/")},
+        {QStringLiteral("LABEL="), QStringLiteral("/dev/disk/by-label/")},
+        {QStringLiteral("PARTLABEL="), QStringLiteral("/dev/disk/by-partlabel/")},
+    };
+
+    while (!crypttab.atEnd()) {
+        const QString line = QString::fromUtf8(crypttab.readLine()).trimmed();
+        if (line.isEmpty() || line.startsWith(QLatin1Char('#'))) {
+            continue;
+        }
+
+        // name, device, key file, options
+        const QStringList fields = line.split(whitespace);
+        if (fields.size() < 2) {
+            continue;
+        }
+
+        QString source = fields.at(1);
+        for (const auto &[tag, directory] : tags) {
+            if (source.startsWith(tag)) {
+                source = directory + source.mid(tag.size());
+                break;
+            }
+        }
+
+        const QString device = QFileInfo(source).canonicalFilePath();
+        if (!device.startsWith(QLatin1String("/dev/")) || devices.contains(device)) {
+            continue;
+        }
+
+        // Only LUKS2 can hold the TPM token, and LUKS1 fails to dump as JSON
+        QProcess dumpProcess;
+        dumpProcess.start(cryptsetupBinary, {QStringLiteral("luksDump"), QStringLiteral("--dump-json-metadata"), device});
+        if (!dumpProcess.waitForFinished() || dumpProcess.exitStatus() != QProcess::NormalExit || dumpProcess.exitCode() != 0) {
+            continue;
+        }
+
+        const QJsonObject tokens = QJsonDocument::fromJson(dumpProcess.readAllStandardOutput()).object().value(QStringLiteral("tokens")).toObject();
+        const bool hasTpmUnlock = std::any_of(tokens.begin(), tokens.end(), [](const QJsonValue &token) {
+            return token.toObject().value(QStringLiteral("type")).toString() == QLatin1String("systemd-tpm2");
+        });
+        if (!hasTpmUnlock) {
+            devices << device;
+        }
+    }
+
+    return devices;
+}
