+ActionReply PlasmaSetupAuthHelper::enrolltpmunlock(const QVariantMap &args)
+{
+    // The passphrase is handled as a QByteArray to clear it after use, like the password in createuser()
+    if (!args.value(QStringLiteral("passphrase")).canConvert<QByteArray>()) {
+        return makeErrorReply(QStringLiteral("Passphrase argument is missing or invalid."));
+    }
+    QByteArray passphrase = args.value(QStringLiteral("passphrase")).toByteArray();
+    const auto clearPassphrase = qScopeGuard([&passphrase] {
+        std::fill(passphrase.begin(), passphrase.end(), '\0');
+    });
+
+    if (passphrase.isEmpty()) {
+        return makeErrorReply(QStringLiteral("Passphrase cannot be empty."));
+    }
+
+    // Never what the caller names, only the disks that are there to enroll
+    const QStringList devices = tpmUnlockDevices();
+    if (devices.isEmpty()) {
+        return makeErrorReply(QStringLiteral("There is no encrypted disk to unlock automatically."));
+    }
+
+    const QString cryptsetupBinary = findExecutable(QStringLiteral("cryptsetup"));
+    const QString cryptenrollBinary = findExecutable(QStringLiteral("systemd-cryptenroll"));
+    if (cryptsetupBinary.isEmpty() || cryptenrollBinary.isEmpty()) {
+        return makeErrorReply(QStringLiteral("Could not locate cryptsetup or systemd-cryptenroll executable."));
+    }
+
+    // Check the passphrase on every disk first: systemd-cryptenroll would ask
+    // for another one when it is wrong, with nobody there to answer
+    for (const QString &device : devices) {
+        QProcess testProcess;
+        testProcess.start(cryptsetupBinary, {QStringLiteral("open"), QStringLiteral("--test-passphrase"), QStringLiteral("--key-file=-"), device});
+        if (!testProcess.waitForStarted()) {
+            return makeErrorReply(QStringLiteral("Failed to start cryptsetup: ") + testProcess.errorString());
+        }
+
+        // A key file from stdin is taken as is, without a trailing newline
+        testProcess.write(passphrase);
+        testProcess.closeWriteChannel();
+
+        if (!testProcess.waitForFinished()) {
+            testProcess.kill();
+            testProcess.waitForFinished();
+            return makeErrorReply(QStringLiteral("cryptsetup timed out."));
+        }
+
+        if (testProcess.exitStatus() != QProcess::NormalExit || testProcess.exitCode() != 0) {
+            ActionReply reply = ActionReply::SuccessReply();
+            reply.setData({{QStringLiteral("wrongPassphrase"), true}});
+            return reply;
+        }
+    }
+
+    // What `ujust tpm enroll` runs: bound to PCR 7, the Secure Boot state, which BlossomOS Recovery extends so its
+    // boots can't unseal the disks. systemd-cryptenroll takes the passphrase from $PASSWORD, which only root can read
+    QProcessEnvironment environment = QProcessEnvironment::systemEnvironment();
+    environment.insert(QStringLiteral("PASSWORD"), QString::fromUtf8(passphrase));
+
+    for (const QString &device : devices) {
+        QProcess enrollProcess;
+        enrollProcess.setProcessEnvironment(environment);
+        enrollProcess.start(cryptenrollBinary, {QStringLiteral("--tpm2-device=auto"), device});
+
+        if (!enrollProcess.waitForStarted()) {
+            return makeErrorReply(QStringLiteral("Failed to start systemd-cryptenroll: ") + enrollProcess.errorString());
+        }
+
+        if (!enrollProcess.waitForFinished(120000)) {
+            enrollProcess.kill();
+            enrollProcess.waitForFinished();
+            return makeErrorReply(QStringLiteral("systemd-cryptenroll timed out for ") + device);
+        }
+
+        if (enrollProcess.exitStatus() != QProcess::NormalExit || enrollProcess.exitCode() != 0) {
+            const QString stderrOutput = QString::fromLocal8Bit(enrollProcess.readAllStandardError()).trimmed();
+            return makeErrorReply(
+                QStringLiteral("systemd-cryptenroll failed for %1 with exit code %2: %3").arg(device).arg(enrollProcess.exitCode()).arg(stderrOutput));
+        }
+    }
+
+    ActionReply reply = ActionReply::SuccessReply();
+    reply.setData({{QStringLiteral("devices"), devices}});
+    return reply;
+}
