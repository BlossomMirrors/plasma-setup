+// SPDX-FileCopyrightText: 2026 Leonie Ain <me@koyu.space>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Layouts
+
+import org.kde.kirigami as Kirigami
+import org.kde.plasmasetup
+import org.kde.plasmasetup.browserutil as Browser
+
+import org.kde.plasmasetup.components as PlasmaSetupComponents
+
+/**
+* @brief Module for choosing web browsers
+*
+* Offers the browsers on the Forge browser list, the one the Arc Store
+* shows. The chosen browser is installed right away and becomes the new
+* user's default, then the others are removed. Setup needs one. Skipped
+* without internet.
+*/
+PlasmaSetupComponents.SetupModule {
+    id: root
+
+    // Setup needs a browser; only when the list couldn't load there is
+    // nothing to pick from
+    nextEnabled: !Browser.BrowserUtil.loading && !Browser.BrowserUtil.busy && (Browser.BrowserUtil.hasBrowser || list.count === 0)
+
+    function skipPage(): bool {
+        return !InitialStartUtil.online();
+    }
+
+    function onPageActivated(): void {
+        Browser.BrowserUtil.start();
+    }
+
+    contentItem: ColumnLayout {
+        spacing: Kirigami.Units.smallSpacing
+
+        Label {
+            Layout.leftMargin: Kirigami.Units.gridUnit
+            Layout.rightMargin: Kirigami.Units.gridUnit
+            Layout.bottomMargin: Kirigami.Units.gridUnit
+            Layout.fillWidth: true
+
+            wrapMode: Text.Wrap
+            horizontalAlignment: Text.AlignHCenter
+            text: i18n("Choose the web browser you want. You can install more later in the Arc Store.")
+        }
+
+        BusyIndicator {
+            Layout.alignment: Qt.AlignHCenter
+            visible: Browser.BrowserUtil.loading
+            running: visible
+        }
+
+        Kirigami.InlineMessage {
+            Layout.fillWidth: true
+            visible: Browser.BrowserUtil.error !== ""
+            type: Kirigami.MessageType.Warning
+            text: Browser.BrowserUtil.error
+        }
+
+        ScrollView {
+            Layout.fillWidth: true
+            Layout.fillHeight: true
+            visible: !Browser.BrowserUtil.loading && list.count > 0
+
+            Component.onCompleted: {
+                if (background) {
+                    background.visible = true;
+                }
+            }
+
+            ListView {
+                id: list
+                clip: true
+                model: Browser.BrowserUtil.browsers
+
+                delegate: ItemDelegate {
+                    id: delegate
+
+                    required property var modelData
+
+                    width: ListView.view.width
+                    text: modelData.name
+                    // The chosen one gets installed, the others removed
+                    onClicked: {
+                        if (!modelData.working) {
+                            Browser.BrowserUtil.choose(modelData.id);
+                        }
+                    }
+
+                    Accessible.role: Accessible.RadioButton
+                    Accessible.checked: radio.checked
+
+                    contentItem: RowLayout {
+                        spacing: Kirigami.Units.largeSpacing
+
+                        RadioButton {
+                            id: radio
+                            checked: delegate.modelData.chosen
+                            enabled: !delegate.modelData.working
+                            onToggled: Browser.BrowserUtil.choose(delegate.modelData.id)
+                        }
+
+                        Image {
+                            Layout.preferredWidth: Kirigami.Units.iconSizes.medium
+                            Layout.preferredHeight: Kirigami.Units.iconSizes.medium
+                            source: delegate.modelData.icon
+                            sourceSize.width: width * Screen.devicePixelRatio
+                            sourceSize.height: height * Screen.devicePixelRatio
+                            fillMode: Image.PreserveAspectFit
+                            asynchronous: true
+                        }
+
+                        Label {
+                            Layout.fillWidth: true
+                            text: delegate.text
+                            elide: Text.ElideRight
+                        }
+
+                        ProgressBar {
+                            Layout.preferredWidth: Kirigami.Units.gridUnit * 5
+                            visible: delegate.modelData.working
+                            from: 0
+                            to: 100
+                            value: Browser.BrowserUtil.percent
+                            indeterminate: Browser.BrowserUtil.percent === 0
+                        }
+
+                        Label {
+                            visible: text !== ""
+                            opacity: 0.7
+                            text: {
+                                const browser = delegate.modelData;
+                                if (browser.working) {
+                                    return browser.installed ? i18n("Removing…") : "";
+                                } else if (browser.pending) {
+                                    return browser.wanted ? i18n("Waiting…") : i18n("Will be removed");
+                                }
+                                return browser.installed ? i18n("Installed") : "";
+                            }
+                        }
+                    }
+                }
+            }
+        }
+
+        Label {
+            Layout.fillWidth: true
+            Layout.topMargin: Kirigami.Units.largeSpacing
+            horizontalAlignment: Text.AlignHCenter
+            wrapMode: Text.Wrap
+            visible: list.count > 0 && !Browser.BrowserUtil.hasBrowser
+            color: Kirigami.Theme.neutralTextColor
+            text: i18n("Choose a browser to continue.")
+        }
+    }
+}
