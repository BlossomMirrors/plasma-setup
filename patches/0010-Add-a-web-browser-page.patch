+// SPDX-FileCopyrightText: 2026 Leonie Ain <me@koyu.space>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <QObject>
+#include <QStringList>
+#include <QVariantList>
+#include <qqmlintegration.h>
+
+class QNetworkAccessManager;
+class QThread;
+typedef struct _GCancellable GCancellable;
+
+/*!
+ * The browsers on the Forge browser list (the one the Arc Store shows),
+ * installing the one chosen and removing the others. The chosen one is the
+ * new user's default.
+ *
+ * Browsers are Flatpaks and go into the system installation, the setup
+ * user's home doesn't survive setup. The default is kept in the setup user's
+ * plasma-setuprc, where the auth helper reads it for the new user.
+ */
+class BrowserUtil : public QObject
+{
+    Q_OBJECT
+    QML_ELEMENT
+    QML_SINGLETON
+
+    /*!
+     * One map per browser on the list: id, name, icon (URL), installed,
+     * chosen, wanted (to be installed), working (being installed or
+     * removed) and pending (waiting to be).
+     */
+    Q_PROPERTY(QVariantList browsers READ browsers NOTIFY browsersChanged)
+    Q_PROPERTY(bool loading READ loading NOTIFY loadingChanged)
+    /*!
+     * Why the list couldn't be loaded, or the last install failed.
+     */
+    Q_PROPERTY(QString error READ error NOTIFY errorChanged)
+    /*!
+     * Whether browsers are being installed or removed, or wait to be.
+     */
+    Q_PROPERTY(bool busy READ busy NOTIFY browsersChanged)
+    /*!
+     * Whether a browser is chosen, setup needs one.
+     */
+    Q_PROPERTY(bool hasBrowser READ hasBrowser NOTIFY browsersChanged)
+    /*!
+     * Progress of the running install or removal in percent.
+     */
+    Q_PROPERTY(int percent READ percent NOTIFY progressChanged)
+
+public:
+    explicit BrowserUtil(QObject *parent = nullptr);
+    ~BrowserUtil() override;
+
+    QVariantList browsers() const;
+    bool loading() const;
+    QString error() const;
+    bool busy() const;
+    bool hasBrowser() const;
+    int percent() const;
+
+    /*!
+     * Loads the list, once.
+     */
+    Q_INVOKABLE void start();
+
+    /*!
+     * Chooses the browser. It gets installed and becomes the default, then
+     * the other browsers on the list get removed, one after another.
+     */
+    Q_INVOKABLE void choose(const QString &id);
+
+Q_SIGNALS:
+    void browsersChanged();
+    void loadingChanged();
+    void errorChanged();
+    void progressChanged();
+
+private:
+    struct Browser {
+        QString id;
+        QString name;
+        QString icon;
+        bool installed = false;
+        bool wanted = false;
+    };
+
+    void setError(const QString &error);
+    void processNext();
+    void changeFinished(const QString &id, bool install, const QString &error);
+    void pickDefault();
+    void save() const;
+
+    QNetworkAccessManager *m_network = nullptr;
+    QList<Browser> m_browsers;
+    bool m_started = false;
+    bool m_loading = false;
+    QString m_error;
+    QString m_current;
+    int m_percent = 0;
+    QString m_chosen;
+    QString m_default;
+
+    QThread *m_worker = nullptr;
+    GCancellable *m_cancellable = nullptr;
+};
