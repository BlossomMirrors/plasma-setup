diff --git a/modules/browserutil/browserutil.cpp b/modules/browserutil/browserutil.cpp
new file mode 100644
index 0000000..a27b62c
--- /dev/null
+++ b/modules/browserutil/browserutil.cpp
@@ -0,0 +1,470 @@
+// SPDX-FileCopyrightText: 2026 Leonie Ain <me@koyu.space>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "browserutil.h"
+
+#include <KConfigGroup>
+#include <KLocalizedString>
+#include <KSharedConfig>
+
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QNetworkAccessManager>
+#include <QNetworkReply>
+#include <QNetworkRequest>
+#include <QPointer>
+#include <QThread>
+#include <QTimer>
+
+#include <flatpak.h>
+
+#include <algorithm>
+#include <functional>
+
+using namespace Qt::StringLiterals;
+
+namespace
+{
+// The list the Arc Store shows as "Browser"
+constexpr auto FORGE_BROWSER_LIST = "https://forge.arcstore.net/api/lists/browser";
+
+bool preview()
+{
+    return qEnvironmentVariableIntValue("PLASMA_SETUP_PREVIEW") == 1;
+}
+
+QString takeError(GError *error)
+{
+    const QString message = error ? QString::fromUtf8(error->message) : i18n("Unknown error");
+    g_clear_error(&error);
+    return message;
+}
+
+bool installedOnSystem(const QString &id)
+{
+    GError *error = nullptr;
+    FlatpakInstallation *installation = flatpak_installation_new_system(nullptr, &error);
+    if (!installation) {
+        g_clear_error(&error);
+        return false;
+    }
+    FlatpakInstalledRef *ref = flatpak_installation_get_current_installed_app(installation, id.toUtf8().constData(), nullptr, &error);
+    g_clear_error(&error);
+    const bool installed = ref != nullptr;
+    g_clear_object(&ref);
+    g_object_unref(installation);
+    return installed;
+}
+
+// The remote and full ref of the app, from the enabled system remotes by
+// priority, preferring the stable branch
+bool findRemoteRef(FlatpakInstallation *installation, const QString &id, GCancellable *cancellable, QByteArray &remote, QByteArray &ref, QString &errorMessage)
+{
+    GError *error = nullptr;
+    GPtrArray *remotes = flatpak_installation_list_remotes(installation, cancellable, &error);
+    if (!remotes) {
+        errorMessage = takeError(error);
+        return false;
+    }
+    QList<FlatpakRemote *> sorted;
+    for (guint i = 0; i < remotes->len; ++i) {
+        auto *candidate = FLATPAK_REMOTE(g_ptr_array_index(remotes, i));
+        if (!flatpak_remote_get_disabled(candidate)) {
+            sorted << candidate;
+        }
+    }
+    std::stable_sort(sorted.begin(), sorted.end(), [](FlatpakRemote *a, FlatpakRemote *b) {
+        return flatpak_remote_get_prio(a) > flatpak_remote_get_prio(b);
+    });
+
+    const QByteArray name = id.toUtf8();
+    const char *arch = flatpak_get_default_arch();
+    for (FlatpakRemote *candidate : std::as_const(sorted)) {
+        GPtrArray *refs = flatpak_installation_list_remote_refs_sync(installation, flatpak_remote_get_name(candidate), cancellable, &error);
+        if (!refs) {
+            g_clear_error(&error);
+            continue;
+        }
+        QByteArray found;
+        for (guint i = 0; i < refs->len; ++i) {
+            auto *candidateRef = FLATPAK_REF(g_ptr_array_index(refs, i));
+            if (flatpak_ref_get_kind(candidateRef) != FLATPAK_REF_KIND_APP || name != flatpak_ref_get_name(candidateRef)
+                || qstrcmp(arch, flatpak_ref_get_arch(candidateRef)) != 0) {
+                continue;
+            }
+            if (found.isEmpty() || qstrcmp(flatpak_ref_get_branch(candidateRef), "stable") == 0) {
+                char *formatted = flatpak_ref_format_ref(candidateRef);
+                found = formatted;
+                g_free(formatted);
+            }
+        }
+        g_ptr_array_unref(refs);
+        if (!found.isEmpty()) {
+            remote = flatpak_remote_get_name(candidate);
+            ref = found;
+            g_ptr_array_unref(remotes);
+            return true;
+        }
+    }
+    g_ptr_array_unref(remotes);
+    errorMessage = i18n("%1 isn't available from any software source.", id);
+    return false;
+}
+
+// Progress over all operations of a transaction (the app and the runtimes it
+// needs), handed to the Qt side
+struct TransactionProgress {
+    QPointer<QObject> receiver;
+    std::function<void(int)> report;
+    int operation = -1;
+    int operations = 1;
+};
+
+void onProgressChanged(FlatpakTransactionProgress *progress, gpointer data)
+{
+    auto *state = static_cast<TransactionProgress *>(data);
+    const int overall = (state->operation * 100 + flatpak_transaction_progress_get_progress(progress)) / state->operations;
+    QMetaObject::invokeMethod(state->receiver, [report = state->report, overall] {
+        report(overall);
+    });
+}
+
+void onNewOperation(FlatpakTransaction *transaction, FlatpakTransactionOperation *, FlatpakTransactionProgress *progress, gpointer data)
+{
+    auto *state = static_cast<TransactionProgress *>(data);
+    GList *operations = flatpak_transaction_get_operations(transaction);
+    state->operations = std::max(1u, g_list_length(operations));
+    g_list_free_full(operations, g_object_unref);
+    ++state->operation;
+    flatpak_transaction_progress_set_update_frequency(progress, 250);
+    g_signal_connect(progress, "changed", G_CALLBACK(onProgressChanged), data);
+}
+
+// Runs a transaction that add() fills, reporting its progress
+QString runTransaction(FlatpakInstallation *installation,
+                       GCancellable *cancellable,
+                       TransactionProgress *progress,
+                       const std::function<bool(FlatpakTransaction *, GError **)> &add)
+{
+    GError *error = nullptr;
+    FlatpakTransaction *transaction = flatpak_transaction_new_for_installation(installation, cancellable, &error);
+    if (!transaction) {
+        return takeError(error);
+    }
+    QString message;
+    flatpak_transaction_set_no_interaction(transaction, TRUE);
+    flatpak_transaction_add_default_dependency_sources(transaction);
+    g_signal_connect(transaction, "new-operation", G_CALLBACK(onNewOperation), progress);
+    if (!add(transaction, &error) || !flatpak_transaction_run(transaction, cancellable, &error)) {
+        message = takeError(error);
+    }
+    g_object_unref(transaction);
+    return message;
+}
+
+// Installs or removes the app, in the worker thread
+QString change(const QString &id, bool install, GCancellable *cancellable, TransactionProgress *progress)
+{
+    GError *error = nullptr;
+    FlatpakInstallation *installation = flatpak_installation_new_system(cancellable, &error);
+    if (!installation) {
+        return takeError(error);
+    }
+
+    QString message;
+    if (install) {
+        QByteArray remote;
+        QByteArray ref;
+        if (findRemoteRef(installation, id, cancellable, remote, ref, message)) {
+            message = runTransaction(installation, cancellable, progress, [&remote, &ref](FlatpakTransaction *transaction, GError **error) {
+                return flatpak_transaction_add_install(transaction, remote.constData(), ref.constData(), nullptr, error);
+            });
+        }
+    } else {
+        FlatpakInstalledRef *installed = flatpak_installation_get_current_installed_app(installation, id.toUtf8().constData(), cancellable, &error);
+        g_clear_error(&error);
+        // Already gone otherwise
+        if (installed) {
+            char *formatted = flatpak_ref_format_ref(FLATPAK_REF(installed));
+            const QByteArray ref = formatted;
+            g_free(formatted);
+            g_object_unref(installed);
+            message = runTransaction(installation, cancellable, progress, [&ref](FlatpakTransaction *transaction, GError **error) {
+                return flatpak_transaction_add_uninstall(transaction, ref.constData(), error);
+            });
+        }
+    }
+    g_object_unref(installation);
+    return message;
+}
+}
+
+BrowserUtil::BrowserUtil(QObject *parent)
+    : QObject{parent}
+    , m_network{new QNetworkAccessManager(this)}
+    , m_cancellable{g_cancellable_new()}
+{
+}
+
+BrowserUtil::~BrowserUtil()
+{
+    g_cancellable_cancel(m_cancellable);
+    if (m_worker) {
+        m_worker->wait();
+    }
+    g_object_unref(m_cancellable);
+}
+
+QVariantList BrowserUtil::browsers() const
+{
+    QVariantList list;
+    for (const Browser &browser : m_browsers) {
+        list << QVariantMap{
+            {u"id"_s, browser.id},
+            {u"name"_s, browser.name},
+            {u"icon"_s, browser.icon},
+            {u"installed"_s, browser.installed},
+            {u"chosen"_s, browser.id == m_chosen},
+            {u"wanted"_s, browser.wanted},
+            {u"working"_s, browser.id == m_current},
+            {u"pending"_s, browser.wanted != browser.installed && browser.id != m_current},
+        };
+    }
+    return list;
+}
+
+bool BrowserUtil::loading() const
+{
+    return m_loading;
+}
+
+QString BrowserUtil::error() const
+{
+    return m_error;
+}
+
+bool BrowserUtil::busy() const
+{
+    return !m_current.isEmpty() || std::any_of(m_browsers.cbegin(), m_browsers.cend(), [](const Browser &browser) {
+        return browser.wanted != browser.installed;
+    });
+}
+
+bool BrowserUtil::hasBrowser() const
+{
+    return !m_chosen.isEmpty();
+}
+
+int BrowserUtil::percent() const
+{
+    return m_percent;
+}
+
+void BrowserUtil::start()
+{
+    if (m_started) {
+        return;
+    }
+    m_started = true;
+    m_loading = true;
+    Q_EMIT loadingChanged();
+
+    QNetworkRequest request{QUrl(QLatin1String(FORGE_BROWSER_LIST))};
+    request.setTransferTimeout(15000);
+    QNetworkReply *reply = m_network->get(request);
+    connect(reply, &QNetworkReply::finished, this, [this, reply] {
+        reply->deleteLater();
+        m_loading = false;
+        if (reply->error() != QNetworkReply::NoError) {
+            // Try again when the page is shown again, maybe online by then
+            m_started = false;
+            setError(reply->errorString());
+            Q_EMIT loadingChanged();
+            return;
+        }
+        setError(QString());
+
+        const QJsonArray apps = QJsonDocument::fromJson(reply->readAll()).object().value("apps"_L1).toArray();
+        for (const QJsonValue &value : apps) {
+            const QJsonObject app = value.toObject();
+            Browser browser;
+            browser.id = app.value("ref"_L1).toString();
+            browser.name = app.value("name"_L1).toString();
+            browser.icon = app.value("icon_url"_L1).toString();
+            const bool known = std::any_of(m_browsers.cbegin(), m_browsers.cend(), [&browser](const Browser &other) {
+                return other.id == browser.id;
+            });
+            if (browser.id.isEmpty() || browser.name.isEmpty() || known) {
+                continue;
+            }
+            browser.installed = installedOnSystem(browser.id);
+            browser.wanted = browser.installed;
+            m_browsers << browser;
+        }
+        // Already settled when there is exactly one, otherwise the user picks
+        // which one stays
+        const auto installed = std::count_if(m_browsers.cbegin(), m_browsers.cend(), [](const Browser &browser) {
+            return browser.installed;
+        });
+        if (installed == 1) {
+            m_chosen = std::find_if(m_browsers.cbegin(), m_browsers.cend(), [](const Browser &browser) {
+                           return browser.installed;
+                       })->id;
+        }
+        pickDefault();
+        Q_EMIT browsersChanged();
+        Q_EMIT loadingChanged();
+    });
+}
+
+void BrowserUtil::choose(const QString &id)
+{
+    const bool known = std::any_of(m_browsers.cbegin(), m_browsers.cend(), [&id](const Browser &browser) {
+        return browser.id == id;
+    });
+    if (id == m_chosen || id == m_current || !known) {
+        return;
+    }
+    m_chosen = id;
+    for (Browser &browser : m_browsers) {
+        browser.wanted = browser.id == id;
+    }
+    pickDefault();
+    Q_EMIT browsersChanged();
+    processNext();
+}
+
+void BrowserUtil::setError(const QString &error)
+{
+    if (m_error == error) {
+        return;
+    }
+    m_error = error;
+    Q_EMIT errorChanged();
+}
+
+// Installs or removes the next browser that isn't how it was picked, one at
+// a time. The install goes first, so there is a browser left if it fails
+void BrowserUtil::processNext()
+{
+    if (!m_current.isEmpty()) {
+        return;
+    }
+    auto next = std::find_if(m_browsers.cbegin(), m_browsers.cend(), [](const Browser &browser) {
+        return browser.wanted && !browser.installed;
+    });
+    if (next == m_browsers.cend()) {
+        next = std::find_if(m_browsers.cbegin(), m_browsers.cend(), [](const Browser &browser) {
+            return browser.wanted != browser.installed;
+        });
+    }
+    if (next == m_browsers.cend()) {
+        return;
+    }
+    m_current = next->id;
+    m_percent = 0;
+    setError(QString());
+    Q_EMIT progressChanged();
+    Q_EMIT browsersChanged();
+
+    const QString id = m_current;
+    const bool install = next->wanted;
+    if (preview()) {
+        // Pretend, the preview changes nothing on the system
+        auto *timer = new QTimer(this);
+        timer->setInterval(install ? 80 : 20);
+        connect(timer, &QTimer::timeout, this, [this, timer, id, install] {
+            m_percent = std::min(100, m_percent + 2);
+            Q_EMIT progressChanged();
+            if (m_percent == 100) {
+                timer->deleteLater();
+                changeFinished(id, install, QString());
+            }
+        });
+        timer->start();
+        return;
+    }
+
+    auto *progress = new TransactionProgress{this, [this](int percent) {
+                                                 m_percent = std::clamp(percent, m_percent, 100);
+                                                 Q_EMIT progressChanged();
+                                             }};
+    GCancellable *cancellable = m_cancellable;
+    m_worker = QThread::create([this, id, install, cancellable, progress] {
+        const QString error = change(id, install, cancellable, progress);
+        QMetaObject::invokeMethod(this, [this, id, install, error] {
+            changeFinished(id, install, error);
+        });
+    });
+    connect(m_worker, &QThread::finished, m_worker, &QObject::deleteLater);
+    connect(m_worker, &QThread::finished, this, [this, progress] {
+        delete progress;
+        m_worker = nullptr;
+    });
+    m_worker->start();
+}
+
+void BrowserUtil::changeFinished(const QString &id, bool install, const QString &error)
+{
+    m_current.clear();
+    for (Browser &browser : m_browsers) {
+        if (browser.id == id) {
+            browser.installed = preview() ? (error.isEmpty() == install) : installedOnSystem(id);
+        }
+    }
+    // Show how it really is when it failed, and keep the other browsers when
+    // the chosen one couldn't be installed
+    if (!error.isEmpty()) {
+        for (Browser &browser : m_browsers) {
+            if (browser.id == id || (install && id == m_chosen)) {
+                browser.wanted = browser.installed;
+            }
+        }
+        if (install && id == m_chosen) {
+            m_chosen.clear();
+        }
+    }
+    if (!error.isEmpty()) {
+        setError(install ? i18nc("%1 is a browser, %2 the error", "Couldn't install %1: %2", id, error)
+                         : i18nc("%1 is a browser, %2 the error", "Couldn't remove %1: %2", id, error));
+    }
+    pickDefault();
+    Q_EMIT browsersChanged();
+    processNext();
+}
+
+// The chosen browser once it is installed, until then the one before or the
+// first installed one
+void BrowserUtil::pickDefault()
+{
+    const auto installed = [this](const QString &id) {
+        return std::any_of(m_browsers.cbegin(), m_browsers.cend(), [&id](const Browser &browser) {
+            return browser.installed && browser.id == id;
+        });
+    };
+    QString pick = m_chosen;
+    if (!installed(pick)) {
+        pick = m_default;
+    }
+    if (!installed(pick)) {
+        const auto first = std::find_if(m_browsers.cbegin(), m_browsers.cend(), [](const Browser &browser) {
+            return browser.installed;
+        });
+        pick = first == m_browsers.cend() ? QString() : first->id;
+    }
+    if (pick == m_default) {
+        return;
+    }
+    m_default = pick;
+    save();
+}
+
+void BrowserUtil::save() const
+{
+    auto config = KSharedConfig::openConfig(u"plasma-setuprc"_s);
+    config->group(u"Browser"_s).writeEntry("Default", m_default);
+    config->sync();
+}
+
+#include "moc_browserutil.cpp"
