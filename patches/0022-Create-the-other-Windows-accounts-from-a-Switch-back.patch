+QString PlasmaSetupAuthHelper::createSwitchUser(const QJsonObject &data, QString *error)
+{
+    const QString base = switchUserName(data);
+    QString username;
+    for (int i = 1; i < 100 && username.isEmpty(); ++i) {
+        const QString candidate = i == 1 ? base : base + QString::number(i);
+        const QByteArray encoded = QFile::encodeName(candidate);
+        if (getpwnam(encoded.constData()) || getgrnam(encoded.constData())) {
+            continue;
+        }
+        if (PlasmaSetupValidation::Account::validateUsername(candidate) == PlasmaSetupValidation::Account::UsernameValidationResult::Valid) {
+            username = candidate;
+        }
     }
+    if (username.isEmpty()) {
+        *error = QStringLiteral("No free user name for ") + base;
+        return {};
+    }
+    QStringList arguments = {QStringLiteral("-m"), QStringLiteral("-U")};
+    const QString fullName = switchFullName(data);
+    if (!fullName.isEmpty()) {
+        arguments << QStringLiteral("-c") << fullName;
+    }
+    arguments << username;
+    if (!switchRun(QStringLiteral("useradd"), arguments, error)) {
+        return {};
+    }
+    if (!switchRun(QStringLiteral("passwd"), {QStringLiteral("-d"), username}, error)) {
+        return {};
+    }
+    return username;
+}
 
