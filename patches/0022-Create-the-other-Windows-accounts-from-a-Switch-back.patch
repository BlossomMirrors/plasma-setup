new file mode 100644
index 0000000..49fdd38
--- /dev/null
+++ b/src/auth/switchpassword.py
@@ -0,0 +1,94 @@
+import os
+import pty
+import subprocess
+import sys
+
+AUTOSTART = os.path.expanduser("~/.config/autostart/blossomos-switch-password.desktop")
+
+GERMAN = os.environ.get("LANG", "").startswith("de")
+TEXT = {
+    "title": "Passwort wählen" if GERMAN else "Choose a password",
+    "ask": (
+        "Willkommen bei BlossomOS. Dein Konto wurde von Windows übernommen und hat noch kein Passwort. Wähle jetzt eins."
+        if GERMAN
+        else "Welcome to BlossomOS. Your account was moved over from Windows and has no password yet. Choose one now."
+    ),
+    "failed": "Das Passwort wurde nicht übernommen." if GERMAN else "The password was not accepted.",
+    "later": (
+        "Du wirst bei der nächsten Anmeldung wieder gefragt. Bis dahin hat dein Konto kein Passwort."
+        if GERMAN
+        else "You will be asked again the next time you sign in. Until then your account has no password."
+    ),
+}
+
+
+def finish():
+    try:
+        os.remove(AUTOSTART)
+    except FileNotFoundError:
+        pass
+
+
+def ask():
+    result = subprocess.run(
+        ["kdialog", "--title", TEXT["title"], "--newpassword", TEXT["ask"]],
+        capture_output=True,
+        text=True,
+    )
+    if result.returncode != 0:
+        return None
+    password = result.stdout.rstrip("\n")
+    return password or None
+
+
+def change(password):
+    pid, fd = pty.fork()
+    if pid == 0:
+        os.environ["LC_ALL"] = "C"
+        os.execvp("passwd", ["passwd"])
+    output = b""
+    answered = 0
+    has_password = False
+    while True:
+        try:
+            chunk = os.read(fd, 1024)
+        except OSError:
+            break
+        if not chunk:
+            break
+        output += chunk
+        prompt = output.rsplit(b"\n", 1)[-1].lower()
+        if prompt.rstrip().endswith(b"password:"):
+            if b"current" in prompt:
+                has_password = True
+                os.kill(pid, 15)
+                break
+            if answered >= 6:
+                os.kill(pid, 15)
+                break
+            os.write(fd, password.encode() + b"\n")
+            answered += 1
+            output += b"\n"
+    _, status = os.waitpid(pid, 0)
+    os.close(fd)
+    if has_password:
+        return True, ""
+    message = [line.strip() for line in output.decode(errors="replace").splitlines() if line.strip().upper().startswith(("BAD PASSWORD", "PASSWD:"))]
+    return os.waitstatus_to_exitcode(status) == 0, "\n".join(message)
+
+
+def main():
+    while True:
+        password = ask()
+        if password is None:
+            subprocess.run(["kdialog", "--title", TEXT["title"], "--sorry", TEXT["later"]])
+            return 0
+        ok, message = change(password)
+        if ok:
+            finish()
+            return 0
+        subprocess.run(["kdialog", "--title", TEXT["title"], "--sorry", f"{TEXT['failed']}\n\n{message}".strip()])
+
+
+if __name__ == "__main__":
+    sys.exit(main())
