     return m_state == Done ? m_manifest.value("pwas"_L1).toArray().size() : 0;
 }
 
+QStringList SwitchUtil::otherUsers() const
+{
+    QStringList names;
+    if (m_state != Done) {
+        return names;
+    }
+    for (const QJsonValue &value : m_manifest.value("users"_L1).toArray()) {
+        const QJsonObject user = value.toObject();
+        QString name = user.value("profile"_L1).toObject().value("name"_L1).toString().simplified();
+        if (name.isEmpty()) {
+            name = user.value("user"_L1).toString().simplified();
+        }
+        if (!name.isEmpty()) {
+            names << name.left(64);
+        }
+    }
+    return names;
+}
+
 QString SwitchUtil::profileName() const
 {
     return m_state == Done ? m_manifest.value("profile"_L1).toObject().value("name"_L1).toString().simplified().left(128) : QString();
