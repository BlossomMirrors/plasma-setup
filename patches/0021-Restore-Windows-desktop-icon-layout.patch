diff --git a/src/auth/switchdesktop.js b/src/auth/switchdesktop.js
new file mode 100644
index 0000000..57b96b4
--- /dev/null
+++ b/src/auth/switchdesktop.js
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Evaluated by plasmashell after the restored desktop links (including PWAs) exist.
+function switchDesktopPositions(layout, geometry) {
+    function integer(value, low, high) {
+        return typeof value === "number" && isFinite(value) && Math.floor(value) === value && value >= low && value <= high;
+    }
+    var sx = integer(layout.spacingX, 1, 4096) ? layout.spacingX : 100;
+    var sy = integer(layout.spacingY, 1, 4096) ? layout.spacingY : 100;
+    var rows = Math.max(1, Math.floor(geometry.height / sy));
+    var columns = Math.max(1, Math.floor(geometry.width / sx));
+    var items = (Array.isArray(layout.items) ? layout.items : []).filter(function (item) {
+        return item && typeof item.path === "string" && item.path.length > 0 && item.path !== "." && item.path !== ".."
+            && !/[\/\\\x00-\x1f]/.test(item.path)
+            && integer(item.x, -1000000, 1000000) && integer(item.y, -1000000, 1000000);
+    });
+    // Rehome icons from displays left of/above the main display; keep existing gaps.
+    var originX = 0, originY = 0;
+    items.forEach(function (item) { originX = Math.min(originX, item.x); originY = Math.min(originY, item.y); });
+    items.sort(function (a, b) { return a.x - b.x || a.y - b.y; });
+    var used = {}, names = {}, positions = [];
+    items.forEach(function (item) {
+        // FolderModel uses desktop:/ URLs, with QUrl's pretty-decoded file names.
+        var url = "desktop:/" + item.path.replace(/%/g, "%25").replace(/#/g, "%23").replace(/\?/g, "%3F");
+        if (names[url]) return;
+        names[url] = true;
+        var column = Math.max(0, Math.round((item.x - originX) / sx));
+        var row = Math.max(0, Math.round((item.y - originY) / sy));
+        var index = Math.min(columns - 1, column) * rows + Math.min(rows - 1, row);
+        while (used[index]) index++;
+        used[index] = true;
+        positions.push(url, String(Math.floor(index / rows)), String(index % rows));
+        columns = Math.max(columns, Math.floor(index / rows) + 1);
+    });
+    return [String(columns), String(rows)].concat(positions);
+}
+
+function switchApplyDesktopLayout(layout) {
+    if (!layout || layout.flow !== "columns" || typeof layout.autoArrange !== "boolean") return;
+    var applied = false;
+    desktops().forEach(function (desktop) {
+        // Apply positions once, rather than duplicating every icon across monitors/activities.
+        if (desktop.type !== "org.kde.plasma.folder" || desktop.screen < 0) return;
+        desktop.currentConfigGroup = ["General"];
+        if (desktop.readConfig("url", "desktop:/") !== "desktop:/") return;
+        desktop.writeConfig("arrangement", 1); // top to bottom, then the next column
+        desktop.writeConfig("alignment", 0);
+        desktop.writeConfig("locked", false); // auto-arrange does not mean immovable icons
+        if (layout.autoArrange) {
+            desktop.writeConfig("sortMode", 0); // FolderModel: name = 0, manual = -1
+            return;
+        }
+        if (applied) return;
+        var geometry = screenGeometry(desktop.screen);
+        if (geometry.width <= 0 || geometry.height <= 0) return;
+        var resolution = Math.floor(geometry.width) + "x" + Math.floor(geometry.height);
+        var positions = {};
+        positions[resolution] = switchDesktopPositions(layout, geometry);
+        // Disable the positioner while replacing its state, then reload it in manual mode.
+        desktop.writeConfig("sortMode", 0);
+        desktop.reloadConfig();
+        desktop.writeConfig("positions", JSON.stringify(positions));
+        desktop.writeConfig("lastResolution", resolution);
+        desktop.writeConfig("changedPositions", "{}");
+        desktop.writeConfig("sortMode", -1);
+        desktop.reloadConfig();
+        applied = true;
+    });
+    // Plasma always snaps Folder View icons to cells. alignToGrid=false cannot disable
+    // that; manual mode keeps the nearest available cell and allows subsequent dragging.
+}
diff --git a/tests/test_switchdesktop.js b/tests/test_switchdesktop.js
new file mode 100644
index 0000000..db131da
--- /dev/null
+++ b/tests/test_switchdesktop.js
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const vm = require('node:vm');
+const path = require('node:path');
+const source = fs.readFileSync(path.join(__dirname, '../src/auth/switchdesktop.js'), 'utf8');
+function desktop(type = 'org.kde.plasma.folder', url = 'desktop:/', screen = 0) {
+    return {type, screen, config: {url}, reloads: 0,
+        readConfig(key, fallback) { return this.config[key] ?? fallback; },
+        writeConfig(key, value) { this.config[key] = value; },
+        reloadConfig() { this.reloads++; }};
+}
+function apply(layout, views = [desktop()]) {
+    const context = vm.createContext({desktops: () => views, screenGeometry: () => ({width: 1000, height: 600})});
+    vm.runInContext(source, context);
+    context.switchApplyDesktopLayout(layout);
+    return views;
+}
+const layout = {flow: 'columns', autoArrange: false, alignToGrid: false, spacingX: 100, spacingY: 100,
+    items: [{path: 'Firefox.desktop', x: 0, y: 0}, {path: 'Taxes.desktop', x: 0, y: 200},
+        {path: 'notes.txt', x: 100, y: 0}]};
+const [manual] = apply(layout);
+assert.equal(manual.config.arrangement, 1);
+assert.equal(manual.config.locked, false);
+assert.equal(manual.config.sortMode, -1);
+const positions = JSON.parse(manual.config.positions)['1000x600'];
+assert.deepEqual(positions.slice(2), ['desktop:/Firefox.desktop', '0', '0', 'desktop:/Taxes.desktop', '0', '2', 'desktop:/notes.txt', '1', '0']);
+assert.equal(manual.reloads, 2);
+const [automatic] = apply({...layout, autoArrange: true});
+assert.equal(automatic.config.sortMode, 0);
+assert.equal(automatic.config.positions, undefined);
+const [old] = apply(undefined);
+assert.deepEqual(old.config, {url: 'desktop:/'});
+const views = apply(layout, [desktop('org.kde.desktopcontainment'), desktop(undefined, 'file:///tmp'), desktop(), desktop()]);
+assert.equal(views[0].config.arrangement, undefined);
+assert.equal(views[1].config.arrangement, undefined);
+assert.equal(views[3].config.positions, undefined);
+const [collision] = apply({...layout, items: [{path: 'a', x: -100, y: -100}, {path: 'b', x: -100, y: -100},
+    {path: '../escape', x: 0, y: 0}, {path: 'bad', x: null, y: 0}, {path: 'bad2', x: Infinity, y: 0},
+    {path: 'a', x: 0, y: 0}, {path: '100% #?.txt', x: 0, y: 0}]});
+const safe = JSON.parse(collision.config.positions)['1000x600'];
+assert.equal(safe.length, 11);
+assert.equal(safe[2], 'desktop:/a');
+assert.equal(safe[5], 'desktop:/b');
+assert.notDeepEqual(safe.slice(3, 5), safe.slice(6, 8));
+assert.equal(safe[8], 'desktop:/100%25 %23%3F.txt');
+console.log('Desktop layout tests passed');
