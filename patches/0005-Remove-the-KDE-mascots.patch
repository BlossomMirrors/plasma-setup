 files/plasma-setup.desktop.in                 |   2 +-
 .../finished/contents/ui/konqi-calling.png    | Bin 76072 -> 0 bytes
 .../contents/ui/konqi-calling.png.license     |   3 --
 modules/finished/contents/ui/main.qml         |  29 +++++++++++++-----
 4 files changed, 22 insertions(+), 12 deletions(-)
 delete mode 100644 modules/finished/contents/ui/konqi-calling.png
 delete mode 100644 modules/finished/contents/ui/konqi-calling.png.license

diff --git a/files/plasma-setup.desktop.in b/files/plasma-setup.desktop.in
index f4b9085..caa906e 100644
