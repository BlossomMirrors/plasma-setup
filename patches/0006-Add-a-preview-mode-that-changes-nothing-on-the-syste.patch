diff --git a/src/pagesmodel.cpp b/src/pagesmodel.cpp
index 59e8ed3..d282941 100644
--- a/src/pagesmodel.cpp
+++ b/src/pagesmodel.cpp
@@ -8,6 +8,8 @@
 #include <KPackage/PackageLoader>
 #include <KPluginMetaData>
 
+#include <QSet>
+
 using namespace Qt::StringLiterals;
 
 PagesModel::PagesModel(QObject *parent)
@@ -22,6 +24,18 @@ void PagesModel::reload()
 
     auto packages = KPackage::PackageLoader::self()->listKPackages(QStringLiteral("KDE/PlasmaSetup"));
 
+    // A page installed in more than one data dir (the preview's stage and
+    // /usr/share) is listed once per dir; the first one in XDG_DATA_DIRS wins
+    QSet<QString> seen;
+    packages.removeIf([&seen](const KPackage::Package &package) {
+        const QString id = package.metadata().pluginId();
+        if (seen.contains(id)) {
+            return true;
+        }
+        seen.insert(id);
+        return false;
+    });
+
     std::ranges::sort(packages, [](const KPackage::Package &left, const KPackage::Package &right) {
         const auto leftData = left.metadata().rawData();
         const auto rightData = right.metadata().rawData();
