+// SPDX-FileCopyrightText: 2026 Leonie Ain <me@koyu.space>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Layouts
+
+import org.kde.kirigami as Kirigami
+import org.kde.plasmasetup
+import org.kde.plasmasetup.updatesutil as Updates
+
+import org.kde.plasmasetup.components as PlasmaSetupComponents
+
+/**
+* @brief Module that installs system updates
+*
+* Downloads and stages the latest system image as soon as it is shown, and
+* restarts into it when there was one. Setup can only go on, or back, when the
+* system is up to date, or the update failed. Skipped without internet.
+*/
+PlasmaSetupComponents.SetupModule {
+    id: root
+
+    readonly property int updateState: Updates.UpdatesUtil.state
+
+    available: Updates.UpdatesUtil.available
+    nextEnabled: updateState === Updates.UpdatesUtil.UpToDate || updateState === Updates.UpdatesUtil.Failed
+    // No leaving while rpm-ostree is at work or the system restarts
+    backEnabled: nextEnabled
+
+    function skipPage(): bool {
+        return !InitialStartUtil.online();
+    }
+
+    function onPageActivated(): void {
+        Updates.UpdatesUtil.start();
+    }
+
+    contentItem: ColumnLayout {
+        spacing: Kirigami.Units.largeSpacing
+
+        Item {
+            Layout.fillHeight: true
+        }
+
+        // Like the outcome in BlossomOS Recovery: the icon on a circle of its
+        // colour at 18%
+        Rectangle {
+            id: badge
+
+            readonly property bool done: root.updateState === Updates.UpdatesUtil.UpToDate || root.updateState === Updates.UpdatesUtil.Restarting
+            readonly property bool failed: root.updateState === Updates.UpdatesUtil.Failed
+            readonly property color tint: done ? Kirigami.Theme.positiveTextColor : failed ? Kirigami.Theme.negativeTextColor : Kirigami.Theme.textColor
+
+            Layout.alignment: Qt.AlignHCenter
+            Layout.preferredWidth: 56
+            Layout.preferredHeight: 56
+            radius: width / 2
+            color: done || failed ? Qt.alpha(tint, 0.18) : "transparent"
+
+            Kirigami.Icon {
+                anchors.centerIn: parent
+                width: 32
+                height: 32
+                source: badge.done ? "emblem-ok-symbolic" : badge.failed ? "dialog-warning-symbolic" : "system-software-update-symbolic"
+                isMask: true
+                roundToIconSize: false
+                color: badge.tint
+            }
+        }
+
+        Kirigami.Heading {
+            Layout.fillWidth: true
+            horizontalAlignment: Text.AlignHCenter
+            wrapMode: Text.Wrap
+            level: 2
+            text: {
+                switch (root.updateState) {
+                case Updates.UpdatesUtil.Restarting:
+                    return i18n("Update Installed");
+                case Updates.UpdatesUtil.UpToDate:
+                    return i18n("Up to Date");
+                case Updates.UpdatesUtil.Failed:
+                    return i18n("Couldn't Update");
+                default:
+                    return i18nc("%1 is the distro name", "Updating %1", InitialStartUtil.distroName);
+                }
+            }
+        }
+
+        Label {
+            Layout.fillWidth: true
+            Layout.leftMargin: Kirigami.Units.gridUnit
+            Layout.rightMargin: Kirigami.Units.gridUnit
+            horizontalAlignment: Text.AlignHCenter
+            wrapMode: Text.Wrap
+            text: {
+                switch (root.updateState) {
+                case Updates.UpdatesUtil.Restarting:
+                    return i18n("Restarting to finish the update. Setup starts again afterwards.");
+                case Updates.UpdatesUtil.UpToDate:
+                    return i18nc("%1 is the distro name", "%1 is up to date.", InitialStartUtil.distroName);
+                case Updates.UpdatesUtil.Failed:
+                    return i18n("You can go on with the setup. Updates will be installed automatically later.");
+                default:
+                    return i18n("The latest updates are being downloaded and installed. Your computer restarts when they are done.");
+                }
+            }
+        }
+
+        ProgressBar {
+            Layout.fillWidth: true
+            Layout.maximumWidth: Kirigami.Units.gridUnit * 20
+            Layout.alignment: Qt.AlignHCenter
+            Layout.topMargin: Kirigami.Units.largeSpacing
+            visible: root.updateState === Updates.UpdatesUtil.Updating || root.updateState === Updates.UpdatesUtil.Idle
+            from: 0
+            to: 100
+            value: Math.max(0, Updates.UpdatesUtil.percent)
+            indeterminate: Updates.UpdatesUtil.percent < 0
+        }
+
+        BusyIndicator {
+            Layout.alignment: Qt.AlignHCenter
+            visible: root.updateState === Updates.UpdatesUtil.Restarting
+            running: visible
+        }
+
+        Label {
+            Layout.fillWidth: true
+            horizontalAlignment: Text.AlignHCenter
+            visible: text !== "" && root.updateState === Updates.UpdatesUtil.Updating
+            text: Updates.UpdatesUtil.downloadSize !== "" && Updates.UpdatesUtil.downloaded !== ""
+                ? i18nc("downloaded of total size", "%1 of %2", Updates.UpdatesUtil.downloaded, Updates.UpdatesUtil.downloadSize)
+                : ""
+        }
+
+        // What rpm-ostree is doing, or why it failed
+        Label {
+            Layout.fillWidth: true
+            Layout.leftMargin: Kirigami.Units.gridUnit
+            Layout.rightMargin: Kirigami.Units.gridUnit
+            horizontalAlignment: Text.AlignHCenter
+            visible: root.updateState === Updates.UpdatesUtil.Updating || root.updateState === Updates.UpdatesUtil.Failed
+            text: Updates.UpdatesUtil.message
+            elide: Text.ElideMiddle
+            maximumLineCount: root.updateState === Updates.UpdatesUtil.Failed ? 3 : 1
+            wrapMode: root.updateState === Updates.UpdatesUtil.Failed ? Text.Wrap : Text.NoWrap
+            font: Kirigami.Theme.smallFont
+            opacity: 0.7
+        }
+
+        Item {
+            Layout.fillHeight: true
+        }
+    }
+}
