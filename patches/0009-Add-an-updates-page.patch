+// SPDX-FileCopyrightText: 2026 Leonie Ain <me@koyu.space>
+// SPDX-License-Identifier: AGPL-3.0-or-later
+// The rpm-ostree transaction handling is ported from BlossomOS' Software Update KCM
+
+#pragma once
+
+#include <QDBusAbstractInterface>
+#include <QDBusConnection>
+#include <QDBusPendingReply>
+#include <QObject>
+#include <qqmlintegration.h>
+
+class QTimer;
+
+// Proxy for the rpm-ostree transaction peer connection
+class RpmOstreeTransaction : public QDBusAbstractInterface
+{
+    Q_OBJECT
+public:
+    explicit RpmOstreeTransaction(const QDBusConnection &connection, QObject *parent = nullptr)
+        : QDBusAbstractInterface(QString(), QStringLiteral("/"), "org.projectatomic.rpmostree1.Transaction", connection, parent)
+    {
+    }
+
+    inline QDBusPendingReply<> start()
+    {
+        return asyncCall(QStringLiteral("Start"));
+    }
+
+Q_SIGNALS:
+    void Message(const QString &message);
+    void TaskBegin(const QString &text);
+    void TaskEnd(const QString &text);
+    void PercentProgress(const QString &text, quint32 percent);
+    void Finished(bool success, const QString &errorMessage);
+};
+
+/*!
+ * Downloads and stages the latest system image with rpm-ostree, and restarts
+ * into it when there was one.
+ */
+class UpdatesUtil : public QObject
+{
+    Q_OBJECT
+    QML_ELEMENT
+    QML_SINGLETON
+
+    Q_PROPERTY(bool available READ available CONSTANT)
+    Q_PROPERTY(State state READ state NOTIFY stateChanged)
+    /*!
+     * Download progress in percent, or -1 when it can't be told.
+     */
+    Q_PROPERTY(int percent READ percent NOTIFY progressChanged)
+    Q_PROPERTY(QString downloaded READ downloaded NOTIFY progressChanged)
+    Q_PROPERTY(QString downloadSize READ downloadSize NOTIFY progressChanged)
+    /*!
+     * What rpm-ostree is doing, or why it failed.
+     */
+    Q_PROPERTY(QString message READ message NOTIFY messageChanged)
+
+public:
+    enum State {
+        Idle,
+        Updating,
+        Restarting,
+        UpToDate,
+        Failed,
+    };
+    Q_ENUM(State)
+
+    explicit UpdatesUtil(QObject *parent = nullptr);
+    ~UpdatesUtil() override;
+
+    /*!
+     * Only on image based (ostree) systems, and in previews.
+     */
+    bool available() const;
+    State state() const;
+    int percent() const;
+    QString downloaded() const;
+    QString downloadSize() const;
+    QString message() const;
+
+    /*!
+     * Starts the update, once.
+     */
+    Q_INVOKABLE void start();
+
+Q_SIGNALS:
+    void stateChanged();
+    void progressChanged();
+    void messageChanged();
+
+private:
+    void setState(State state);
+    void setMessage(const QString &message);
+    void fail(const QString &message);
+
+    void beginTransaction(const QString &address);
+    void cleanupTransaction();
+    void onMessage(const QString &message);
+    void onTaskBegin(const QString &text);
+    void onTaskEnd(const QString &text);
+    void onPercentProgress(const QString &text, quint32 percent);
+    void onFinished(bool success, const QString &errorMessage);
+    void updateDownloadProgress();
+    void finishDownloadPhase();
+    void checkStagedDeployment();
+    void reboot();
+    void startPreview();
+
+    State m_state = Idle;
+    int m_percent = -1;
+    quint64 m_totalBytes = 0;
+    quint64 m_completedBytes = 0;
+    quint64 m_currentBytes = 0;
+    quint64 m_taskBytes = 0;
+    quint64 m_taskBaseline = 0;
+    bool m_taskActive = false;
+    QString m_message;
+
+    QTimer *m_progressTimer = nullptr;
+    RpmOstreeTransaction *m_transaction = nullptr;
+    QString m_connectionName;
+};
