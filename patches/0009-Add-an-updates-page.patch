diff --git a/modules/updatesutil/updatesutil.cpp b/modules/updatesutil/updatesutil.cpp
new file mode 100644
index 0000000..50ca046
--- /dev/null
+++ b/modules/updatesutil/updatesutil.cpp
@@ -0,0 +1,430 @@
+// SPDX-FileCopyrightText: 2026 Leonie Ain <me@koyu.space>
+// SPDX-License-Identifier: AGPL-3.0-or-later
+// The rpm-ostree transaction handling is ported from BlossomOS' Software Update KCM
+
+#include "updatesutil.h"
+
+#include <KLocalizedString>
+
+#include <QDBusArgument>
+#include <QDBusInterface>
+#include <QDBusMessage>
+#include <QDBusPendingCallWatcher>
+#include <QDBusVariant>
+#include <QFile>
+#include <QLocale>
+#include <QRegularExpression>
+#include <QTextStream>
+#include <QTimer>
+
+using namespace Qt::StringLiterals;
+
+namespace
+{
+constexpr auto RPMOSTREE_SERVICE = "org.projectatomic.rpmostree1";
+constexpr auto RPMOSTREE_SYSROOT_PATH = "/org/projectatomic/rpmostree1/Sysroot";
+constexpr auto RPMOSTREE_SYSROOT_IFACE = "org.projectatomic.rpmostree1.Sysroot";
+constexpr auto RPMOSTREE_OS_PATH = "/org/projectatomic/rpmostree1/default";
+constexpr auto RPMOSTREE_OS_IFACE = "org.projectatomic.rpmostree1.OS";
+constexpr auto TRANSACTION_CONNECTION = "plasma-setup-rpmostree-transaction";
+
+// How long "Restarting…" shows before the restart
+constexpr int RESTART_DELAY_MS = 3000;
+
+bool preview()
+{
+    return qEnvironmentVariableIntValue("PLASMA_SETUP_PREVIEW") == 1;
+}
+
+// The last parenthesized size in a daemon message, like "(1.2 GB)"
+quint64 parseSizeSuffix(const QString &text)
+{
+    static const QRegularExpression re(u"\\(([0-9]+(?:[.,][0-9]+)?)[\\s\\x{00a0}]*(B|kB|KB|KiB|MB|MiB|GB|GiB|TB|TiB)\\)"_s);
+    QRegularExpressionMatch last;
+    auto it = re.globalMatch(text);
+    while (it.hasNext()) {
+        last = it.next();
+    }
+    if (!last.hasMatch()) {
+        return 0;
+    }
+    QString number = last.captured(1);
+    number.replace(u',', u'.');
+    static const QHash<QString, double> units{
+        {u"B"_s, 1},
+        {u"kB"_s, 1e3},
+        {u"KB"_s, 1e3},
+        {u"KiB"_s, 1024.0},
+        {u"MB"_s, 1e6},
+        {u"MiB"_s, 1024.0 * 1024},
+        {u"GB"_s, 1e9},
+        {u"GiB"_s, 1024.0 * 1024 * 1024},
+        {u"TB"_s, 1e12},
+        {u"TiB"_s, 1024.0 * 1024 * 1024 * 1024},
+    };
+    return static_cast<quint64>(number.toDouble() * units.value(last.captured(2), 1));
+}
+
+// Bytes received over all network interfaces but loopback
+quint64 totalRxBytes()
+{
+    QFile file(u"/proc/net/dev"_s);
+    if (!file.open(QIODevice::ReadOnly | QIODevice::Text)) {
+        return 0;
+    }
+    QTextStream in(&file);
+    in.readLine();
+    in.readLine();
+    quint64 total = 0;
+    while (!in.atEnd()) {
+        const QString line = in.readLine().trimmed();
+        const qsizetype colon = line.indexOf(u':');
+        if (colon <= 0 || line.left(colon).trimmed() == "lo"_L1) {
+            continue;
+        }
+        const QStringList fields = line.mid(colon + 1).split(u' ', Qt::SkipEmptyParts);
+        if (!fields.isEmpty()) {
+            total += fields.at(0).toULongLong();
+        }
+    }
+    return total;
+}
+
+// The setup user's polkit rule allows these without asking
+QDBusPendingCall systemCall(const char *service, const char *path, const char *interface, const QString &method, const QVariantList &arguments = {})
+{
+    QDBusMessage message = QDBusMessage::createMethodCall(QLatin1String(service), QLatin1String(path), QLatin1String(interface), method);
+    message.setArguments(arguments);
+    return QDBusConnection::systemBus().asyncCall(message);
+}
+}
+
+UpdatesUtil::UpdatesUtil(QObject *parent)
+    : QObject{parent}
+    , m_progressTimer{new QTimer(this)}
+{
+    // rpm-ostree reports no byte progress while pulling container layers. It
+    // announces the size of each layer though, so finished layers count
+    // exactly and the running one is estimated from the bytes received
+    m_progressTimer->setInterval(1000);
+    connect(m_progressTimer, &QTimer::timeout, this, &UpdatesUtil::updateDownloadProgress);
+}
+
+UpdatesUtil::~UpdatesUtil()
+{
+    cleanupTransaction();
+}
+
+bool UpdatesUtil::available() const
+{
+    return preview() || QFile::exists(u"/run/ostree-booted"_s);
+}
+
+UpdatesUtil::State UpdatesUtil::state() const
+{
+    return m_state;
+}
+
+int UpdatesUtil::percent() const
+{
+    return m_percent;
+}
+
+QString UpdatesUtil::downloaded() const
+{
+    return m_currentBytes > 0 ? QLocale().formattedDataSize(static_cast<qint64>(m_currentBytes)) : QString();
+}
+
+QString UpdatesUtil::downloadSize() const
+{
+    return m_totalBytes > 0 ? QLocale().formattedDataSize(static_cast<qint64>(m_totalBytes)) : QString();
+}
+
+QString UpdatesUtil::message() const
+{
+    return m_message;
+}
+
+void UpdatesUtil::start()
+{
+    if (m_state != Idle) {
+        return;
+    }
+    setState(Updating);
+
+    if (preview()) {
+        startPreview();
+        return;
+    }
+
+    auto *watcher =
+        new QDBusPendingCallWatcher(systemCall(RPMOSTREE_SERVICE, RPMOSTREE_OS_PATH, RPMOSTREE_OS_IFACE, u"Upgrade"_s, {QVariant::fromValue(QVariantMap{})}),
+                                    this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher *watcher) {
+        watcher->deleteLater();
+        QDBusPendingReply<QString> reply = *watcher;
+        if (reply.isError()) {
+            fail(reply.error().message());
+            return;
+        }
+        beginTransaction(reply.value());
+    });
+}
+
+void UpdatesUtil::setState(State state)
+{
+    if (m_state == state) {
+        return;
+    }
+    m_state = state;
+    Q_EMIT stateChanged();
+}
+
+void UpdatesUtil::setMessage(const QString &message)
+{
+    if (m_message == message) {
+        return;
+    }
+    m_message = message;
+    Q_EMIT messageChanged();
+}
+
+void UpdatesUtil::fail(const QString &message)
+{
+    cleanupTransaction();
+    setMessage(message.isEmpty() ? i18n("Unknown error") : message);
+    setState(Failed);
+}
+
+void UpdatesUtil::beginTransaction(const QString &address)
+{
+    QDBusConnection connection = QDBusConnection::connectToPeer(address, QLatin1String(TRANSACTION_CONNECTION));
+    if (!connection.isConnected()) {
+        fail(i18n("Failed to connect to rpm-ostree transaction"));
+        return;
+    }
+    m_connectionName = QLatin1String(TRANSACTION_CONNECTION);
+
+    m_transaction = new RpmOstreeTransaction(connection, this);
+    connect(m_transaction, &RpmOstreeTransaction::Message, this, &UpdatesUtil::onMessage);
+    connect(m_transaction, &RpmOstreeTransaction::TaskBegin, this, &UpdatesUtil::onTaskBegin);
+    connect(m_transaction, &RpmOstreeTransaction::TaskEnd, this, &UpdatesUtil::onTaskEnd);
+    connect(m_transaction, &RpmOstreeTransaction::PercentProgress, this, &UpdatesUtil::onPercentProgress);
+    connect(m_transaction, &RpmOstreeTransaction::Finished, this, &UpdatesUtil::onFinished);
+    m_transaction->start();
+    m_progressTimer->start();
+}
+
+void UpdatesUtil::cleanupTransaction()
+{
+    m_progressTimer->stop();
+    delete m_transaction;
+    m_transaction = nullptr;
+    if (!m_connectionName.isEmpty()) {
+        QDBusConnection::disconnectFromPeer(m_connectionName);
+        m_connectionName.clear();
+    }
+}
+
+void UpdatesUtil::onMessage(const QString &message)
+{
+    setMessage(message);
+
+    // The daemon announces the remaining download when the pull starts
+    if (message.contains("needed:"_L1)) {
+        const quint64 bytes = parseSizeSuffix(message);
+        if (bytes > 0) {
+            m_totalBytes += bytes;
+            Q_EMIT progressChanged();
+        }
+    }
+}
+
+void UpdatesUtil::onTaskBegin(const QString &text)
+{
+    setMessage(text);
+
+    const quint64 bytes = parseSizeSuffix(text);
+    if (bytes > 0) {
+        m_taskBytes = bytes;
+        m_taskBaseline = totalRxBytes();
+        m_taskActive = true;
+    } else if (m_completedBytes > 0) {
+        // A task without a size after the layers means staging has begun
+        finishDownloadPhase();
+    }
+}
+
+void UpdatesUtil::onTaskEnd(const QString &text)
+{
+    Q_UNUSED(text)
+    if (m_taskActive) {
+        m_taskActive = false;
+        m_completedBytes += m_taskBytes;
+        updateDownloadProgress();
+    }
+    // The announced sizes are rounded, so within two percent counts as done
+    if (m_totalBytes > 0 && m_completedBytes + m_totalBytes / 50 >= m_totalBytes) {
+        finishDownloadPhase();
+    }
+}
+
+void UpdatesUtil::onPercentProgress(const QString &text, quint32 percent)
+{
+    if (!text.isEmpty()) {
+        setMessage(text);
+    }
+    // The download estimate beats the jumpy per phase percentages
+    if (m_progressTimer->isActive() && m_totalBytes > 0) {
+        return;
+    }
+    m_percent = static_cast<int>(percent);
+    Q_EMIT progressChanged();
+}
+
+void UpdatesUtil::updateDownloadProgress()
+{
+    if (m_totalBytes == 0) {
+        return;
+    }
+    quint64 current = m_completedBytes;
+    if (m_taskActive) {
+        const quint64 received = totalRxBytes();
+        current += qMin(received > m_taskBaseline ? received - m_taskBaseline : 0, m_taskBytes);
+    }
+    current = qMin(current, m_totalBytes);
+    const int percent = static_cast<int>(qMin<quint64>(99, current * 100 / m_totalBytes));
+    if (current != m_currentBytes || percent > m_percent) {
+        m_currentBytes = current;
+        m_percent = qMax(m_percent, percent);
+        Q_EMIT progressChanged();
+    }
+}
+
+// Writing the new image can't be measured, so the bar goes indeterminate
+void UpdatesUtil::finishDownloadPhase()
+{
+    if (!m_progressTimer->isActive()) {
+        return;
+    }
+    m_progressTimer->stop();
+    m_percent = -1;
+    m_currentBytes = 0;
+    m_totalBytes = 0;
+    Q_EMIT progressChanged();
+}
+
+void UpdatesUtil::onFinished(bool success, const QString &errorMessage)
+{
+    cleanupTransaction();
+    if (!success) {
+        fail(errorMessage);
+        return;
+    }
+    checkStagedDeployment();
+}
+
+// An update was installed when the next boot's deployment has another image
+// than the booted one
+void UpdatesUtil::checkStagedDeployment()
+{
+    QDBusMessage message =
+        QDBusMessage::createMethodCall(QLatin1String(RPMOSTREE_SERVICE), QLatin1String(RPMOSTREE_SYSROOT_PATH), u"org.freedesktop.DBus.Properties"_s, u"Get"_s);
+    message.setArguments({QLatin1String(RPMOSTREE_SYSROOT_IFACE), u"Deployments"_s});
+    auto *watcher = new QDBusPendingCallWatcher(QDBusConnection::systemBus().asyncCall(message), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher *watcher) {
+        watcher->deleteLater();
+        QDBusPendingReply<QDBusVariant> reply = *watcher;
+        if (reply.isError()) {
+            fail(reply.error().message());
+            return;
+        }
+
+        QList<QVariantMap> deployments;
+        const QDBusArgument array = qvariant_cast<QDBusArgument>(reply.value().variant());
+        array.beginArray();
+        while (!array.atEnd()) {
+            QVariantMap deployment;
+            array >> deployment;
+            deployments << deployment;
+        }
+        array.endArray();
+
+        // The image digest, and the commit for non-container deployments
+        auto imageOf = [](const QVariantMap &deployment) {
+            QVariantMap meta;
+            const QVariant metaVariant = deployment.value(u"base-commit-meta"_s);
+            if (metaVariant.canConvert<QDBusArgument>()) {
+                qvariant_cast<QDBusArgument>(metaVariant) >> meta;
+            }
+            const QString digest = meta.value(u"ostree.manifest-digest"_s).toString();
+            return digest.isEmpty() ? deployment.value(u"checksum"_s).toString() : digest;
+        };
+
+        // Deployments are in boot order: one before the booted one, or a
+        // staged one, is what the next boot uses
+        QString booted;
+        QString next;
+        bool beforeBooted = true;
+        for (const QVariantMap &deployment : std::as_const(deployments)) {
+            if (deployment.value(u"booted"_s).toBool()) {
+                booted = imageOf(deployment);
+                beforeBooted = false;
+            } else if (next.isEmpty() && (beforeBooted || deployment.value(u"staged"_s).toBool())) {
+                next = imageOf(deployment);
+            }
+        }
+
+        if (!next.isEmpty() && next != booted) {
+            reboot();
+        } else {
+            setState(UpToDate);
+        }
+    });
+}
+
+void UpdatesUtil::reboot()
+{
+    setState(Restarting);
+    QTimer::singleShot(RESTART_DELAY_MS, this, [this] {
+        if (preview()) {
+            return;
+        }
+        auto *watcher =
+            new QDBusPendingCallWatcher(systemCall("org.freedesktop.login1", "/org/freedesktop/login1", "org.freedesktop.login1.Manager", u"Reboot"_s, {false}),
+                                        this);
+        connect(watcher, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher *watcher) {
+            watcher->deleteLater();
+            if (!watcher->isError()) {
+                return;
+            }
+            // A lost connection just means the restart is under way
+            const QDBusError::ErrorType type = watcher->error().type();
+            if (type != QDBusError::Disconnected && type != QDBusError::NoReply && type != QDBusError::TimedOut) {
+                fail(watcher->error().message());
+            }
+        });
+    });
+}
+
+// Pretends to download an update so the page can be looked at, and stops at
+// "Restarting…"
+void UpdatesUtil::startPreview()
+{
+    m_totalBytes = 1536ull * 1024 * 1024;
+    setMessage(u"Pulling manifest: ostree-image-signed:docker://registry.blossomos.org/blossomos/blossomos:latest"_s);
+    auto *timer = new QTimer(this);
+    timer->setInterval(100);
+    connect(timer, &QTimer::timeout, this, [this, timer] {
+        m_currentBytes = qMin(m_totalBytes, m_currentBytes + m_totalBytes / 60);
+        m_percent = static_cast<int>(m_currentBytes * 100 / m_totalBytes);
+        Q_EMIT progressChanged();
+        if (m_currentBytes == m_totalBytes) {
+            timer->deleteLater();
+            reboot();
+        }
+    });
+    timer->start();
+}
+
