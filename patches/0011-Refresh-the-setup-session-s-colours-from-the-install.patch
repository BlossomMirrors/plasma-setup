 using namespace Qt::StringLiterals;
 
+namespace
+{
+// The setup session's kdeglobals is copied from /etc/skel, whose colours can
+// lag behind the installed BlossomUI scheme. Copy the scheme's colours in
+// again, as applying it in System Settings would, so the wizard, and the
+// new user it hands kdeglobals to, get the current ones.
+// Returns whether anything changed.
+bool refreshColorScheme()
+{
+    auto globals = KSharedConfig::openConfig(u"kdeglobals"_s, KConfig::SimpleConfig);
+    // Either the scheme's file name or its display name ("BlossomUI Light")
+    const QString scheme = globals->group(u"General"_s).readEntry("ColorScheme", QString()).remove(u' ');
+    if (scheme.isEmpty()) {
+        return false;
+    }
+    const QString path = QStandardPaths::locate(QStandardPaths::GenericDataLocation, u"color-schemes/%1.colors"_s.arg(scheme));
+    if (path.isEmpty()) {
+        return false;
+    }
+
+    KConfig colors(path, KConfig::SimpleConfig);
+    bool changed = false;
+    for (const QString &name : colors.groupList()) {
+        if (!name.startsWith(u"Colors:"_s) && name != u"WM"_s) {
+            continue;
+        }
+        const auto entries = colors.group(name).entryMap();
+        KConfigGroup group = globals->group(name);
+        if (group.entryMap() == entries) {
+            continue;
+        }
+        group.deleteGroup();
+        for (auto it = entries.cbegin(); it != entries.cend(); ++it) {
+            group.writeEntry(it.key(), it.value());
+        }
+        changed = true;
+    }
+    if (changed) {
+        globals->sync();
+    }
+    return changed;
+}
+}
+
 int main(int argc, char *argv[])
 {
+    const bool colorsChanged = refreshColorScheme();
+
     QApplication app(argc, argv);
 
+    if (colorsChanged) {
+        // Let the shell and KWin, already running, pick up the new colours
+        auto message = QDBusMessage::createSignal(u"/KGlobalSettings"_s, u"org.kde.KGlobalSettings"_s, u"notifyChange"_s);
+        message.setArguments({0 /* PaletteChanged */, 0});
+        QDBusConnection::sessionBus().send(message);
+    }
+
     KLocalizedString::setApplicationDomain("org.kde.plasmasetup");
 
     if (qEnvironmentVariableIsEmpty("QT_QUICK_CONTROLS_STYLE")) {
